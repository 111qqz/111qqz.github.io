 class="absolute top-0 w-6 transition-opacity opacity-0 -start-6 not-prose group-hover:opacity-100 select-none"&gt;
 &lt;a class="text-primary-300 dark:text-neutral-700 !no-underline" href="#%e4%bb%8e%e4%b8%80%e4%b8%aa%e8%ae%a9%e6%88%91%e6%84%a3%e4%bd%8f%e7%9a%84%e9%97%ae%e9%a2%98%e8%af%b4%e8%b5%b7" aria-label="Anchor"&gt;#&lt;/a&gt;
