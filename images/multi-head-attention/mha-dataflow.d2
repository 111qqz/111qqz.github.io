direction: down

H: "输入序列表征 H: [n, 512]" {
  style.bold: true
  style.stroke-width: 2
}

heads: "多头独立注意力计算 (8 个 Head 并行)" {
  grid-columns: 3

  head1: "Head 1 (子空间 1)\n• 投影: Q₁ K₁ V₁ [n, 64]\n• 注意力: A₁ = softmax(...)\n• 读出: O₁ = A₁V₁ [n, 64]" {
    style.stroke: "#2563eb"
    style.bold: true
  }

  head2: "Head 2 (子空间 2)\n• 投影: Q₂ K₂ V₂ [n, 64]\n• 注意力: A₂ = softmax(...)\n• 读出: O₂ = A₂V₂ [n, 64]" {
    style.stroke: "#16a34a"
    style.bold: true
  }

  head_more: "Head 3 ~ 8 (其他子空间)\n• 投影: Q_i K_i V_i\n• 注意力: A_i\n• 读出: O_i [n, 64]" {
    style.stroke: "#f59e0b"
    style.bold: true
  }
}

merge: "聚合与跨头特征重组" {
  grid-columns: 2
  concat: "拼接 Concat: [n, 512]\n纯收集（不融合特征）" {
    style.stroke: "#dc2626"
    style.stroke-width: 2
  }
  wo: "线性投影 × W_O ∈ R^{512×512}\n跨 Head 特征融合与映射" {
    style.stroke: "#dc2626"
    style.stroke-width: 2
    style.bold: true
  }
  concat -> wo
}

output: "最终多头注意力输出: [n, 512]" {
  style.bold: true
  style.stroke-width: 3
}

H -> heads: "投影至 8 个独立子空间"
heads -> merge.concat: "各 Head 读出结果汇总"
merge.wo -> output
