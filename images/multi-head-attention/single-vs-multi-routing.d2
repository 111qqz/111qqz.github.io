grid-columns: 2

single: "Single-Head：单一宽空间竞争 (Single Routing Space)" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
  direction: down

  in1: "输入序列表示 H\n[n, d_model = 512]" {style.stroke: "#2563eb"}

  proj1: "单套 512 维投影\nQ, K, V ∈ ℝ^{n × 512}" {
    style.stroke: "#2563eb"
    style.stroke-width: 2
  }

  routing1: "单一注意力概率分布\n仅有 1 套权重 A ∈ ℝ^{n × n}\n所有语法、指代与语义关系在同一 Softmax 中均摊竞争" {
    style.stroke: "#2563eb"
    style.stroke-width: 2
    style.bold: true
  }

  out1: "单次加权读取输出\nO = A × V ∈ ℝ^{n × 512}\n只能选定单一主导关系" {
    style.stroke: "#2563eb"
  }

  in1 -> proj1 -> routing1 -> out1
}

multi: "Multi-Head：多独立窄子空间解耦 (Multiple Subspaces)" {
  style.stroke: "#16a34a"
  style.stroke-width: 3
  style.bold: true
  direction: down

  in2: "同一输入序列表示 H\n[n, d_model = 512]" {style.stroke: "#2563eb"}

  proj2: "8 套独立 64 维投影\nQ_i, K_i, V_i ∈ ℝ^{n × 64}\n(总参数量与计算量严格守恒)" {
    style.stroke: "#16a34a"
    style.stroke-width: 2
  }

  routing2: "8 个并行独立注意力空间\n产生 8 套权重 A₁ ~ A₈ ∈ ℝ^{n × n}\n同时捕捉就近依存、长程主谓、语义相似等多元关系" {
    style.stroke: "#16a34a"
    style.stroke-width: 2
    style.bold: true
  }

  out2: "8 次独立读取与投影融合\nO = Concat(O₁, ..., O₈) × W_O\n输出高保真综合表征" {
    style.stroke: "#16a34a"
    style.stroke-width: 2
    style.bold: true
  }

  in2 -> proj2 -> routing2 -> out2
}
