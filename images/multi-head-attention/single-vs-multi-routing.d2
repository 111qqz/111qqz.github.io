direction: down

single: "Single-Head (1 个宽空间)" {
  style.stroke: "#2563eb"
  style.stroke-width: 2

  in: "输入表示 H\n[n, 512]" {
    style.bold: true
  }

  proj: "1 套 512-d 投影\nQ, K, V ∈ R^{n×512}" {
    style.stroke: "#2563eb"
  }

  routing: "单一匹配空间\n1 套权重 A ∈ R^{n×n}\n(所有关系均摊竞争)" {
    style.stroke: "#2563eb"
    style.stroke-width: 2
    style.bold: true
  }

  read: "1 次加权读取\nO = AV ∈ R^{n×512}" {
    style.stroke: "#2563eb"
  }

  in -> proj -> routing -> read
}

multi: "Multi-Head (8 个窄子空间)" {
  style.stroke: "#16a34a"
  style.stroke-width: 2

  in: "同一份输入 H\n[n, 512]" {
    style.bold: true
  }

  proj: "8 套独立 64-d 投影\n(总维度 8×64=512 守恒)" {
    style.stroke: "#16a34a"
  }

  routing: "8 个独立子空间\n8 套权重 A₁ ~ A₈ ∈ R^{n×n}\n(同时捕捉多种关系)" {
    style.stroke: "#16a34a"
    style.stroke-width: 2
    style.bold: true
  }

  fusion: "8 次读取 O₁ ~ O₈ [n, 64]\n→ Concat [n, 512]\n→ × W_O 跨 head 融合\n输出 O ∈ R^{n×512}" {
    style.stroke: "#dc2626"
    style.stroke-width: 2
    style.bold: true
  }

  in -> proj -> routing -> fusion
}
