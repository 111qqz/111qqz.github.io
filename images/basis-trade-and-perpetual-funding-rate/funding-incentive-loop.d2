stage1: "" {
  grid-columns: 3
  label: ""

  premium: "永续价格 > 现货价格\n（正基差）" {
    style.stroke: "#f59e0b"
    style.bold: true
    style.stroke-width: 3
  }

  funding: "Funding Rate 为正\n多头向空头付费" {
    style.stroke: "#2563eb"
    style.bold: true
  }

  cost_shift: "多头持仓成本上升\n空头持仓收入增加" {
    style.stroke: "#2563eb"
  }

  premium -> funding: "触发" {
    style.stroke: "#f59e0b"
  }
  funding -> cost_shift: "改变激励" {
    style.stroke: "#2563eb"
  }
}

stage1 -> stage2: "驱动交易行为" {
  style.stroke: "#16a34a"
  style.bold: true
}

stage2: "" {
  grid-columns: 3
  label: ""

  behavior: "套利者入场：\n买现货 + 空永续\n部分多头减仓" {
    style.stroke: "#16a34a"
    style.bold: true
    style.stroke-width: 3
  }

  pressure: "现货买盘增加\n永续卖盘增加" {
    style.stroke: "#16a34a"
  }

  converge: "基差趋于缩小" {
    style.stroke: "#dc2626"
    style.bold: true
    style.stroke-width: 3
  }

  behavior -> pressure: "供需变化" {
    style.stroke: "#16a34a"
  }
  pressure -> converge: "推动价格" {
    style.stroke: "#dc2626"
  }
}
