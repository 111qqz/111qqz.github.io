grid-columns: 4

init: "初始状态" {
  style.stroke: "#2563eb"
  style.bold: true
  label: ""

  g0: "GPU 0\n{A}" {
    style.stroke: "#2563eb"
    style.bold: true
  }
  g1: "GPU 1\n{B}" {
    style.stroke: "#2563eb"
  }
  g2: "GPU 2\n{C}" {
    style.stroke: "#2563eb"
  }
  g3: "GPU 3\n{D}" {
    style.stroke: "#2563eb"
  }

  g0 -> g1: {style.stroke-dash: 4}
  g1 -> g2: {style.stroke-dash: 4}
  g2 -> g3: {style.stroke-dash: 4}
  g3 -> g0: {style.stroke-dash: 4}
}

round1: "第一轮" {
  style.stroke: "#f59e0b"
  style.bold: true
  label: ""

  g0: "GPU 0\n{A, D}" {
    style.stroke: "#f59e0b"
  }
  g1: "GPU 1\n{B, A}" {
    style.stroke: "#f59e0b"
  }
  g2: "GPU 2\n{C, B}" {
    style.stroke: "#f59e0b"
  }
  g3: "GPU 3\n{D, C}" {
    style.stroke: "#f59e0b"
  }

  g0 -> g1: "发 A" {style.stroke: "#f59e0b"}
  g1 -> g2: "发 B" {style.stroke: "#f59e0b"}
  g2 -> g3: "发 C" {style.stroke: "#f59e0b"}
  g3 -> g0: "发 D" {style.stroke: "#f59e0b"}
}

round2: "第二轮" {
  style.stroke: "#16a34a"
  style.bold: true
  label: ""

  g0: "GPU 0\n{A, D, C}" {
    style.stroke: "#16a34a"
  }
  g1: "GPU 1\n{B, A, D}" {
    style.stroke: "#16a34a"
  }
  g2: "GPU 2\n{C, B, A}" {
    style.stroke: "#16a34a"
  }
  g3: "GPU 3\n{D, C, B}" {
    style.stroke: "#16a34a"
  }

  g0 -> g1: "转发 D" {style.stroke: "#16a34a"}
  g1 -> g2: "转发 A" {style.stroke: "#16a34a"}
  g2 -> g3: "转发 B" {style.stroke: "#16a34a"}
  g3 -> g0: "转发 C" {style.stroke: "#16a34a"}
}

round3: "第三轮" {
  style.stroke: "#16a34a"
  style.bold: true
  style.stroke-width: 3
  label: ""

  g0: "GPU 0\n{A, B, C, D}" {
    style.stroke: "#16a34a"
    style.bold: true
  }
  g1: "GPU 1\n{A, B, C, D}" {
    style.stroke: "#16a34a"
    style.bold: true
  }
  g2: "GPU 2\n{A, B, C, D}" {
    style.stroke: "#16a34a"
    style.bold: true
  }
  g3: "GPU 3\n{A, B, C, D}" {
    style.stroke: "#16a34a"
    style.bold: true
  }

  g0 -> g1: "转发 C" {style.stroke: "#16a34a"}
  g1 -> g2: "转发 D" {style.stroke: "#16a34a"}
  g2 -> g3: "转发 A" {style.stroke: "#16a34a"}
  g3 -> g0: "转发 B" {style.stroke: "#16a34a"}
}

init -> round1: {style.stroke-dash: 4}
round1 -> round2: {style.stroke-dash: 4}
round2 -> round3: {style.stroke-dash: 4}
