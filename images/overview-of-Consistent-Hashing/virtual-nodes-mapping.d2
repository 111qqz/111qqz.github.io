direction: down

ring: "哈希环（复制个数 = 2）" {
  shape: circle
  o1: "object1"
  o2: "object2"
  o3: "object3"
  o4: "object4"
  a2: "虚拟节点 A2\n属于 cache A" {
    style.stroke: "#16a34a"
  }
  a1: "虚拟节点 A1\n属于 cache A" {
    style.stroke: "#16a34a"
  }
  c1: "虚拟节点 C1\n属于 cache C" {
    style.stroke: "#2563eb"
  }
  c2: "虚拟节点 C2\n属于 cache C" {
    style.stroke: "#2563eb"
  }
  o1 -> a2 {
    style.stroke: "#16a34a"
  }
  o2 -> a1 {
    style.stroke: "#16a34a"
  }
  o3 -> c1 {
    style.stroke: "#2563eb"
  }
  o4 -> c2 {
    style.stroke: "#2563eb"
  }
}
