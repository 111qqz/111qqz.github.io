direction: down

ring: "哈希环（0 → 2^32-1 → 0）" {
  shape: circle
  o1: "object1\nkey1"
  cA: "cache A\nkey A" {
    style.stroke: "#2563eb"
  }
  o2: "object2\nkey2"
  o3: "object3\nkey3"
  cC: "cache C\nkey C" {
    style.stroke: "#2563eb"
  }
  o4: "object4\nkey4"
  cB: "cache B\nkey B" {
    style.stroke: "#2563eb"
  }
  o1 -> cA: "顺时针" {
    style.stroke: "#16a34a"
  }
  o2 -> cC {
    style.stroke: "#16a34a"
  }
  o3 -> cC {
    style.stroke: "#16a34a"
  }
  o4 -> cB {
    style.stroke: "#16a34a"
  }
}
