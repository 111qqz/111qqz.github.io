direction: right

all_people: "100 人" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
  style.bold: true
}

group_a: "A 组\n40 人 (40%)" {
  style.stroke: "#16a34a"
  style.stroke-width: 2
  style.bold: true
}

group_b: "B 组\n60 人 (60%)" {
  style.stroke: "#f59e0b"
  style.stroke-width: 2
  style.bold: true
}

a_win: "获 10 元\n联合概率\n= 0.4 × 0.75\n= 0.30 (30 人)" {
  style.stroke: "#16a34a"
  style.stroke-width: 3
  style.bold: true
}

a_lose: "获 0 元\n联合概率\n= 0.4 × 0.25\n= 0.10 (10 人)" {
  style.stroke: "#16a34a"
}

b_win: "获 10 元\n联合概率\n= 0.6 × 0.25\n= 0.15 (15 人)" {
  style.stroke: "#f59e0b"
}

b_lose: "获 0 元\n联合概率\n= 0.6 × 0.75\n= 0.45 (45 人)" {
  style.stroke: "#f59e0b"
  style.stroke-width: 3
  style.bold: true
}

all_people -> group_a: "P(Y=A)\n= 0.4" {
  style.stroke: "#16a34a"
  style.stroke-width: 2
}

all_people -> group_b: "P(Y=B)\n= 0.6" {
  style.stroke: "#f59e0b"
  style.stroke-width: 2
}

group_a -> a_win: "P(X=10|Y=A)\n= 0.75" {
  style.stroke: "#16a34a"
  style.stroke-width: 2
}

group_a -> a_lose: "P(X=0|Y=A)\n= 0.25" {
  style.stroke: "#16a34a"
}

group_b -> b_win: "P(X=10|Y=B)\n= 0.25" {
  style.stroke: "#f59e0b"
}

group_b -> b_lose: "P(X=0|Y=B)\n= 0.75" {
  style.stroke: "#f59e0b"
  style.stroke-width: 2
}
