grid-columns: 2

given_group: "已知组别，求奖金概率\nP(X=10 | Y=A)" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
  style.bold: true
  direction: down

  range_g: "统计范围\nA 组全部 40 人" {
    style.stroke: "#2563eb"
    style.stroke-width: 2
  }

  hit_g: "其中获得 10 元\n30 人" {
    style.stroke: "#16a34a"
    style.stroke-width: 2
    style.bold: true
  }

  ans_g: "30 / 40 = 75%" {
    style.stroke: "#2563eb"
    style.stroke-width: 3
    style.bold: true
  }

  range_g -> hit_g -> ans_g
}

given_prize: "已知奖金，求组别概率\nP(Y=A | X=10)" {
  style.stroke: "#dc2626"
  style.stroke-width: 2
  style.bold: true
  direction: down

  range_p: "统计范围\n获奖全部 45 人" {
    style.stroke: "#dc2626"
    style.stroke-width: 2
  }

  hit_p: "其中来自 A 组\n30 人" {
    style.stroke: "#16a34a"
    style.stroke-width: 2
    style.bold: true
  }

  ans_p: "30 / 45 ≈ 66.7%" {
    style.stroke: "#dc2626"
    style.stroke-width: 3
    style.bold: true
  }

  range_p -> hit_p -> ans_p
}
