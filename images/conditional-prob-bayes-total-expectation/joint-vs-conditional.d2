grid-columns: 2

joint: "联合概率\nP(X=10, Y=A) = 30/100" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
  style.bold: true
  direction: down

  scope_j: "统计范围\n全部 100 人" {
    style.stroke: "#2563eb"
    style.stroke-width: 2
  }

  target_j: "符合条件\nA 组且获得 10 元\n30 人" {
    style.stroke: "#16a34a"
    style.stroke-width: 2
    style.bold: true
  }

  result_j: "概率 = 30 / 100 = 0.3" {
    style.stroke: "#2563eb"
    style.stroke-width: 3
    style.bold: true
  }

  scope_j -> target_j: "从全体中找"
  target_j -> result_j
}

conditional: "条件概率\nP(X=10 | Y=A) = 30/40" {
  style.stroke: "#dc2626"
  style.stroke-width: 2
  style.bold: true
  direction: down

  scope_c: "统计范围\n仅 A 组 40 人" {
    style.stroke: "#dc2626"
    style.stroke-width: 2
  }

  target_c: "符合条件\n获得 10 元\n30 人" {
    style.stroke: "#16a34a"
    style.stroke-width: 2
    style.bold: true
  }

  result_c: "概率 = 30 / 40 = 0.75" {
    style.stroke: "#dc2626"
    style.stroke-width: 3
    style.bold: true
  }

  scope_c -> target_c: "已知 A 组\n只在 40 人中找"
  target_c -> result_c
}
