grid-columns: 2

direct: "方法一：直接计算" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
  style.bold: true
  direction: down

  all_people_d: "全部 100 人的奖金" {
    style.stroke: "#2563eb"
  }

  direct_calc: "0 × 55/100\n+ 10 × 45/100\n= 0 + 4.5" {
    style.stroke: "#2563eb"
    style.stroke-width: 2
  }

  direct_result: "E[X] = 4.5 元" {
    style.stroke: "#16a34a"
    style.stroke-width: 3
    style.bold: true
  }

  all_people_d -> direct_calc -> direct_result
}

grouped: "方法二：分组后加权" {
  style.stroke: "#dc2626"
  style.stroke-width: 2
  style.bold: true
  direction: down

  group_step: "分别算各组条件期望" {
    style.stroke: "#dc2626"
  }

  group_detail: "A 组 E[X|Y=A] = 7.5 元\nB 组 E[X|Y=B] = 2.5 元" {
    style.stroke: "#dc2626"
    style.stroke-width: 2
  }

  weight_step: "按组别占比加权\n0.4 × 7.5 + 0.6 × 2.5\n= 3.0 + 1.5" {
    style.stroke: "#dc2626"
    style.stroke-width: 2
  }

  grouped_result: "E[X] = 4.5 元" {
    style.stroke: "#16a34a"
    style.stroke-width: 3
    style.bold: true
  }

  group_step -> group_detail -> weight_step -> grouped_result
}
