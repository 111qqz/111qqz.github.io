grid-columns: 2

before_obs: "观察前" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
  style.bold: true
  direction: down

  prior_val: "先验概率\nP(Y=A) = 40%" {
    style.stroke: "#2563eb"
    style.stroke-width: 2
    style.bold: true
  }

  prior_meaning: "还不知道这个人的奖金\n来自 A 组的概率\n只取决于组别占比" {
    style.stroke: "#2563eb"
  }

  prior_val -> prior_meaning
}

after_obs: "观察到 X=10 后" {
  style.stroke: "#dc2626"
  style.stroke-width: 2
  style.bold: true
  direction: down

  bayes_calc: "贝叶斯更新\nLikelihood × Prior ÷ Evidence\n0.75 × 0.40 ÷ 0.45" {
    style.stroke: "#f59e0b"
    style.stroke-width: 2
  }

  posterior_val: "后验概率\nP(Y=A | X=10) ≈ 66.7%" {
    style.stroke: "#dc2626"
    style.stroke-width: 3
    style.bold: true
  }

  posterior_meaning: "已知获得了 10 元\n来自 A 组的概率上升\n因为 A 组获奖率更高" {
    style.stroke: "#dc2626"
  }

  bayes_calc -> posterior_val -> posterior_meaning
}
