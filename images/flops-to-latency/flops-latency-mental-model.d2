direction: down

Wrong: "错误直觉\nFLOPs → Latency" {
  style.stroke: red
  style.stroke-dash: 4
}
Right: "正确 mental model" {
  style.stroke: blue
  style.bold: true
}
F: "Theoretical FLOPs\nWork"
E: "Hardware Efficiency\nGEMM Shape / AI / Parallelism"
A: "Achieved FLOPS"
L: "Actual Latency\nPerformance"

Wrong -> L: "不要这样" {
  style.stroke-dash: 4
  style.stroke: red
}
Right -> F -> E -> A -> L
