direction: down

ControlPlane: {
  style.stroke: "#2563eb"
  style.stroke-dash: 4

  DatasetMetadata: { style.stroke: "#2563eb" }
  Scheduler: { style.stroke: "#2563eb" }
  DatasetVersionManifest: { style.stroke: "#2563eb" }

  DatasetMetadata -> Scheduler
  DatasetVersionManifest -> Scheduler
}

DataPlane: {
  style.stroke: "#2563eb"
  style.stroke-dash: 4

  DistributedStorage: { style.stroke: "#16a34a" }
  Workers: "Data Workers ×3" { style.stroke: "#2563eb" }
  Caches: "Memory Caches ×3" { style.stroke: "#2563eb" }
  TrainerPrefetchBuffer: { style.stroke: "#2563eb" }
  GPUTrainer: {
    style.stroke: "#2563eb"
    style.bold: true
    style.stroke-width: 3
  }

  DistributedStorage -> Workers
  Workers -> Caches
  Caches -> TrainerPrefetchBuffer
  TrainerPrefetchBuffer -> GPUTrainer
}

ControlPlane.Scheduler -> DataPlane.Workers
