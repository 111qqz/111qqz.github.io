direction: down

stage1: 读取与解码 {
  direction: right
  Fleet: "CPU / Data Worker Fleet" {
    style.stroke: "#2563eb"
  }
  Read: { style.stroke: "#2563eb" }
  Decode: { style.stroke: "#2563eb" }
  Fleet -> Read -> Decode
}

stage2: 预处理与送入训练 {
  direction: right
  Preprocess: { style.stroke: "#2563eb" }
  Prefetch: { style.stroke: "#2563eb" }
  GPU: "GPU Training Fleet" {
    style.stroke: "#2563eb"
    style.bold: true
    style.stroke-width: 3
  }
  Preprocess -> Prefetch -> GPU
}

stage1 -> stage2
