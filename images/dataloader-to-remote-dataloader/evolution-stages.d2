direction: down

stage1: 单机阶段 {
  direction: right
  SingleThreadDataLoading: "Single-thread\nDataLoading" { style.stroke: "#2563eb" }
  MultiWorkerDataLoader: "MultiWorker\nDataLoader" { style.stroke: "#2563eb" }
  SingleThreadDataLoading -> MultiWorkerDataLoader
}

stage2: 流水线与数据格式 {
  direction: right
  PrefetchPipeline: "Prefetch\nPipeline" { style.stroke: "#2563eb" }
  ShardedDataFormat: "Sharded\nDataFormat" { style.stroke: "#2563eb" }
  PrefetchPipeline -> ShardedDataFormat
}

stage3: 远程数据服务 {
  direction: right
  RemoteDataLoader: "Remote\nDataLoader" { style.stroke: "#2563eb" }
  PersistentRemoteCache: "Persistent\nRemote Cache" { style.stroke: "#2563eb" }
  DistributedDataServingSystem: "Distributed\nDataServing" {
    style.stroke: "#2563eb"
    style.bold: true
    style.stroke-width: 3
  }
  RemoteDataLoader -> PersistentRemoteCache -> DistributedDataServingSystem
}

stage1 -> stage2 -> stage3
