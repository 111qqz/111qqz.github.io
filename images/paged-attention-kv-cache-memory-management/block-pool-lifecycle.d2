direction: down

grid-columns: 2

t1: "时刻 1：A 和 B 加入" {
  style.stroke: "#2563eb"
  style.bold: true
  style.stroke-width: 3

  pool: "" {
    label: ""
    grid-columns: 4
    b0: "Block 0\nA:LB0" { style.stroke: "#2563eb"; style.bold: true }
    b1: "Block 1\nA:LB1" { style.stroke: "#2563eb"; style.bold: true }
    b2: "Block 2\nB:LB0" { style.stroke: "#16a34a"; style.bold: true }
    b3: "Block 3\nB:LB1" { style.stroke: "#16a34a"; style.bold: true }
    b4: "Block 4\n空闲" { style.stroke: "#999999"; style.stroke-dash: 4 }
    b5: "Block 5\n空闲" { style.stroke: "#999999"; style.stroke-dash: 4 }
    b6: "Block 6\n空闲" { style.stroke: "#999999"; style.stroke-dash: 4 }
    b7: "Block 7\n空闲" { style.stroke: "#999999"; style.stroke-dash: 4 }
  }

  info: "A: 6 Token (2 Block)\nB: 5 Token (2 Block)\n空闲: 4 Block" {
    style.stroke: "#999999"
  }
}

t2: "时刻 2：A 增长到 9 Token" {
  style.stroke: "#2563eb"
  style.bold: true
  style.stroke-width: 3

  pool: "" {
    label: ""
    grid-columns: 4
    b0: "Block 0\nA:LB0" { style.stroke: "#2563eb"; style.bold: true }
    b1: "Block 1\nA:LB1" { style.stroke: "#2563eb"; style.bold: true }
    b2: "Block 2\nB:LB0" { style.stroke: "#16a34a"; style.bold: true }
    b3: "Block 3\nB:LB1" { style.stroke: "#16a34a"; style.bold: true }
    b4: "Block 4\nA:LB2" { style.stroke: "#2563eb"; style.bold: true; style.stroke-width: 3 }
    b5: "Block 5\n空闲" { style.stroke: "#999999"; style.stroke-dash: 4 }
    b6: "Block 6\n空闲" { style.stroke: "#999999"; style.stroke-dash: 4 }
    b7: "Block 7\n空闲" { style.stroke: "#999999"; style.stroke-dash: 4 }
  }

  info: "A: 9 Token (3 Block)\nB: 不变\n新分配 Block 4 → A:LB2" {
    style.stroke: "#f59e0b"
    style.bold: true
  }
}

t3: "时刻 3：B 结束，C 加入" {
  style.stroke: "#dc2626"
  style.bold: true
  style.stroke-width: 3

  pool: "" {
    label: ""
    grid-columns: 4
    b0: "Block 0\nA:LB0" { style.stroke: "#2563eb"; style.bold: true }
    b1: "Block 1\nA:LB1" { style.stroke: "#2563eb"; style.bold: true }
    b2: "Block 2\nC:LB0" { style.stroke: "#dc2626"; style.bold: true; style.stroke-width: 3 }
    b3: "Block 3\nC:LB1" { style.stroke: "#dc2626"; style.bold: true; style.stroke-width: 3 }
    b4: "Block 4\nA:LB2" { style.stroke: "#2563eb"; style.bold: true }
    b5: "Block 5\n空闲" { style.stroke: "#999999"; style.stroke-dash: 4 }
    b6: "Block 6\n空闲" { style.stroke: "#999999"; style.stroke-dash: 4 }
    b7: "Block 7\n空闲" { style.stroke: "#999999"; style.stroke-dash: 4 }
  }

  info: "B 释放 Block 2, 3\nC: 7 Token (2 Block)\nC 复用了 B 的 Block" {
    style.stroke: "#dc2626"
    style.bold: true
  }
}

t4: "时刻 4：A 增长到 13 Token" {
  style.stroke: "#2563eb"
  style.bold: true
  style.stroke-width: 3

  pool: "" {
    label: ""
    grid-columns: 4
    b0: "Block 0\nA:LB0" { style.stroke: "#2563eb"; style.bold: true }
    b1: "Block 1\nA:LB1" { style.stroke: "#2563eb"; style.bold: true }
    b2: "Block 2\nC:LB0" { style.stroke: "#dc2626"; style.bold: true }
    b3: "Block 3\nC:LB1" { style.stroke: "#dc2626"; style.bold: true }
    b4: "Block 4\nA:LB2" { style.stroke: "#2563eb"; style.bold: true }
    b5: "Block 5\nA:LB3" { style.stroke: "#2563eb"; style.bold: true; style.stroke-width: 3 }
    b6: "Block 6\n空闲" { style.stroke: "#999999"; style.stroke-dash: 4 }
    b7: "Block 7\n空闲" { style.stroke: "#999999"; style.stroke-dash: 4 }
  }

  info: "A: 13 Token (4 Block)\n新分配 Block 5 → A:LB3\n空闲: 2 Block" {
    style.stroke: "#f59e0b"
    style.bold: true
  }
}
