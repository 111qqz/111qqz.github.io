  style.stroke: "#16a34a"
  direction: right
  "Parameters"
  "Optimizer States"
}

"Forward (生成 Activation)": {
  style.stroke: "#2563eb"
  direction: right
  "Act L1" -> "Act L2" -> "Act L3" -> "Act L4"
}

"Backward (计算 Gradient)": {
  style.stroke: "#f59e0b"
  direction: right
  "Grad L4" -> "Grad L3" -> "Grad L2" -> "Grad L1"
}

"Optimizer (参数更新)": {
  style.stroke: "#dc2626"
  "Optimizer Step"
}

# Dependencies
