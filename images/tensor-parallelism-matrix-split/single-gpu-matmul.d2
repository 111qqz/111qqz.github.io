direction: right

x_mat: "X = [1, 2]\nshape (1, 2)" {
  style.stroke: "#2563eb"
  style.bold: true
}

w_mat: "W\n[1, 2, 3, 4]\n[5, 6, 7, 8]\nshape (2, 4)" {
  style.stroke: "#2563eb"
  style.bold: true
}

y_mat: "Y = [11, 14, 17, 20]\nshape (1, 4)" {
  style.stroke: "#16a34a"
  style.bold: true
  style.stroke-width: 3
}

x_mat -> y_mat: "Y = XW" {
  style.bold: true
}
w_mat -> y_mat
