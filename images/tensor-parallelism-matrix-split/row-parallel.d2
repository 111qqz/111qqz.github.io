direction: down

inputs: "输入 X = [1, 2] 按列拆分" {
  style.bold: true
}

gpus: "" {
  label: ""
  grid-columns: 2

  gpu0: "GPU 0" {
    style.stroke: "#2563eb"
    style.bold: true
    style.stroke-width: 3

    x0: "X₀ = [1]" {
      style.stroke: "#2563eb"
    }
    w0: "W₀ = [1, 2, 3, 4]\nshape (1, 4)" {
      style.stroke: "#2563eb"
    }
    y0: "Y₀ = X₀W₀\n= [1, 2, 3, 4]" {
      style.stroke: "#2563eb"
      style.bold: true
    }
    x0 -> y0
    w0 -> y0
  }

  gpu1: "GPU 1" {
    style.stroke: "#16a34a"
    style.bold: true
    style.stroke-width: 3

    x1: "X₁ = [2]" {
      style.stroke: "#16a34a"
    }
    w1: "W₁ = [5, 6, 7, 8]\nshape (1, 4)" {
      style.stroke: "#16a34a"
    }
    y1: "Y₁ = X₁W₁\n= [10, 12, 14, 16]" {
      style.stroke: "#16a34a"
      style.bold: true
    }
    x1 -> y1
    w1 -> y1
  }
}

sum_result: "逐元素求和 Sum\nY = Y₀ + Y₁ = [11, 14, 17, 20]" {
  style.bold: true
  style.stroke-width: 3
}

inputs -> gpus
gpus -> sum_result
