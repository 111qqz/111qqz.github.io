direction: down

x_input: "输入 X（每张 GPU 持有完整副本）" {
  style.bold: true
}

col_par: "第一层：Column Parallel — W₁ 按列分片" {
  grid-columns: 4

  g0: "GPU 0\nH₀ = XW₁,₀\n(B, M/4)" {
    style.stroke: "#2563eb"
    style.bold: true
  }
  g1: "GPU 1\nH₁ = XW₁,₁\n(B, M/4)" {
    style.stroke: "#16a34a"
    style.bold: true
  }
  g2: "GPU 2\nH₂ = XW₁,₂\n(B, M/4)" {
    style.stroke: "#f59e0b"
    style.bold: true
  }
  g3: "GPU 3\nH₃ = XW₁,₃\n(B, M/4)" {
    style.stroke: "#dc2626"
    style.bold: true
  }
}

no_comm: "无需 AllGather\n分片直接衔接到下一层" {
  style.bold: true
  style.stroke-dash: 4
}

row_par: "第二层：Row Parallel — W₂ 按行分片" {
  grid-columns: 4

  g0: "GPU 0\nY₀ = H₀W₂,₀\n(B, K)" {
    style.stroke: "#2563eb"
    style.bold: true
  }
  g1: "GPU 1\nY₁ = H₁W₂,₁\n(B, K)" {
    style.stroke: "#16a34a"
    style.bold: true
  }
  g2: "GPU 2\nY₂ = H₂W₂,₂\n(B, K)" {
    style.stroke: "#f59e0b"
    style.bold: true
  }
  g3: "GPU 3\nY₃ = H₃W₂,₃\n(B, K)" {
    style.stroke: "#dc2626"
    style.bold: true
  }
}

allreduce: "AllReduce(SUM)" {
  style.stroke-dash: 4
  style.bold: true
  style.stroke-width: 3
}

y_output: "Y = Y₀ + Y₁ + Y₂ + Y₃" {
  style.bold: true
  style.stroke-width: 3
}

x_input -> col_par
col_par -> no_comm
no_comm -> row_par
row_par -> allreduce
allreduce -> y_output
