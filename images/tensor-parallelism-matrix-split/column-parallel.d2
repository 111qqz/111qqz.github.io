direction: down

x_shared: "输入 X = [1, 2]（两张 GPU 都持有完整副本）" {
  style.bold: true
}

gpus: "" {
  label: ""
  grid-columns: 2

  gpu0: "GPU 0" {
    style.stroke: "#2563eb"
    style.bold: true
    style.stroke-width: 3

    w0: "W₀ = [1, 2; 5, 6]\nshape (2, 2)" {
      style.stroke: "#2563eb"
    }
    y0: "Y₀ = XW₀\n= [11, 14]" {
      style.stroke: "#2563eb"
      style.bold: true
    }
    w0 -> y0: "X × W₀"
  }

  gpu1: "GPU 1" {
    style.stroke: "#16a34a"
    style.bold: true
    style.stroke-width: 3

    w1: "W₁ = [3, 4; 7, 8]\nshape (2, 2)" {
      style.stroke: "#16a34a"
    }
    y1: "Y₁ = XW₁\n= [17, 20]" {
      style.stroke: "#16a34a"
      style.bold: true
    }
    w1 -> y1: "X × W₁"
  }
}

concat_result: "拼接 Concatenate\nY = [Y₀ | Y₁] = [11, 14, 17, 20]" {
  style.bold: true
  style.stroke-width: 3
}

x_shared -> gpus
gpus -> concat_result
