grid-columns: 2

chain: "时间步顺序依赖" {
  style.bold: true
  direction: down
  step0: "t=0  算力→更新位置"
  step1: "t=1  算力→更新位置"
  step2: "t=2  算力→更新位置"
  dots: "... ..."
  stepN: "t=N  算力→更新位置"

  step0 -> step1: "输出作为下一步输入"
  step1 -> step2
  step2 -> dots
  dots -> stepN
}

insight: "关键区别" {
  style.stroke: "#f59e0b"
  style.bold: true
  style.stroke-width: 3
  direction: down
  fast: "AI 可以加速\n每步的力计算\n(单步更快)" {
    style.stroke: "#16a34a"
    style.bold: true
  }
  seq: "但步与步之间\n的顺序依赖不变\n(无法并行化时间步)" {
    style.stroke: "#dc2626"
    style.bold: true
  }
  fast -> seq
}
