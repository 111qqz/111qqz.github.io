grid-columns: 2

screening: "传统正向筛选" {
  style.stroke: "#2563eb"
  style.bold: true
  direction: down
  db: "已有材料数据库\n(有限)"
  predict: "逐个预测性质"
  filter: "筛选满足要求的"
  limitation: "数据库里没有的\n永远发现不了"

  db -> predict
  predict -> filter
  filter -> limitation {style.stroke-dash: 4; style.stroke: "#dc2626"}
}

generation: "逆向设计 (Inverse Design)" {
  style.stroke: "#16a34a"
  style.bold: true
  direction: down
  target_prop: "目标性质\n(如：高导电、低密度)"
  gen: "AI 生成候选结构\n(Diffusion Model)"
  compute_check: "计算验证稳定性"
  experiment: "实验室合成验证"

  target_prop -> gen
  gen -> compute_check
  compute_check -> experiment
}
