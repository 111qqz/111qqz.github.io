direction: right

p: "position p\n(integer)" {
  style.stroke: "#2563eb"
  style.bold: true
}

theta: "phase\nθ = ω × p" {
  style.stroke: "#2563eb"
}

vec: "[sin(θ), cos(θ)]\n恒在单位圆上\nsin²θ+cos²θ=1" {
  style.stroke: "#16a34a"
  style.bold: true
  style.stroke-width: 3
}

seq: "position 递增时\nphase 每步 +ω" {
  style.stroke: "#dc2626"
  style.bold: true
}

p -> theta: "× ω"
theta -> vec: "sin, cos"
vec -> seq: "p=0→1→2→3…"
