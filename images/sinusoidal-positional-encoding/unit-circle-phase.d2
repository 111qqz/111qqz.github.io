direction: down

p: "position  p\n(integer)" {
  style.stroke: "#2563eb"
  style.bold: true
}

theta: "phase  θ = ω × p" {
  style.stroke: "#2563eb"
}

vec: "[sin(θ), cos(θ)]" {
  style.stroke: "#16a34a"
  style.bold: true
  style.stroke-width: 3
}

circle: "sin²θ + cos²θ = 1" {
  shape: circle
  style.stroke: "#16a34a"
}

seq: {
  label: ""

  p0: "p=0  →  θ=0"
  p1: "p=1  →  θ=ω"
  p2: "p=2  →  θ=2ω"
  p3: "p=3  →  θ=3ω"

  p0 -> p1: "+ω" {style.stroke: "#dc2626"; style.bold: true}
  p1 -> p2: "+ω" {style.stroke: "#dc2626"; style.bold: true}
  p2 -> p3: "+ω" {style.stroke: "#dc2626"; style.bold: true}
}

p -> theta: "× ω"
theta -> vec: "sin, cos"
vec -> circle: "恒在单位圆上"
circle -> seq: "position 递增\nphase 每步 +ω"
