direction: down

mapping: "从离散标量到单位圆几何映射 (Positional Mapping)" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
  style.bold: true

  grid-columns: 2

  pos: "1. 离散标量整数\nPosition p ∈ {0, 1, 2, ...}\n(绝对索引标量，直接使用容易数值爆炸)" {
    style.stroke: "#2563eb"
    style.stroke-width: 2
  }

  phase: "2. 线性相位累加\nPhase θ = ω × p\n(每前进 1 步，相位沿角度旋转 ω 弧度)" {
    style.stroke: "#f59e0b"
    style.stroke-width: 2
    style.bold: true
  }

  coord: "3. 单位圆欧几里得坐标\nv(p) = [sin(ωp), cos(ωp)]ᵀ\n(sin²θ + cos²θ = 1，向量模长恒为 1 有界)" {
    style.stroke: "#16a34a"
    style.stroke-width: 2
    style.bold: true
  }

  geom: "4. 相对几何不变性\n内积 v(p₁)ᵀ v(p₂) = cos(ω(p₁ - p₂))\n(绝对位置相消，内积纯粹由相对位移 Δp 决定)" {
    style.stroke: "#16a34a"
    style.stroke-width: 2
    style.bold: true
  }

  pos -> phase: "乘基频 ω"
  phase -> coord: "三角函数投影"
  coord -> geom: "内积三角恒等式"
}
