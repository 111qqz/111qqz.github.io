direction: down

freq: "单一频率 ω" {
  style.stroke: "#2563eb"
  style.bold: true
  style.stroke-width: 3
}

high: "ω 大（高频）" {
  style.stroke: "#dc2626"
  style.bold: true

  local: "p → p+1：旋转角度大\n局部差异明显"
  long_range: "p → p+100：快速绕圈\n远距离出现周期性重叠"
  local -> long_range
}

low: "ω 小（低频）" {
  style.stroke: "#16a34a"
  style.bold: true

  local: "p → p+1：旋转角度很小\n局部差异不敏感"
  long_range: "p → p+100：phase 缓慢变化\n远距离区分清晰"
  local -> long_range
}

freq -> high
freq -> low
