direction: down

pe: "Sinusoidal PE（固定）\n多个频率的 sin/cos" {
  style.stroke: "#16a34a"
  style.bold: true
}

emb: "token embedding  e" {
  style.stroke: "#2563eb"
}

add: "h = e + PE(p)" {
  style.bold: true
}

proj: "W_Q, W_K, W_V\n（训练中更新）" {
  style.stroke: "#dc2626"
  style.bold: true
  style.stroke-width: 3
}

mha: "Multi-Head Attention" {
  style.stroke: "#dc2626"
}

ffn: "FFN + 后续层" {
  style.stroke: "#dc2626"
}

pe -> add
emb -> add
add -> proj
proj -> mha
mha -> ffn
