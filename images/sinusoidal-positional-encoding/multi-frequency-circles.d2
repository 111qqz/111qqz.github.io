direction: down

pos: "同一个 position  p" {
  style.stroke: "#2563eb"
  style.bold: true
  style.stroke-width: 3
}

w0: "ω₀ 高频\n[sin(ω₀p), cos(ω₀p)]" {
  style.stroke: "#dc2626"
  style.bold: true
}

w1: "ω₁ 中频\n[sin(ω₁p), cos(ω₁p)]" {
  style.stroke: "#f59e0b"
  style.bold: true
}

w2: "ω₂ 低频\n[sin(ω₂p), cos(ω₂p)]" {
  style.stroke: "#16a34a"
  style.bold: true
}

pe: "PE(p)\n拼接所有 [sin, cos] 对" {
  style.stroke-width: 3
  style.bold: true
}

pos -> w0: "fine scale"
pos -> w1: "medium scale"
pos -> w2: "coarse scale"
w0 -> pe
w1 -> pe
w2 -> pe
