direction: down

token_id: "token id" {
  style.stroke: "#2563eb"
  style.bold: true
}

pos_idx: "position index\n(0, 1, 2, 3, ...)" {
  style.stroke: "#16a34a"
  style.bold: true
}

embedding: "Embedding Table" {
  style.stroke: "#2563eb"
}

pe_func: "Positional Encoder\nsin / cos" {
  style.stroke: "#16a34a"
}

e: "token vector\ne ∈ ℝ^d_model" {
  style.stroke: "#2563eb"
  style.bold: true
}

p: "position vector\nPE(p) ∈ ℝ^d_model" {
  style.stroke: "#16a34a"
  style.bold: true
}

h: "h = e + PE(p)" {
  style.stroke-width: 3
  style.bold: true
}

token_id -> embedding
pos_idx -> pe_func
embedding -> e
pe_func -> p
e -> h
p -> h
