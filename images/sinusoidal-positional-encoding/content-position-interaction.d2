direction: down

q: "q_i = (e_i + p_i) W_Q" {
  style.stroke: "#2563eb"
  style.bold: true
}

k: "k_j = (e_j + p_j) W_K" {
  style.stroke: "#2563eb"
  style.bold: true
}

score: "q_i · k_j^T  展开" {
  style.bold: true
  style.stroke-width: 3
}

cc: "e_i A e_j^T\ncontent ↔ content" {
  style.stroke: "#2563eb"
}

cp: "e_i A p_j^T\ncontent ↔ position" {
  style.stroke: "#16a34a"
}

pc: "p_i A e_j^T\nposition ↔ content" {
  style.stroke: "#16a34a"
}

pp: "p_i A p_j^T\nposition ↔ position" {
  style.stroke: "#f59e0b"
}

q -> score
k -> score
score -> cc
score -> cp
score -> pc
score -> pp
