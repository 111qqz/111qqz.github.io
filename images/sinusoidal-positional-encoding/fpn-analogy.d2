direction: down

pattern: "Multi-Scale Representation\n同时提供多个尺度的特征" {
  style.bold: true
  style.stroke-width: 3
  style.stroke: "#f59e0b"
}

fpn: "FPN" {
  style.stroke: "#2563eb"
  style.bold: true

  high: "高分辨率特征图\n局部细节 / 小尺度结构"
  mid: "中分辨率特征图"
  low: "低分辨率特征图\n大感受野 / 大尺度结构"

  high -> mid
  mid -> low
}

sinusoidal: "Sinusoidal PE" {
  style.stroke: "#16a34a"
  style.bold: true

  high: "高频分量\n局部位置变化"
  mid: "中频分量"
  low: "低频分量\n长距离位置结构"

  high -> mid
  mid -> low
}

pattern -> fpn: "空间分辨率" {style.stroke: "#2563eb"}
pattern -> sinusoidal: "频率 / 相位" {style.stroke: "#16a34a"}
