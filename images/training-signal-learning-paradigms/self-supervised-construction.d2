grid-columns: 2

stage1: "Step 1：获取原始数据" {
  style.stroke: "#f59e0b"
  style.bold: true

  raw: "Raw Data\n无人工标注" {
    style.bold: true
  }

  example: "例：\nI love machine learning" {
    style.stroke-dash: 4
  }

  raw -> example
}

stage2: "Step 2：自动构造训练任务" {
  style.stroke: "#16a34a"
  style.bold: true

  pairs: "input: I love machine\ntarget: learning\n（target 来自数据自身）" {
    style.stroke: "#16a34a"
    style.bold: true
  }

  train: "model(input) → ŷ\ncompare ŷ with target\n→ loss → gradient" {
    style.stroke: "#2563eb"
    style.bold: true
  }

  pairs -> train: "正常监督式训练"
}

stage1 -> stage2: "程序规则\n（非人工标注）"
