direction: down

signal: "Training Signal\n来自哪里？" {
  style.bold: true
  style.stroke-width: 3
}

external: "来自外部" {
  style.stroke: "#2563eb"
  style.bold: true
}

from_data: "来自数据本身" {
  style.stroke: "#16a34a"
  style.bold: true
}

supervised: "Supervised\nLearning" {
  style.stroke: "#2563eb"
  style.stroke-width: 3
  style.bold: true
}

no_target: "不构造\n显式 target" {
  style.stroke: "#f59e0b"
}

construct_target: "从数据\n构造 target" {
  style.stroke: "#16a34a"
}

unsupervised: "Unsupervised\nLearning" {
  style.stroke: "#f59e0b"
  style.stroke-width: 3
  style.bold: true
}

self_supervised: "Self-supervised\nLearning" {
  style.stroke: "#16a34a"
  style.stroke-width: 3
  style.bold: true
}

signal -> external
signal -> from_data
external -> supervised
from_data -> no_target
from_data -> construct_target
no_target -> unsupervised
construct_target -> self_supervised

semi_note: "Semi-supervised Learning\n少量外部监督 + 大量未标注数据\n（跨两种来源）" {
  style.stroke: "#9333ea"
  style.stroke-dash: 4
  style.bold: true
}

external -> semi_note: {style.stroke-dash: 4; style.stroke: "#9333ea"}
from_data -> semi_note: {style.stroke-dash: 4; style.stroke: "#9333ea"}
