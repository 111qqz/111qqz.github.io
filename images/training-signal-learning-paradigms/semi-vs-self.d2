grid-columns: 2

semi: "Semi-supervised Learning" {
  style.stroke: "#2563eb"
  style.bold: true

  labeled: "少量 labeled data\n（人工标注）" {
    style.stroke: "#16a34a"
    style.bold: true
  }

  unlabeled: "大量 unlabeled data" {
    style.stroke-dash: 4
  }

  training: "训练" {
    style.stroke: "#2563eb"
  }

  question: "如何利用\n未标注数据？" {
    style.stroke: "#f59e0b"
    style.bold: true
  }

  labeled -> training
  unlabeled -> training
  training -> question
}

self_sup: "Self-supervised Learning" {
  style.stroke: "#dc2626"
  style.bold: true

  raw_data: "大量 raw data\n（无人工标注）" {
    style.bold: true
  }

  auto_target: "自动构造 target" {
    style.stroke: "#f59e0b"
    style.bold: true
  }

  signals: "大量 training signals" {
    style.stroke: "#16a34a"
  }

  question2: "能否让数据自身\n产生监督信号？" {
    style.stroke: "#f59e0b"
    style.bold: true
  }

  raw_data -> auto_target
  auto_target -> signals
  signals -> question2
}
