direction: down

list: "Hypothetical Complete List of [0,1]" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
  style.bold: true

  direction: down

  x1: "x1 = 0. [5] 1 4 1 3 ..." {
    style.stroke: "#dc2626"
    style.stroke-width: 2
    style.bold: true
  }
  x2: "x2 = 0. 3 [6] 2 7 1 ..." {
    style.stroke: "#dc2626"
    style.stroke-width: 2
    style.bold: true
  }
  x3: "x3 = 0. 8 0 [1] 9 4 ..." {
    style.stroke: "#dc2626"
    style.stroke-width: 2
    style.bold: true
  }
  x4: "x4 = 0. 2 3 7 [8] 5 ..." {
    style.stroke: "#dc2626"
    style.stroke-width: 2
    style.bold: true
  }
  x5: "x5 = 0. 9 1 0 2 [1] ..." {
    style.stroke: "#dc2626"
    style.stroke-width: 2
    style.bold: true
  }
  xn: "..." {style.stroke-dash: 3}
}

construct: "Construct y from Diagonal" {
  style.stroke: "#16a34a"
  style.stroke-width: 3
  style.bold: true

  direction: right

  diag: "Diagonal digits:\n5, 6, 1, 8, 1, ..." {style.stroke: "#f59e0b"; style.stroke-width: 2}
  rule: "Flip rule:\nif 1 then 2\nelse 1" {style.stroke: "#f59e0b"; style.stroke-width: 2}
  result: "y = 0.11212...\ny is in [0,1]\nbut NOT in the list" {
    style.stroke: "#16a34a"
    style.stroke-width: 3
    style.bold: true
  }

  diag -> rule -> result
}

list -> construct: "take diagonal digits [5,6,1,8,1,...]" {style.stroke: "#dc2626"; style.bold: true}
