direction: down

title: "Diagonal Traversal of Rationals" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
  style.bold: true
  label: ""

  direction: right

  grid: {
    label: ""
    direction: down

    r1: {
      label: "q = 1"
      direction: right
      a: "1/1"
      b: "2/1"
      c: "3/1"
      d: "4/1"
      e: "..."
      a -> b -> c -> d -> e: {style.stroke-dash: 3; style.opacity: 0.3}
    }
    r2: {
      label: "q = 2"
      direction: right
      a: "1/2"
      b: "2/2"
      c: "3/2"
      d: "4/2"
      e: "..."
      a -> b -> c -> d -> e: {style.stroke-dash: 3; style.opacity: 0.3}
    }
    r3: {
      label: "q = 3"
      direction: right
      a: "1/3"
      b: "2/3"
      c: "3/3"
      d: "4/3"
      e: "..."
      a -> b -> c -> d -> e: {style.stroke-dash: 3; style.opacity: 0.3}
    }
    r4: {
      label: "q = 4"
      direction: right
      a: "1/4"
      b: "2/4"
      c: "3/4"
      d: "4/4"
      e: "..."
      a -> b -> c -> d -> e: {style.stroke-dash: 3; style.opacity: 0.3}
    }
    r5: {
      label: "..."
      direction: right
    }
  }

  path: {
    label: ""
    direction: right

    p1: "#1  1/1" {style.stroke: "#dc2626"; style.stroke-width: 2; style.bold: true}
    p2: "#2  2/1" {style.stroke: "#dc2626"; style.stroke-width: 2}
    p3: "#3  1/2" {style.stroke: "#dc2626"; style.stroke-width: 2}
    p4: "#4  3/1" {style.stroke: "#dc2626"; style.stroke-width: 2}
    p5: "skip 2/2\n= 1/1" {style.stroke: "#f59e0b"; style.stroke-width: 2; style.stroke-dash: 3}
    p6: "#5  1/3" {style.stroke: "#dc2626"; style.stroke-width: 2}
    p7: "#6  4/1" {style.stroke: "#dc2626"; style.stroke-width: 2}
    p8: "..." {style.stroke-dash: 3}

    p1 -> p2 -> p3 -> p4 -> p5 -> p6 -> p7 -> p8
  }
}
