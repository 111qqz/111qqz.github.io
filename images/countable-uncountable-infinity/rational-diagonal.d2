grid-columns: 2

grid_box: "有理数二维网格阵列 (p / q)" {
  grid-columns: 5
  n11: "1/1"
  n21: "2/1"
  n31: "3/1"
  n41: "4/1"
  dots1: "..." {style.stroke-dash: 3}

  n12: "1/2"
  n22: "2/2 (约分)" {style.stroke: "#f59e0b"; style.stroke-dash: 3}
  n32: "3/2"
  n42: "4/2"
  dots2: "..." {style.stroke-dash: 3}

  n13: "1/3"
  n23: "2/3"
  n33: "3/3"
  n43: "4/3"
  dots3: "..." {style.stroke-dash: 3}

  n14: "1/4"
  n24: "2/4"
  n34: "3/4"
  n44: "4/4"
  dots4: "..." {style.stroke-dash: 3}
}

path_box: "对角线折线遍历序列 (一一映射到自然数)" {
  grid-columns: 4
  p1: "#1: 1/1" {style.stroke: "#dc2626"; style.bold: true}
  p2: "#2: 2/1" {style.stroke: "#dc2626"}
  p3: "#3: 1/2" {style.stroke: "#dc2626"}
  p4: "#4: 3/1" {style.stroke: "#dc2626"}
  p5: "跳过: 2/2" {style.stroke: "#f59e0b"; style.stroke-dash: 3}
  p6: "#5: 1/3" {style.stroke: "#dc2626"}
  p7: "#6: 4/1" {style.stroke: "#dc2626"}
  p8: "..." {style.stroke-dash: 3}
}

grid_box -> path_box: "蛇形对角线折线遍历" {
  style.stroke: "#2563eb"
  style.bold: true
}
