direction: down

countable: "Countable (aleph-null)" {
  style.stroke: "#2563eb"
  style.stroke-width: 3
  style.bold: true

  grid-columns: 3

  n: "N\nNatural Numbers\n{1, 2, 3, ...}" {style.stroke: "#2563eb"; style.stroke-width: 2; style.bold: true}
  z: "Z\nIntegers\n{..., -1, 0, 1, ...}" {style.stroke: "#2563eb"; style.stroke-width: 2; style.bold: true}
  q: "Q\nRationals\n{p/q | p,q in Z}" {style.stroke: "#2563eb"; style.stroke-width: 2; style.bold: true}
}

countable -> uncountable: "|N| = |Z| = |Q|  <  |R|\nstrictly smaller" {
  style.stroke: "#dc2626"
  style.stroke-width: 3
  style.bold: true
}

uncountable: "Uncountable (continuum)" {
  style.stroke: "#16a34a"
  style.stroke-width: 3
  style.bold: true

  grid-columns: 3

  r: "R\nReal Numbers" {style.stroke: "#16a34a"; style.stroke-width: 2; style.bold: true}
  interval: "[0, 1]\nUnit Interval" {style.stroke: "#16a34a"; style.stroke-width: 2; style.bold: true}
  irr: "Irrationals\nR minus Q" {style.stroke: "#16a34a"; style.stroke-width: 2; style.bold: true}
}
