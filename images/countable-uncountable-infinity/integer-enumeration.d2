grid: {
  label: "Enumerating All Integers"
  style.stroke: "#2563eb"
  style.stroke-width: 2
  style.bold: true

  grid-columns: 4

  e1: "#1\n\n0" {style.stroke: "#dc2626"; style.stroke-width: 2; style.bold: true}
  e2: "#2\n\n1" {style.stroke: "#2563eb"; style.stroke-width: 2; style.bold: true}
  e3: "#3\n\n-1" {style.stroke: "#2563eb"; style.stroke-width: 2; style.bold: true}
  e4: "#4\n\n2" {style.stroke: "#16a34a"; style.stroke-width: 2; style.bold: true}
  e5: "#5\n\n-2" {style.stroke: "#16a34a"; style.stroke-width: 2; style.bold: true}
  e6: "#6\n\n3" {style.stroke: "#f59e0b"; style.stroke-width: 2; style.bold: true}
  e7: "#7\n\n-3" {style.stroke: "#f59e0b"; style.stroke-width: 2; style.bold: true}
  e8: "...\n\nevery z\ngets a #" {style.stroke-dash: 3}
}
