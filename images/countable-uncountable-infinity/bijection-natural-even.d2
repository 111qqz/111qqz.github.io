direction: right

natural: "Natural Numbers\n(N)" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
  style.bold: true

  n1: "1"
  n2: "2"
  n3: "3"
  n4: "4"
  n5: "5"
  n6: "..."

  n1 -> n2 -> n3 -> n4 -> n5 -> n6: {style.stroke-dash: 3}
}

even: "Even Numbers\n(E)" {
  style.stroke: "#16a34a"
  style.stroke-width: 2
  style.bold: true

  e1: "2"
  e2: "4"
  e3: "6"
  e4: "8"
  e5: "10"
  e6: "..."

  e1 -> e2 -> e3 -> e4 -> e5 -> e6: {style.stroke-dash: 3}
}

natural.n1 -> even.e1: "n = 1\n2n = 2" {
  style.stroke: "#dc2626"
  style.bold: true
}
natural.n2 -> even.e2: "n = 2\n2n = 4" {
  style.stroke: "#dc2626"
}
natural.n3 -> even.e3: "n = 3\n2n = 6" {
  style.stroke: "#dc2626"
}
natural.n4 -> even.e4: "n = 4\n2n = 8" {
  style.stroke: "#dc2626"
}
natural.n5 -> even.e5: "n = 5\n2n = 10" {
  style.stroke: "#dc2626"
}
