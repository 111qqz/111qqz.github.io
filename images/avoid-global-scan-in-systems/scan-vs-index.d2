direction: right

"Naive Global Scan": {
  style.stroke: "#e03131"
  style.bold: true
  
  "Query / Local Condition" -> "Check Doc 1"
  "Query / Local Condition" -> "Check Doc 2"
  "Query / Local Condition" -> "..."
  "Query / Local Condition" -> "Check Doc N (10^9)"
  
  "Check Doc 1" -> "Match?"
}

"Reverse Mapping / Indexed Lookup": {
  style.stroke: "#2f9e44"
  style.bold: true
  
  "Query / Local Condition" -> "Reverse Map \n(O(1) Lookup)"
  "Reverse Map \n(O(1) Lookup)" -> "Candidate 1"
  "Reverse Map \n(O(1) Lookup)" -> "Candidate 2"
  
  "Candidate 1" -> "Target Update / Read"
  "Candidate 2" -> "Target Update / Read"
}
