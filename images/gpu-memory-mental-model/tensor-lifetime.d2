direction: right

t0_2: A (1GB) \nt=0 to 2 {
    style.stroke: blue
    style.stroke-width: 2
}
t1_4: B (2GB) \nt=1 to 4 {
    style.stroke: green
    style.stroke-width: 2
}
t3_5: C (3GB) \nt=3 to 5 {
    style.stroke: orange
    style.stroke-width: 2
}

t0_2 -> t1_4: Peak at t=1~2
t1_4 -> t3_5: Peak at t=3~4
