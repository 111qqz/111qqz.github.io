direction: down

GPU: GPU Capacity {
    style.bold: true
    style.stroke-width: 3
}

Pers: Persistent Region
RW: Runtime Working Set
H: Headroom {
    style.stroke: orange
}

MA: Model A Persistent {
    style.stroke: blue
}
MB: Model B Persistent {
    style.stroke: blue
}
W: Peak of Concurrent\nRuntime Workloads {
    style.stroke: green
}

GPU -> Pers
GPU -> RW
GPU -> H

Pers -> MA
Pers -> MB
RW -> W
