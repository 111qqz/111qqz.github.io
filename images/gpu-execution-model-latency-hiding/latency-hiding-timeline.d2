direction: right

w0: "Warp 0" {
  style.stroke: "#2563eb"
  style.bold: true

  direction: right

  load0: "Load" {
    style.stroke: "#2563eb"
    style.bold: true
  }
  wait0: "等待 HBM\n(数百 cycles)" {
    style.stroke: "#f59e0b"
    style.stroke-dash: 4
  }
  compute0: "数据到达\n继续计算" {
    style.stroke: "#2563eb"
    style.bold: true
  }

  load0 -> wait0 -> compute0: "" {
    style.stroke: "#2563eb"
  }
}

w1: "Warp 1" {
  style.stroke: "#16a34a"
  style.bold: true

  direction: right

  idle1: " " {
    style.stroke: "#999999"
    style.stroke-dash: 4
  }
  exec1: "计算" {
    style.stroke: "#16a34a"
    style.bold: true
  }
  load1: "Load" {
    style.stroke: "#16a34a"
  }
  wait1: "等待..." {
    style.stroke: "#f59e0b"
    style.stroke-dash: 4
  }

  idle1 -> exec1 -> load1 -> wait1: "" {
    style.stroke: "#16a34a"
  }
}

w2: "Warp 2" {
  style.stroke: "#7c3aed"
  style.bold: true

  direction: right

  idle2a: " " {
    style.stroke: "#999999"
    style.stroke-dash: 4
  }
  idle2b: " " {
    style.stroke: "#999999"
    style.stroke-dash: 4
  }
  exec2: "计算" {
    style.stroke: "#7c3aed"
    style.bold: true
  }
  load2: "Load" {
    style.stroke: "#7c3aed"
  }

  idle2a -> idle2b -> exec2 -> load2: "" {
    style.stroke: "#7c3aed"
  }
}

w3: "Warp 3" {
  style.stroke: "#dc2626"
  style.bold: true

  direction: right

  idle3a: " " {
    style.stroke: "#999999"
    style.stroke-dash: 4
  }
  idle3b: " " {
    style.stroke: "#999999"
    style.stroke-dash: 4
  }
  idle3c: " " {
    style.stroke: "#999999"
    style.stroke-dash: 4
  }
  exec3: "计算" {
    style.stroke: "#dc2626"
    style.bold: true
  }

  idle3a -> idle3b -> idle3c -> exec3: "" {
    style.stroke: "#dc2626"
  }
}

scheduler: "Warp Scheduler\n每个 cycle 选择\n一个 Eligible Warp" {
  style.stroke: "#f59e0b"
  style.bold: true
  style.stroke-width: 3
}
