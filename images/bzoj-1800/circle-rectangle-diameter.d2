direction: down

circle_model: "圆内接矩形与直径核心性质" {
  style.stroke: "#2563eb"
  style.bold: true

  grid-columns: 2
  grid-gap: 20

  geom_prop: "直角圆周角性质\n• 矩形内角为 90°，所对弦必为外接圆直径\n• 矩形的两条对角线互相平分且长度相等\n• 结论：任意圆内接矩形的两条对角线必为直径" {
    shape: rectangle
    style.stroke: "#0891b2"
    style.bold: true
  }

  counting_prop: "无重叠组合计数\n• 任意两条不同的直径必确定唯一的内接矩形\n• 设圆上点对构成的直径总数为 c 条\n• 则可构成的矩形总数严格为 C(c, 2) = c*(c-1)/2" {
    shape: rectangle
    style.stroke: "#16a34a"
    style.bold: true
  }
}

algo_step: "双指针尺取快速检测直径" {
  style.stroke: "#f59e0b"
  style.bold: true

  two_pt: "1. 累加得圆周总弧长 L，若 L 为奇数直接输出 0\n2. 双指针扫描圆周点对，判定两点间弧长是否恰为 L/2\n3. 统计直径条数 c 后直接计算组合数，复杂度仅为 O(N)" {
    shape: rectangle
    style.stroke: "#f59e0b"
  }
}

circle_model -> algo_step: "几何性质降维计数"
