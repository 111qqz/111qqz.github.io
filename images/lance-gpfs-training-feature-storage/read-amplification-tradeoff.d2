direction: down

ExtremeA: 极端 A：NPY full read {
  A1: "Read Amplification: 高 (6.7×)"
  A2: "IOPS: 低"
  A3: "Average I/O Size: 大 (~480MB)"
  
  style.stroke: orange
}

ExtremeB: 极端 B：精确读每个 feature {
  B1: "Read Amplification: 最低 (1×)"
  B2: "IOPS: 非常高 (~3000)"
  B3: "Average I/O Size: 非常小 (~24KB)"
  
  style.stroke: red
}

Ideal: 理想方案 {
  I1: "适度 Read Amplification"
  I2: "可控 IOPS"
  I3: "MB-level I/O Size"
  
  style.stroke: green
  style.stroke-width: 3
}

ExtremeA -> Ideal: 太浪费带宽 {
  style.stroke-dash: 4
}
ExtremeB -> Ideal: 太多小 I/O {
  style.stroke-dash: 4
}
