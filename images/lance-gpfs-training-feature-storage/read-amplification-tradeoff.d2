direction: down

ExtremeA: "极端 A：NPY full read\nRead Amplification 高 (6.7×)\nIOPS 低\nAverage I/O Size 大 (~480MB)" {
  style.stroke: "#f59e0b"
}

ExtremeB: "极端 B：精确读每个 feature\nRead Amplification 最低 (1×)\nIOPS 非常高 (~3000)\nAverage I/O Size 非常小 (~24KB)" {
  style.stroke: "#dc2626"
}

Ideal: "理想方案\n适度 Read Amplification\n可控 IOPS\nMB-level I/O Size" {
  style.stroke: "#16a34a"
  style.stroke-width: 3
}

ExtremeA -> Ideal: 太浪费带宽 {
  style.stroke-dash: 4
}
ExtremeB -> Ideal: 太多小 I/O {
  style.stroke-dash: 4
}
