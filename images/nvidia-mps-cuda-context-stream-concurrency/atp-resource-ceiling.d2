direction: down

gpu: "A100 GPU：108 SM 总资源" {
  style.stroke: "#7c3aed"
  style.bold: true
  style.stroke-width: 3

  grid-columns: 2

  client_a: "Client A (ATP=30%)\n可见 32 SM\n上限约束，非独占\n实际使用量可能更少" {
    style.stroke: "#2563eb"
    style.bold: true
  }

  client_b: "Client B (ATP=70%)\n可见 74 SM\n上限约束，非独占\n实际使用量可能更少" {
    style.stroke: "#dc2626"
    style.bold: true
  }

  shared: "HBM / L2 / Memory Fabric\n所有 Client 共享竞争\nATP 不控制这些资源" {
    style.stroke: "#f59e0b"
    style.stroke-dash: 4
    grid-column-span: 2
  }
}

analogy: "类比 CPU Cgroup\nATP ≈ cpu.max（你最多用这么多）\nATP ≠ cpu.shares（给你预留这么多）\n上限约束 ≠ 资源预留 ≠ 性能隔离" {
  style.stroke: "#9ca3af"
  style.stroke-dash: 4
}

gpu -> analogy: "理解 ATP 的正确心智模型" {
  style.stroke: "#9ca3af"
  style.stroke-dash: 4
}
