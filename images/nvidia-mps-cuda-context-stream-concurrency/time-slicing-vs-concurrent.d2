grid-columns: 1

ts: "默认：Time-Sliced Scheduling" {
  style.stroke: "#dc2626"
  style.bold: true
  style.stroke-width: 2

  direction: right

  t1: "Context A\nKernel" {
    style.stroke: "#2563eb"
    style.bold: true
  }
  t2: "Context B\nKernel" {
    style.stroke: "#dc2626"
    style.bold: true
  }
  t3: "Context A\nKernel" {
    style.stroke: "#2563eb"
    style.bold: true
  }
  t4: "Context B\nKernel" {
    style.stroke: "#dc2626"
    style.bold: true
  }

  t1 -> t2: "切换" {
    style.stroke: "#9ca3af"
  }
  t2 -> t3: "切换" {
    style.stroke: "#9ca3af"
  }
  t3 -> t4: "切换" {
    style.stroke: "#9ca3af"
  }
}

mps: "MPS：Concurrent Execution" {
  style.stroke: "#16a34a"
  style.bold: true
  style.stroke-width: 2

  grid-columns: 2

  sm_top: "SM 0-53\nContext A Kernels\n持续执行" {
    style.stroke: "#2563eb"
    style.bold: true
  }

  sm_bot: "SM 54-107\nContext B Kernels\n持续执行" {
    style.stroke: "#dc2626"
    style.bold: true
  }
}

ts -> mps: "启用 MPS 后" {
  style.stroke: "#16a34a"
  style.bold: true
  style.stroke-width: 2
}
