direction: down

"Library Repo": {
  direction: right
  P1: "pyproject.toml\n(numpy >= 1.26)"
  R1: "uv lock"
  L1: "uv.lock\n(numpy == 1.26.4)"
  B1: "uv build"
  W1: "Wheel\n(Requires-Dist: numpy >= 1.26)"

  P1 -> R1 -> L1
  P1 -> B1 -> W1

  L1.style.stroke: "#f59e0b"
  L1.style.stroke-dash: 4

  W1.style.stroke: "#16a34a"
  W1.style.stroke-width: 3
  W1.style.bold: true
}

"Downstream Application": {
  direction: right
  P2: "pyproject.toml"
  R2: "Downstream Resolver"
  L2: "App uv.lock\n(numpy == 2.1.0)"

  P2 -> R2 -> L2

  L2.style.stroke: "#2563eb"
}

"Library Repo" -> "Downstream Application": "pip install / uv add" {
  style.stroke-dash: 4
}
