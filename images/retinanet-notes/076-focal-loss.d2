direction: down

CE: { shape: step; label: "Cross Entropy (CE)\nTreats all samples equally"; style: { stroke: "#aaaaaa" } }
FL: { shape: step; label: "Focal Loss (FL)\nDown-weights easy examples"; style: { stroke: "#4a90e2"; bold: true } }

EasyExamples: { shape: oval; label: "Easy Examples\n(High probability)"; style: { stroke: "#50e3c2" } }
HardExamples: { shape: oval; label: "Hard Examples\n(Low probability)"; style: { stroke: "#e24a4a" } }

CE -> EasyExamples: "High loss contribution"
CE -> HardExamples: "High loss contribution"

FL -> EasyExamples: "Low loss contribution"
FL -> HardExamples: "High loss contribution"
