grid-rows: 3

mha: "MHA  (H_Q = 8,  H_KV = 8)  —  1:1 映射" {
  grid-rows: 2
  q_row: "" {
    grid-columns: 8
    label: ""
    q0: "Q₀" { style.stroke: "#2563eb"; style.bold: true }
    q1: "Q₁" { style.stroke: "#2563eb"; style.bold: true }
    q2: "Q₂" { style.stroke: "#2563eb"; style.bold: true }
    q3: "Q₃" { style.stroke: "#2563eb"; style.bold: true }
    q4: "Q₄" { style.stroke: "#2563eb"; style.bold: true }
    q5: "Q₅" { style.stroke: "#2563eb"; style.bold: true }
    q6: "Q₆" { style.stroke: "#2563eb"; style.bold: true }
    q7: "Q₇" { style.stroke: "#2563eb"; style.bold: true }
  }
  kv_row: "" {
    grid-columns: 8
    label: ""
    kv0: "KV₀" { style.stroke: "#16a34a"; style.bold: true }
    kv1: "KV₁" { style.stroke: "#16a34a"; style.bold: true }
    kv2: "KV₂" { style.stroke: "#16a34a"; style.bold: true }
    kv3: "KV₃" { style.stroke: "#16a34a"; style.bold: true }
    kv4: "KV₄" { style.stroke: "#16a34a"; style.bold: true }
    kv5: "KV₅" { style.stroke: "#16a34a"; style.bold: true }
    kv6: "KV₆" { style.stroke: "#16a34a"; style.bold: true }
    kv7: "KV₇" { style.stroke: "#16a34a"; style.bold: true }
  }
  q_row.q0 -> kv_row.kv0
  q_row.q1 -> kv_row.kv1
  q_row.q2 -> kv_row.kv2
  q_row.q3 -> kv_row.kv3
  q_row.q4 -> kv_row.kv4
  q_row.q5 -> kv_row.kv5
  q_row.q6 -> kv_row.kv6
  q_row.q7 -> kv_row.kv7
}

gqa: "GQA  (H_Q = 8,  H_KV = 2)  —  4:1 分组共享" {
  grid-rows: 2
  q_row: "" {
    grid-columns: 8
    label: ""
    q0: "Q₀" { style.stroke: "#2563eb"; style.bold: true }
    q1: "Q₁" { style.stroke: "#2563eb"; style.bold: true }
    q2: "Q₂" { style.stroke: "#2563eb"; style.bold: true }
    q3: "Q₃" { style.stroke: "#2563eb"; style.bold: true }
    q4: "Q₄" { style.stroke: "#2563eb"; style.bold: true }
    q5: "Q₅" { style.stroke: "#2563eb"; style.bold: true }
    q6: "Q₆" { style.stroke: "#2563eb"; style.bold: true }
    q7: "Q₇" { style.stroke: "#2563eb"; style.bold: true }
  }
  kv_row: "" {
    grid-columns: 2
    label: ""
    kv0: "KV₀" { style.stroke: "#16a34a"; style.bold: true; style.stroke-width: 3 }
    kv1: "KV₁" { style.stroke: "#16a34a"; style.bold: true; style.stroke-width: 3 }
  }
  q_row.q0 -> kv_row.kv0
  q_row.q1 -> kv_row.kv0
  q_row.q2 -> kv_row.kv0
  q_row.q3 -> kv_row.kv0
  q_row.q4 -> kv_row.kv1
  q_row.q5 -> kv_row.kv1
  q_row.q6 -> kv_row.kv1
  q_row.q7 -> kv_row.kv1
}

mqa: "MQA  (H_Q = 8,  H_KV = 1)  —  8:1 全部共享" {
  grid-rows: 2
  q_row: "" {
    grid-columns: 8
    label: ""
    q0: "Q₀" { style.stroke: "#2563eb"; style.bold: true }
    q1: "Q₁" { style.stroke: "#2563eb"; style.bold: true }
    q2: "Q₂" { style.stroke: "#2563eb"; style.bold: true }
    q3: "Q₃" { style.stroke: "#2563eb"; style.bold: true }
    q4: "Q₄" { style.stroke: "#2563eb"; style.bold: true }
    q5: "Q₅" { style.stroke: "#2563eb"; style.bold: true }
    q6: "Q₆" { style.stroke: "#2563eb"; style.bold: true }
    q7: "Q₇" { style.stroke: "#2563eb"; style.bold: true }
  }
  kv_row: "" {
    grid-columns: 1
    label: ""
    kv0: "KV₀" { style.stroke: "#16a34a"; style.bold: true; style.stroke-width: 3 }
  }
  q_row.q0 -> kv_row.kv0
  q_row.q1 -> kv_row.kv0
  q_row.q2 -> kv_row.kv0
  q_row.q3 -> kv_row.kv0
  q_row.q4 -> kv_row.kv0
  q_row.q5 -> kv_row.kv0
  q_row.q6 -> kv_row.kv0
  q_row.q7 -> kv_row.kv0
}
