direction: right

trial: "一次伯努利试验\nY ~ Bernoulli(p)\n结果只有两种" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
  style.bold: true
}

outcome1: "Y = 1 (正面)\n概率 = p\n指数开关: y=1\np¹·(1-p)⁰ = p" {
  style.stroke: "#16a34a"
  style.stroke-width: 2
  style.bold: true
}

outcome0: "Y = 0 (反面)\n概率 = 1 − p\n指数开关: y=0\np⁰·(1-p)¹ = 1−p" {
  style.stroke: "#dc2626"
  style.stroke-width: 2
  style.bold: true
}

trial -> outcome1: "概率 p" {
  style.stroke: "#16a34a"
  style.stroke-width: 2
}
trial -> outcome0: "概率 1−p" {
  style.stroke: "#dc2626"
  style.stroke-width: 2
}
