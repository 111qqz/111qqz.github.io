grid-columns: 2

candidate_a: "候选参数: p = 0.7" {
  style.stroke: "#16a34a"
  style.stroke-width: 2
  style.bold: true
  direction: down

  data_a: "已观察到的数据\ny = 1 (正面)" {
    style.stroke: "#2563eb"
    style.bold: true
  }

  calc_a: "代入公式计算\nP(Y=1 | p=0.7)\n= 0.7¹ × 0.3⁰ = 0.7" {
    style.stroke: "#16a34a"
    style.stroke-width: 2
  }

  verdict_a: "似然 = 0.7\n这个 p 比较能解释\n为什么出现了正面" {
    style.stroke: "#16a34a"
    style.stroke-width: 3
    style.bold: true
  }

  data_a -> calc_a -> verdict_a
}

candidate_b: "候选参数: p = 0.2" {
  style.stroke: "#dc2626"
  style.stroke-width: 2
  style.bold: true
  direction: down

  data_b: "已观察到的数据\ny = 1 (正面)" {
    style.stroke: "#2563eb"
    style.bold: true
  }

  calc_b: "代入公式计算\nP(Y=1 | p=0.2)\n= 0.2¹ × 0.8⁰ = 0.2" {
    style.stroke: "#dc2626"
    style.stroke-width: 2
  }

  verdict_b: "似然 = 0.2\n这个 p 较难解释\n为什么出现了正面" {
    style.stroke: "#dc2626"
    style.stroke-width: 3
    style.bold: true
  }

  data_b -> calc_b -> verdict_b
}
