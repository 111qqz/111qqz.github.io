input: "Token x [4096]"

router: "Router: x × W_g → 8 scores" {
  style.stroke: "#2563eb"
  style.bold: true
}

scores: "8 Expert Scores" {
  grid-columns: 4
  e0: "E0: 1.2" {style.stroke: "#16a34a"; style.stroke-width: 2}
  e1: "E1: -0.3"
  e2: "E2: 0.8"
  e3: "E3: 2.1" {style.stroke: "#16a34a"; style.stroke-width: 2}
  e4: "E4: -1.0"
  e5: "E5: 0.5"
  e6: "E6: 0.1"
  e7: "E7: -0.7"
}

topk: "Top-2 + Softmax\np₃ = 0.71, p₀ = 0.29" {
  style.stroke: "#f59e0b"
  style.bold: true
}

result: "MoE(x) = 0.29 × E₀(x) + 0.71 × E₃(x)" {
  style.stroke: "#16a34a"
  style.bold: true
}

input -> router -> scores -> topk -> result
