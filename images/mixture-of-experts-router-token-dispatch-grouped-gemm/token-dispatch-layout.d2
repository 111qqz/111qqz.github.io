grid-columns: 2

before: "Token-major Layout\nX.shape = [4, 4096]" {
  style.stroke: "#2563eb"
  style.bold: true

  row0: "Row 0: T0 [4096]" {style.stroke: "#dc2626"}
  row1: "Row 1: T1 [4096]" {style.stroke: "#f59e0b"}
  row2: "Row 2: T2 [4096]" {style.stroke: "#16a34a"}
  row3: "Row 3: T3 [4096]" {style.stroke: "#7c3aed"}

  row0 -> row1 -> row2 -> row3: "" {style.stroke-dash: 4}
}

after: "Expert-major Layout\nX_dispatch.shape = [8, 4096]" {
  style.stroke: "#16a34a"
  style.bold: true

  e0: "Expert 0: T0, T2, T3\n[3, 4096]" {
    style.stroke: "#dc2626"
    style.stroke-width: 2
  }
  e1: "Expert 1: T1, T2\n[2, 4096]" {
    style.stroke: "#f59e0b"
    style.stroke-width: 2
  }
  e2: "Expert 2: T0, T1, T3\n[3, 4096]" {
    style.stroke: "#7c3aed"
    style.stroke-width: 2
  }

  e0 -> e1 -> e2: "contiguous\nin memory" {style.stroke-dash: 4}
}
