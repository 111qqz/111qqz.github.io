grid-columns: 2

dense: "Dense Transformer Block" {
  style.stroke: "#2563eb"
  style.bold: true

  in_d: "Input [S, H]"
  attn_d: "Attention Sublayer\n(Norm → MHA → Add)"
  ffn_d: "Dense FFN\n(all tokens share\nsame weight matrices)" {
    style.stroke: "#dc2626"
    style.stroke-width: 3
  }
  out_d: "Output [S, H]"

  in_d -> attn_d -> ffn_d -> out_d
}

moe_block: "MoE Transformer Block" {
  style.stroke: "#16a34a"
  style.bold: true

  in_m: "Input [S, H]"
  attn_m: "Attention Sublayer\n(Norm → MHA → Add)"
  moe_m: "MoE Layer\n(Router selects K of E\nindependent Expert FFNs)" {
    style.stroke: "#dc2626"
    style.stroke-width: 3
  }
  out_m: "Output [S, H]"

  in_m -> attn_m -> moe_m -> out_m
}
