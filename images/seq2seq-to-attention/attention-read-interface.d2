direction: down

q: "s_{t-1}\n（decoder 当前 state，代表读取需求）" {
  style.bold: true
  style.stroke: "#2563eb"
  style.stroke-width: 3
}

h1: "h₁" { shape: cylinder; style.stroke: "#16a34a" }
h2: "h₂" { shape: cylinder; style.stroke: "#16a34a" }
hd: "…"
hT: "h_T" { shape: cylinder; style.stroke: "#16a34a" }

ct: "c_t = Σᵢ αₜ,ᵢ · hᵢ\n（每次 read 返回 fixed size）" {
  style.bold: true
  style.stroke: "#f59e0b"
  style.stroke-width: 3
}

step: "Decoder 第 t 步"

q -> h1: "score" { style.stroke: "#2563eb" }
q -> h2: "score" { style.stroke: "#2563eb" }
q -> hd: { style.stroke-dash: 4 }
q -> hT: "score" { style.stroke: "#2563eb" }

h1 -> ct: "αₜ,₁"
h2 -> ct: "αₜ,₂"
hd -> ct: { style.stroke-dash: 4 }
hT -> ct: "αₜ,T"

ct -> step
