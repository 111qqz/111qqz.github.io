direction: right

src: "x₁ x₂ … x_T\n(source 序列)" {
  style.stroke: "#2563eb"
}

enc: "Encoder\nRNN" {
  style.bold: true
}

c: "c = h_T" {
  shape: cylinder
  style.bold: true
  style.stroke: "#f59e0b"
  style.stroke-width: 3
}

dec: "Decoder\nRNN" {
  style.bold: true
}

tgt: "y₁ y₂ … y_N\n(target 序列)" {
  style.stroke: "#2563eb"
}

src -> enc: "逐步读取"
enc -> c: "T 步后只交出\n一个 fixed-size vector"
c -> dec: "所有 decode step\n共享同一个 c"
dec -> tgt: "逐步生成"
