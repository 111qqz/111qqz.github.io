layout-engine: elk
direction: right

x1: "x₁" {
  style.bold: true
  style.stroke-width: 3
}
x100: "x₁₀₀" {
  style.bold: true
  style.stroke-width: 3
}

rnn: "RNN：沿 state 逐步传递" {
  style.stroke: "#dc2626"
  h1: "h₁"
  h2: "h₂"
  h3: "h₃"
  dots: "…"
  h99: "h₉₉"
  h1 -> h2
  h2 -> h3
  h3 -> dots
  dots -> h99
}

sa: "Self-Attention：同层直接读取" {
  style.stroke: "#2563eb"
  read: "按内容直接读取"
}

x1 -> rnn.h1 {
  style.stroke: "#dc2626"
}
rnn.h99 -> x100 {
  style.stroke: "#dc2626"
}
x1 -> sa.read {
  style.stroke: "#2563eb"
}
sa.read -> x100 {
  style.stroke: "#2563eb"
}
