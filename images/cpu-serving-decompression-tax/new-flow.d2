direction: down

fp16: FP16 Embedding (Memory) {
  style.stroke: "#2563eb"
  style.stroke-width: 2
}
decode_calc: Decode + Arithmetic (FMA) {
  style.stroke-width: 3
  style.bold: true
}
fp32_res: FP32 Result (Memory) {
  style.stroke: "#16a34a"
  style.stroke-width: 2
}

fp16 -> decode_calc: 1. Load 到寄存器
decode_calc -> fp32_res: 2. 融合计算后直接 Store
