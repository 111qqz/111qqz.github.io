direction: right

fp16: "FP16 Embedding\n(Memory)" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
}
decode: "Decode 阶段"
fp32_mid: "FP32 Intermediate\n(Memory)" {
  style.stroke: "#dc2626"
  style.stroke-width: 3
}
calc: "Multiply / Add\n(axpy)"
fp32_res: "FP32 Result\n(Memory)" {
  style.stroke: "#16a34a"
  style.stroke-width: 2
}

fp16 -> decode: "1. 读取"
decode -> fp32_mid: "2. 写入内存"
fp32_mid -> calc: "3. 再次读取"
calc -> fp32_res: "4. 计算并写回"
