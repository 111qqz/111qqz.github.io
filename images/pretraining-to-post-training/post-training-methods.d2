direction: down

base: "Base Model (Pre-training 产出)" {
  style.stroke: "#2563eb"
  style.stroke-width: 3
  style.bold: true
}

post: "Post-training 方法（可选组合，非固定顺序）" {
  style.stroke: "#f59e0b"
  style.bold: true

  grid-columns: 3

  sft_box: "SFT\n指令-回答示范" {
    style.stroke: "#16a34a"
    style.bold: true
  }

  pref_box: "偏好优化\nRLHF / DPO" {
    style.stroke: "#f59e0b"
    style.bold: true
  }

  rl_box: "Reasoning RL\n可验证奖励" {
    style.stroke: "#dc2626"
    style.bold: true
  }
}

output: "Assistant Model" {
  style.stroke: "#16a34a"
  style.stroke-width: 3
  style.bold: true
}

base -> post
post -> output
