grid-rows: 2

pretrain: "Pre-training: 所有 token 参与 loss" {
  style.stroke: "#2563eb"
  style.bold: true

  grid-columns: 7

  t1: "User" {
    style.stroke: "#2563eb"
    style.stroke-width: 3
    style.bold: true
  }
  t2: ":" {
    style.stroke: "#2563eb"
    style.stroke-width: 3
    style.bold: true
  }
  t3: "What" {
    style.stroke: "#2563eb"
    style.stroke-width: 3
    style.bold: true
  }
  t4: "is" {
    style.stroke: "#2563eb"
    style.stroke-width: 3
    style.bold: true
  }
  t5: "1+1?" {
    style.stroke: "#2563eb"
    style.stroke-width: 3
    style.bold: true
  }
  t6: "Asst:" {
    style.stroke: "#2563eb"
    style.stroke-width: 3
    style.bold: true
  }
  t7: "2" {
    style.stroke: "#2563eb"
    style.stroke-width: 3
    style.bold: true
  }
}

sft: "SFT: 仅 response 参与 loss" {
  style.stroke: "#dc2626"
  style.bold: true

  grid-columns: 7

  t1: "User" {
    style.stroke: "#9ca3af"
    style.stroke-dash: 4
  }
  t2: ":" {
    style.stroke: "#9ca3af"
    style.stroke-dash: 4
  }
  t3: "What" {
    style.stroke: "#9ca3af"
    style.stroke-dash: 4
  }
  t4: "is" {
    style.stroke: "#9ca3af"
    style.stroke-dash: 4
  }
  t5: "1+1?" {
    style.stroke: "#9ca3af"
    style.stroke-dash: 4
  }
  t6: "Asst:" {
    style.stroke: "#dc2626"
    style.stroke-width: 3
    style.bold: true
  }
  t7: "2" {
    style.stroke: "#dc2626"
    style.stroke-width: 3
    style.bold: true
  }
}
