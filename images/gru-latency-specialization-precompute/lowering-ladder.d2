direction: down

gru: "GRU(x, h)\n模型语义：谁都看得懂，CPU 不认识"
ops: "MatMul + Add + Sigmoid + Mul + Tanh\n框架算子粒度"
vec: "GEMV / vector operation\n数值 kernel 粒度"
inst: "AVX2 / FMA / machine instruction\n硬件指令粒度"

gru -> ops: "拆成算子组合"
ops -> vec: "固定 shape / layout"
vec -> inst: "选定指令与展开方式"

gru.style.stroke: "#2563eb"
gru.style.bold: true
gru.style.stroke-width: 3
ops.style.stroke: "#2563eb"
vec.style.stroke: "#16a34a"
inst.style.stroke: "#16a34a"
inst.style.bold: true
inst.style.stroke-width: 3
