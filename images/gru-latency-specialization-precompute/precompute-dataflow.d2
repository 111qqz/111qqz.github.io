direction: down

h: "h_{t-1}：上一次 Update 完成时就已确定"
x: "x_t：当前 tick 到来才知道"

pre: "Update 之后就能算\nrec_r = W_hr h + b_hr\nrec_z = W_hz h + b_hz\nrec_n = W_hn h + b_hn"
now: "必须现在算\nix = W_ih x_t + b_ih"

gates: "sigmoid / tanh 组合 → r_t、z_t、n_t"
out: "h_t = (1 - z_t) ⊙ n_t + z_t ⊙ h_{t-1}"

h -> pre
x -> now
pre -> gates: "缓存住，等 x_t"
now -> gates
gates -> out

h.style.stroke: "#16a34a"
x.style.stroke: "#dc2626"
x.style.bold: true
pre.style.stroke: "#16a34a"
pre.style.stroke-width: 3
now.style.stroke: "#dc2626"
now.style.stroke-width: 3
now.style.bold: true
gates.style.stroke: "#2563eb"
gates.style.bold: true
out.style.stroke: "#2563eb"
