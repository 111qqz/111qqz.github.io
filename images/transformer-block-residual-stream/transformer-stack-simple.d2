direction: down

emb: "Token Embedding + Positional Encoding\n(输入表示)" {
  style.stroke: "#2563eb"
  style.bold: true
}

b1: "Transformer Block 1\n(Attention + FFN + Residual + Norm)" {
  style.stroke: "#8b5cf6"
  style.stroke-width: 2
}

b2: "Transformer Block 2\n(独立权重参数)" {
  style.stroke: "#8b5cf6"
  style.stroke-width: 2
}

dots: "..." {
  shape: text
  style.bold: true
}

bn: "Transformer Block N\n(深层抽象表示)" {
  style.stroke: "#8b5cf6"
  style.stroke-width: 2
}

final_norm: "Final LayerNorm\n(最终表示规范化)" {
  style.stroke: "#10b981"
  style.bold: true
}

head: "Output Head (LM Head / Task Head)" {
  style.stroke: "#f59e0b"
  style.stroke-width: 2
  style.bold: true
}

emb -> b1: "x₀"
b1 -> b2: "x₁"
b2 -> dots
dots -> bn
bn -> final_norm: "x_N"
final_norm -> head
