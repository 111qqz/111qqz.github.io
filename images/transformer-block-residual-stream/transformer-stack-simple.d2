direction: right

emb: "Token Embedding\n+ Positional Encoding" {
  style.stroke: "#2563eb"
  style.bold: true
}

b1: "Transformer\nBlock 1" {
  style.stroke: "#8b5cf6"
  style.stroke-width: 2
}

b2: "Transformer\nBlock 2" {
  style.stroke: "#8b5cf6"
  style.stroke-width: 2
}

dots: "…" {
  shape: text
  style.bold: true
}

bn: "Transformer\nBlock N" {
  style.stroke: "#8b5cf6"
  style.stroke-width: 2
}

head: "Final Norm →\nOutput Head" {
  style.stroke: "#f59e0b"
  style.stroke-width: 2
  style.bold: true
}

emb -> b1: "x₀"
b1 -> b2: "x₁"
b2 -> dots
dots -> bn
bn -> head: "x_N"
