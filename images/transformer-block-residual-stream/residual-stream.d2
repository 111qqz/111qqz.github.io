direction: right

x0: "x₀\n(embed+pos)" {
  style.stroke: "#16a34a"
  style.stroke-width: 3
  style.bold: true
}

attn1: "Norm →\nAttention\n→ (+)" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
}

ffn1: "Norm →\nFFN\n→ (+)" {
  style.stroke: "#7c3aed"
  style.stroke-width: 2
}

attn2: "Norm →\nAttention\n→ (+)" {
  style.stroke: "#2563eb"
}

ffn2: "Norm →\nFFN\n→ (+)" {
  style.stroke: "#7c3aed"
}

dots: "…" {
  style.stroke-dash: 4
}

xn: "x_N" {
  style.stroke: "#16a34a"
  style.stroke-width: 3
  style.bold: true
}

x0 -> attn1: "residual\nstream" {style.stroke: "#16a34a"; style.bold: true}
attn1 -> ffn1: "identity +" {style.stroke: "#16a34a"}
ffn1 -> attn2: "identity +" {style.stroke: "#16a34a"}
attn2 -> ffn2
ffn2 -> dots
dots -> xn
