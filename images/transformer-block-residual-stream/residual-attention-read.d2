direction: down

context: "context tokens (j, k, ...)" {
  style.stroke: "#7c3aed"
  style.stroke-width: 2
}

attn: "Attention\n(dynamic read)" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
  style.bold: true
}

read-result: "contextual read result\n(update)" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
}

old-repr: "existing representation (x)" {
  style.stroke: "#16a34a"
  style.stroke-width: 2
  style.bold: true
}

add: "(+)" {
  style.stroke: "#dc2626"
  style.stroke-width: 3
  style.bold: true
}

new-repr: "new representation (x')" {
  style.stroke: "#16a34a"
  style.stroke-width: 3
  style.bold: true
}

context -> attn: "routing + read"
attn -> read-result
read-result -> add: "contextual update"
old-repr -> add: "identity path" {
  style.stroke: "#16a34a"
  style.bold: true
}
add -> new-repr

note: |md
  x' = x + Attention(x)

  existing information
  \+ newly read contextual information
  = updated representation
| {
  style.stroke: "#f59e0b"
  style.stroke-width: 2
}

new-repr -> note: "" {
  style.stroke-dash: 4
  style.opacity: 0.5
}
