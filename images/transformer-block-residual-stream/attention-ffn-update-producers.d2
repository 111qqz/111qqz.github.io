grid-columns: 2

prod1: "Update Producer 1：Multi-Head Attention" {
  style.stroke: "#8b5cf6"
  style.stroke-width: 2
  style.bold: true

  stream1: "Residual Stream 输入\n已有 Token 表示 x_l" {
    style.stroke: "#2563eb"
    style.bold: true
  }

  op1: "跨 Token 交互计算 (Inter-token)\n在 Sequence 维度动态路由并聚合上下文" {
    style.stroke: "#8b5cf6"
    style.stroke-width: 2
    style.bold: true
  }

  id1: "Identity 直通旁路\n保留原始未变换信息" {
    style.stroke: "#16a34a"
    style.stroke-width: 2
  }

  add1: "+ (写回 Stream)" {
    shape: circle
    style.stroke: "#f59e0b"
    style.stroke-width: 2
    style.bold: true
  }

  stream_mid: "更新后 Stream 状态\nx' = x_l + Δ_attn" {
    style.stroke: "#2563eb"
    style.bold: true
  }

  stream1 -> op1: "读取"
  op1 -> add1: "Δ_attn (Context Update)"
  stream1 -> id1: "直通" {style.stroke: "#16a34a"}
  id1 -> add1: "原值" {style.stroke: "#16a34a"}
  add1 -> stream_mid
}

prod2: "Update Producer 2：Feed-Forward Network" {
  style.stroke: "#06b6d4"
  style.stroke-width: 2
  style.bold: true

  stream2: "Residual Stream 输入\n已融入上下文的表示 x'" {
    style.stroke: "#2563eb"
    style.bold: true
  }

  op2: "Token 内部特征变换 (Intra-token)\n在 Feature 维度做非线性扩展与抽取" {
    style.stroke: "#06b6d4"
    style.stroke-width: 2
    style.bold: true
  }

  id2: "Identity 直通旁路\n保留已有上下文表示" {
    style.stroke: "#16a34a"
    style.stroke-width: 2
  }

  add2: "+ (写回 Stream)" {
    shape: circle
    style.stroke: "#f59e0b"
    style.stroke-width: 2
    style.bold: true
  }

  stream_out: "最终 Stream 状态\nx_{l+1} = x' + Δ_ffn" {
    style.stroke: "#2563eb"
    style.stroke-width: 2
    style.bold: true
  }

  stream2 -> op2: "读取"
  op2 -> add2: "Δ_ffn (Feature Update)"
  stream2 -> id2: "直通" {style.stroke: "#16a34a"}
  id2 -> add2: "原值" {style.stroke: "#16a34a"}
  add2 -> stream_out
}

prod1.stream_mid -> prod2.stream2: "写回后作为下一 Producer 的读取源" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
  style.bold: true
}
