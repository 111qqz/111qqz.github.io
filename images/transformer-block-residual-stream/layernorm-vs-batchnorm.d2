direction: down

bn_box: "BatchNorm: 跨样本聚合 (Cross-Sample)" {
  style.stroke: "#f59e0b"
  style.stroke-width: 2
  
  bn_slice: "统计切片: 固定某一 Feature，沿整个 Batch 聚合所有 Token\n• 均值方差受 Batch 内其他样本干扰\n• 推理与微批次 (Batch=1) 表现不稳定"
}

ln_box: "LayerNorm: 单样本独立 (Per-Token)" {
  style.stroke: "#16a34a"
  style.stroke-width: 3
  style.bold: true
  
  ln_slice: "统计切片: 固定单个 Token，沿自身全部 d_model 特征独立归一化\n• Token 间零干扰，Batch 间零干扰\n• 天然适配自回归生成 (Inference) 与变长 Sequence"
}

bn_box -> ln_box: "序列模型选择: 摆脱 Batch 依赖" {
  style.stroke-dash: 3
}
