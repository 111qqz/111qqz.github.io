grid-columns: 2

single_port: "Single-Port SRAM" {
  style.stroke: "#2563eb"
  style.bold: true

  addr: "Address Input" {
    style.stroke: "#2563eb"
  }
  decoder: "Address Decoder" {
    style.stroke: "#2563eb"
    style.bold: true
  }
  array: "SRAM Array (6T Cell)\n1024 x 32 bit" {
    style.stroke: "#2563eb"
  }
  sense: "Sense Amplifier" {
    style.stroke: "#2563eb"
  }
  data_out: "Data Output" {
    style.stroke: "#2563eb"
  }

  addr -> decoder: "1 组地址"
  decoder -> array: "1 条 Wordline"
  array -> sense: "1 组 Bitline"
  sense -> data_out

  limit: "每周期 1 次读或写" {
    style.stroke: "#2563eb"
    style.stroke-dash: 4
  }
}

dual_port: "Dual-Port SRAM" {
  style.stroke: "#f59e0b"
  style.bold: true

  addr_a: "Address A" {
    style.stroke: "#16a34a"
  }
  addr_b: "Address B" {
    style.stroke: "#dc2626"
  }
  dec_a: "Decoder A" {
    style.stroke: "#16a34a"
    style.bold: true
  }
  dec_b: "Decoder B" {
    style.stroke: "#dc2626"
    style.bold: true
  }
  array: "SRAM Array (8T Cell)\n面积 +30~50%/Cell" {
    style.stroke: "#f59e0b"
    style.bold: true
    style.stroke-width: 3
  }
  sense_a: "Sense Amp A" {
    style.stroke: "#16a34a"
  }
  sense_b: "Sense Amp B" {
    style.stroke: "#dc2626"
  }
  data_a: "Data Out A" {
    style.stroke: "#16a34a"
  }
  data_b: "Data Out B" {
    style.stroke: "#dc2626"
  }

  addr_a -> dec_a
  addr_b -> dec_b
  dec_a -> array: "Wordline A"
  dec_b -> array: "Wordline B"
  array -> sense_a: "Bitline A"
  array -> sense_b: "Bitline B"
  sense_a -> data_a
  sense_b -> data_b

  limit: "每周期 2 次独立访问\n每个 Cell 更大更贵" {
    style.stroke: "#f59e0b"
    style.stroke-dash: 4
  }
}
