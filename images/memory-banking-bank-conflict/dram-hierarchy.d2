channel: "Memory Channel" {
  style.stroke: "#2563eb"
  style.bold: true
  style.stroke-width: 2

  rank: "Rank (多个 DRAM 芯片协同)" {
    style.stroke: "#16a34a"
    style.bold: true

    bg0: "Bank Group 0" {
      style.stroke: "#f59e0b"

      bank0: "Bank 0" {
        style.stroke: "#dc2626"
        style.bold: true

        row_buf: "Row Buffer\n(Sense Amp)" {
          style.stroke: "#dc2626"
          style.stroke-dash: 4
        }
        storage: "Storage Array\n(Rows x Columns)" {
          style.stroke: "#dc2626"
        }
        row_buf -> storage: "Activate /\nPrecharge"
      }

      bank1: "Bank 1" {
        style.stroke: "#dc2626"
        style.bold: true

        row_buf: "Row Buffer" {
          style.stroke: "#dc2626"
          style.stroke-dash: 4
        }
        storage: "Storage Array" {
          style.stroke: "#dc2626"
        }
        row_buf -> storage
      }
    }

    bg1: "Bank Group 1" {
      style.stroke: "#f59e0b"

      bank2: "Bank 2" {
        style.stroke: "#dc2626"
        style.bold: true

        row_buf: "Row Buffer" {
          style.stroke: "#dc2626"
          style.stroke-dash: 4
        }
        storage: "Storage Array" {
          style.stroke: "#dc2626"
        }
        row_buf -> storage
      }

      bank3: "Bank 3" {
        style.stroke: "#dc2626"
        style.bold: true

        row_buf: "Row Buffer" {
          style.stroke: "#dc2626"
          style.stroke-dash: 4
        }
        storage: "Storage Array" {
          style.stroke: "#dc2626"
        }
        row_buf -> storage
      }
    }
  }
}
