direction: down

formula: "Interleaved Address Mapping" {
  style.bold: true
  style.stroke: "#2563eb"
  style.stroke-width: 2
}

banks: {
  grid-columns: 4
  label: ""

  bank0: "Bank 0\n──────\nWord 0\nWord 4\nWord 8\nWord 12\n..." {
    style.stroke: "#2563eb"
    style.bold: true
  }
  bank1: "Bank 1\n──────\nWord 1\nWord 5\nWord 9\nWord 13\n..." {
    style.stroke: "#16a34a"
    style.bold: true
  }
  bank2: "Bank 2\n──────\nWord 2\nWord 6\nWord 10\nWord 14\n..." {
    style.stroke: "#f59e0b"
    style.bold: true
  }
  bank3: "Bank 3\n──────\nWord 3\nWord 7\nWord 11\nWord 15\n..." {
    style.stroke: "#dc2626"
    style.bold: true
  }
}

formula -> banks: "BankIndex = WordIndex % 4\n每个 Bank 有独立的访问路径"

note: "Word 0,1,2,3 → 4 个 Bank 并行\nWord 0,4,8,12 → 全部 Bank 0 (Bank Conflict)" {
  style.stroke-dash: 4
}

banks -> note
