direction: down

title: "QKᵀ：Routing Score Table" {
  style.bold: true
  style.stroke-width: 3
}

table: {
  shape: sql_table
  "": "K₁ (Candidate 1) | K₂ (Candidate 2) | K₃ (Candidate 3) | K₄ (Candidate 4)"
  "Q₁ (Requester 1)": "q₁·k₁ | q₁·k₂ | q₁·k₃ | q₁·k₄"
  "Q₂ (Requester 2)": "q₂·k₁ | q₂·k₂ | q₂·k₃ | q₂·k₄"
  "Q₃ (Requester 3)": "q₃·k₁ | q₃·k₂ | q₃·k₃ | q₃·k₄"
  "Q₄ (Requester 4)": "q₄·k₁ | q₄·k₂ | q₄·k₃ | q₄·k₄"
}

row_note: "row i = token i 当前想从 sequence 中读谁" {
  style.stroke: "#2563eb"
  style.stroke-dash: 4
}

col_note: "column j = token j 作为 candidate 对不同 requester 的匹配度" {
  style.stroke: "#16a34a"
  style.stroke-dash: 4
}

diag_note: "对角线 s_ii = 自己也是自己的 candidate" {
  style.stroke: "#f59e0b"
  style.stroke-dash: 4
}

title -> table
table -> row_note
table -> col_note
table -> diag_note
