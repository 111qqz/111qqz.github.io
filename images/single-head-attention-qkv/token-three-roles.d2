direction: down

hi: "h_i\n（token i 的 hidden state）" {
  style.bold: true
  style.stroke-width: 3
}

query: "Query  q_i\n我需要什么？" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
}

key: "Key  k_i\n别人怎么找到我？" {
  style.stroke: "#f59e0b"
  style.stroke-width: 2
}

value: "Value  v_i\n找到我后我提供什么？" {
  style.stroke: "#16a34a"
  style.stroke-width: 2
}

role_q: "requester" {
  style.stroke: "#2563eb"
  style.stroke-dash: 4
}

role_k: "candidate" {
  style.stroke: "#f59e0b"
  style.stroke-dash: 4
}

role_v: "provider" {
  style.stroke: "#16a34a"
  style.stroke-dash: 4
}

hi -> query: "W_Q" {
  style.stroke: "#2563eb"
}
hi -> key: "W_K" {
  style.stroke: "#f59e0b"
}
hi -> value: "W_V" {
  style.stroke: "#16a34a"
}

query -> role_q {
  style.stroke-dash: 4
  style.stroke: "#2563eb"
}
key -> role_k {
  style.stroke-dash: 4
  style.stroke: "#f59e0b"
}
value -> role_v {
  style.stroke-dash: 4
  style.stroke: "#16a34a"
}
