direction: right

classes: {
  big_text: {
    style: {
      font-size: 32
    }
  }
}

requester: "Requester" {
  class: big_text
  style.bold: true
  style.stroke: "#2563eb"
  style.stroke-width: 3
}

query: "Query\n= request descriptor\n「我现在需要什么？」" {
  class: big_text
  style.stroke: "#2563eb"
  style.stroke-width: 2
}

candidates: "Candidates" {
  direction: down
  class: big_text
  style.stroke: "#16a34a"
  style.stroke-width: 2

  key: "Key\n= routing descriptor\n「别人怎么判断\n要不要调用我？」" {
    class: big_text
    style.stroke: "#2563eb"
  }

  value: "Value\n= response payload\n「调用我之后，\n我返回什么？」" {
    class: big_text
    style.stroke: "#16a34a"
  }
}

result: "Read Result\n= weighted\npayload" {
  class: big_text
  style.bold: true
  style.stroke: "#f59e0b"
  style.stroke-width: 3
}

requester -> query: "表达需求" {
  style.font-size: 32
}
query -> candidates.key: "matching\n是否值得读？" {
  style.font-size: 32
  style.stroke: "#2563eb"
}
candidates.key -> candidates.value: "routing\n→ payload" {
  style.font-size: 32
  style.stroke-dash: 4
}
candidates.value -> result: "传递信息" {
  style.font-size: 32
  style.stroke: "#16a34a"
}
