grid-columns: 2
style.stroke: transparent

left_col: {
  style.stroke: transparent
  direction: down
  requester: "Requester" {
    style.bold: true
    style.stroke: "#2563eb"
    style.stroke-width: 3
  }

  query: "Query\n= request descriptor\n「我现在需要什么？」" {
    style.stroke: "#2563eb"
    style.stroke-width: 2
  }
  requester -> query: "表达需求"
}

right_col: {
  style.stroke: transparent
  direction: down
  candidates: "Candidates" {
    style.stroke: "#16a34a"
    style.stroke-width: 2

    key: "Key\n= routing descriptor\n「别人怎么判断\n要不要调用我？」" {
      style.stroke: "#2563eb"
    }

    value: "Value\n= response payload\n「调用我之后，\n我返回什么？」" {
      style.stroke: "#16a34a"
    }
    key -> value: "routing\n→ payload" {
      style.stroke-dash: 4
    }
  }

  result: "Read Result\n= weighted\npayload" {
    style.bold: true
    style.stroke: "#f59e0b"
    style.stroke-width: 3
  }
  candidates.value -> result: "传递信息" {
    style.stroke: "#16a34a"
  }
}

left_col.query -> right_col.candidates.key: "matching\n是否值得读？" {
  style.stroke: "#2563eb"
}
