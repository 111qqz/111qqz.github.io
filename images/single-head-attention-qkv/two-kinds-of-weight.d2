direction: right

proj: "Projection weights\n（模型参数，feature dimension）" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
  label: ""

  title: "Projection weights W_Q / W_K / W_V\n作用于 feature dimension" {
    style.bold: true
    style.stroke: "#2563eb"
  }

  hi: "h_i\n[d_model]"
  wq: "W_Q\n[d_model, d_k]" {
    style.stroke: "#2563eb"
  }
  qi: "q_i\n[d_k]"

  hi -> wq: "linear\ntransform" {
    style.stroke: "#2563eb"
  }
  wq -> qi {
    style.stroke: "#2563eb"
  }

  note: "trained params\nshared across tokens\nno softmax" {
    style.stroke-dash: 4
  }
}

attn: "Attention weights\n（动态产生，token dimension）" {
  style.stroke: "#dc2626"
  style.stroke-width: 2
  label: ""

  title: "Attention weights alpha_ij\n作用于 token dimension" {
    style.bold: true
    style.stroke: "#dc2626"
  }

  v1: "v₁"
  v2: "v₂"
  v3: "v₃"
  oi: "o_i\n= 0.1v₁ + 0.15v₂ + 0.75v₃" {
    style.bold: true
  }

  v1 -> oi: "alpha = 0.10" {
    style.stroke: "#dc2626"
  }
  v2 -> oi: "alpha = 0.15" {
    style.stroke: "#dc2626"
  }
  v3 -> oi: "alpha = 0.75" {
    style.stroke: "#dc2626"
  }

  note: "input-dependent\nper-query dynamic\nsoftmax normalized" {
    style.stroke-dash: 4
  }
}
