grid-columns: 2

all_signals: "全部信号（100 个）" {
  correct_all: "预测正确：60 个\n（60%）" {
    style.stroke: "#16a34a"
    style.stroke-width: 3
    style.bold: true
  }
  wrong_all: "预测错误：40 个\n（40%）" {
    style.stroke: "#dc2626"
    style.stroke-width: 2
  }
}

filled_signals: "实际成交（40 个）" {
  correct_fill: "预测正确：10 个\n（25%）" {
    style.stroke: "#16a34a"
    style.stroke-width: 2
  }
  wrong_fill: "预测错误：30 个\n（75%）" {
    style.stroke: "#dc2626"
    style.stroke-width: 3
    style.bold: true
  }
}

note_bottom: "Selection Bias：\n成交样本中，预测错误的比例\n从 40% 上升到 75%" {
  style.stroke: "#f59e0b"
  style.stroke-width: 2
  style.bold: true
}

all_signals -> note_bottom: "Accuracy 60%" {
  style.stroke: "#16a34a"
}
filled_signals -> note_bottom: "Accuracy 25%" {
  style.stroke: "#dc2626"
}
