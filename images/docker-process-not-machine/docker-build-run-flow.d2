direction: down

Dockerfile: "Dockerfile\n(构建指令与基础镜像)" {
  style: {
    stroke: "#2563eb"
    stroke-width: 3
    bold: true
  }
}
Image 1: "Image\n(只读镜像层)" {
  style: {
    stroke: "#16a34a"
  }
}
Registry: "Registry\n(镜像仓库)" {
  style: {
    stroke: "#16a34a"
  }
}
Image 2: "Image\n(从仓库拉取的镜像)" {
  style: {
    stroke: "#16a34a"
  }
}
Container: "Container\n(可写层 + 运行进程)" {
  style: {
    stroke: "#2563eb"
    stroke-width: 3
    bold: true
  }
}

Dockerfile -> Image 1: docker build
Image 1 -> Registry: docker push
Registry -> Image 2: docker pull
Image 2 -> Container: docker run
