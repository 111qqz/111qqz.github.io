direction: right

Dockerfile: "Dockerfile\n(构建指令)" {
  style.stroke: "#2563eb"
  style.stroke-width: 3
  style.bold: true
}
Image1: "Image\n(只读镜像层)" {
  style.stroke: "#16a34a"
}
Registry: "Registry\n(镜像仓库)" {
  style.stroke: "#16a34a"
}
Image2: "Image\n(拉取的镜像)" {
  style.stroke: "#16a34a"
}
Container: "Container\n(可写层 + 运行进程)" {
  style.stroke: "#2563eb"
  style.stroke-width: 3
  style.bold: true
}

Dockerfile -> Image1: "docker build"
Image1 -> Registry: "docker push"
Registry -> Image2: "docker pull"
Image2 -> Container: "docker run"
