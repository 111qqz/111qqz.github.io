direction: right

x1: x₁
x2: x₂
x3: x₃

h1: h₁ {
  style: { stroke: blue; stroke-width: 3; bold: true }
}
h2: h₂ {
  style: { stroke: blue; stroke-width: 3; bold: true }
}
h3: h₃ {
  style: { stroke: blue; stroke-width: 3; bold: true }
}

x1 -> h1
x2 -> h2
x3 -> h3
h1 -> h2
h2 -> h3

lm: 语言模型：每步输出 {
  style: { stroke: green }
  y1: ŷ₁
  y2: ŷ₂
  y3: ŷ₃
}

cls: 序列分类：只在最后一步输出 {
  style: { stroke: orange }
  yc: ŷ
}

h1 -> lm.y1
h2 -> lm.y2
h3 -> lm.y3
h3 -> cls.yc
