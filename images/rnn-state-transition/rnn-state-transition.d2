direction: right

h0: "h₀" { style.stroke: blue; style.stroke-width: 3; style.bold: true }
h1: "h₁" { style.stroke: blue; style.stroke-width: 3; style.bold: true }
h2: "h₂" { style.stroke: blue; style.stroke-width: 3; style.bold: true }
h3: "h₃" { style.stroke: blue; style.stroke-width: 3; style.bold: true }
h4: "h_T" { style.stroke: blue; style.stroke-width: 3; style.bold: true }

x1: "x₁"
x2: "x₂"
x3: "x₃"

h0 -> h1: "f_W"
h1 -> h2: "f_W"
h2 -> h3: "f_W"
h3 -> h4: "…" { style.stroke-dash: 4 }

x1 -> h1
x2 -> h2
x3 -> h3
