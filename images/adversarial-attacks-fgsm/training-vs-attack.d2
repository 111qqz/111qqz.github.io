grid-columns: 2

normal: "正常训练" {
  style.stroke: "#2563eb"
  style.stroke-width: 3
  style.bold: true

  fix_input: "固定输入 x" {
    style.stroke: "#2563eb"
  }
  grad_param: "对参数 θ 求梯度\n∇_θ L(θ, x, y)" {
    style.stroke: "#2563eb"
  }
  update_param: "更新参数降低 Loss\nθ' = θ − η · ∇_θ L" {
    style.stroke: "#16a34a"
    style.stroke-width: 2
    style.bold: true
  }

  fix_input -> grad_param: "反向传播"
  grad_param -> update_param: "梯度下降"
}

attack: "对抗攻击" {
  style.stroke: "#dc2626"
  style.stroke-width: 3
  style.bold: true

  fix_param: "固定参数 θ" {
    style.stroke: "#dc2626"
  }
  grad_input: "对输入 x 求梯度\n∇_x L(θ, x, y)" {
    style.stroke: "#dc2626"
  }
  update_input: "修改输入提高 Loss\nx' = x + ε · sign(∇_x L)" {
    style.stroke: "#f59e0b"
    style.stroke-width: 2
    style.bold: true
  }

  fix_param -> grad_input: "反向传播"
  grad_input -> update_input: "梯度上升"
}
