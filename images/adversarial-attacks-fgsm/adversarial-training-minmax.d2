grid-rows: 2
grid-columns: 2

batch: "训练数据 (x, y)" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
}

inner: "内层 max\n找最强扰动 δ*" {
  style.stroke: "#dc2626"
  style.stroke-width: 3
  style.bold: true
}

adv_sample: "对抗样本\nx_adv = x + δ*" {
  style.stroke: "#f59e0b"
  style.stroke-width: 2
  style.bold: true
}

outer: "外层 min\n更新 θ 降低 Loss" {
  style.stroke: "#16a34a"
  style.stroke-width: 3
  style.bold: true
}

batch -> inner: "输入"
inner -> adv_sample: "生成"
adv_sample -> outer: "训练"
outer -> batch: "下一轮" {
  style.stroke-dash: 4
  style.stroke: "#888888"
}
