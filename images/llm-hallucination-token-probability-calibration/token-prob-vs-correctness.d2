direction: down

training_data: "Training Corpus" {
  style.stroke: "#2563eb"
  style.bold: true
  grid-columns: 2
  fact_a: "\"Country X capital is B\"\n(500 occurrences)"
  fact_b: "\"Country X capital is C\"\n(20 occurrences)"
}

model: "Language Model Output" {
  style.stroke: "#16a34a"
  style.bold: true
  prob: "P(B | context) = 92%\nP(C | context) = 6%\nP(other) = 2%"
}

result: "But in reality" {
  style.stroke: "#dc2626"
  style.bold: true
  grid-columns: 2
  wrong: "B (92% probability)\n= wrong answer" {
    style.stroke: "#dc2626"
  }
  correct: "C (6% probability)\n= correct answer" {
    style.stroke: "#16a34a"
  }
}

training_data -> model: "cross entropy\nminimization" {
  style.stroke: "#2563eb"
}

model -> result: "high P(token)\ndoes not guarantee\nfactual correctness" {
  style.stroke: "#dc2626"
  style.stroke-dash: 4
  style.stroke-width: 2
}
