grid-columns: 2

test_env: "Test Set (General Knowledge)" {
  style.stroke: "#16a34a"
  style.bold: true

  report_test: "Model reports\nconfidence = 90%"
  actual_test: "Actual accuracy\n≈ 90%"

  report_test -> actual_test: "well calibrated" {
    style.stroke: "#16a34a"
  }
}

prod_env: "Production (CUDA / niche topics)" {
  style.stroke: "#dc2626"
  style.bold: true

  report_prod: "Model still reports\nconfidence = 90%"
  actual_prod: "Actual accuracy\n≈ 60%"

  report_prod -> actual_prod: "overconfident" {
    style.stroke: "#dc2626"
    style.stroke-dash: 4
  }
}
