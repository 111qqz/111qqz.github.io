grid-columns: 2

policy: "Policy π_θ（策略网络）\n根据当前状态选择动作" {
  style.stroke: "#7c3aed"
  style.stroke-width: 3
  style.bold: true
}

action_node: "Action（执行动作）\n转向 / 加速 / 刹车" {
  style.stroke: "#f59e0b"
  style.stroke-width: 2
  style.bold: true
}

state_reward: "State s' + Reward r\n仿真器返回新状态与奖励" {
  style.stroke: "#dc2626"
  style.stroke-width: 2
  style.bold: true
}

sim: "Simulator（仿真环境）\n模拟车辆动力学与交通场景\n替代真实世界提供安全试错" {
  style.stroke: "#16a34a"
  style.stroke-width: 3
  style.bold: true
}

policy -> action_node: "① 采样动作"
action_node -> sim: "② 执行"
sim -> state_reward: "③ 环境反馈"
state_reward -> policy: "④ 更新输入（闭环）" {
  style.stroke-dash: 5
}
