direction: down

draft: "Draft Model 采样 x ~ q(x)" {
  style.stroke: "#2563eb"
  style.bold: true
}

verify: "Target Model 计算 p(x)\n判定: u ≤ min(1, p(x)/q(x)) ?" {
  style.stroke: "#f59e0b"
  style.bold: true
  style.stroke-width: 3
}

result: {
  grid-columns: 2
  label: ""

  accept: "接受\n使用 Draft 的 token x" {
    style.stroke: "#16a34a"
    style.bold: true
  }

  reject_resample: "拒绝 → 从修正分布采样\np'(x) = norm(max(0, p-q))" {
    style.stroke: "#dc2626"
    style.bold: true
  }
}

draft -> verify: "候选 token x"
verify -> result.accept: "是"
verify -> result.reject_resample: "否"
