direction: down

training: Training {
  style.stroke: blue
  style.stroke-dash: 4
  
  A: Training corpus {
    style.stroke: green
  }
  B: BPE Trainer {
    style.stroke: blue
  }
  C: Vocabulary {
    style.stroke: green
  }
  D: Merge rules {
    style.stroke: green
  }
  
  A -> B
  B -> C
  B -> D
}

inference: Encoding {
  style.stroke: orange
  style.stroke-dash: 4
  
  E: New text {
    style.stroke: green
  }
  F: Tokenizer.encode {
    style.stroke: blue
  }
  G: Token IDs {
    style.stroke: green
  }
  
  E -> F
  F -> G
}

training.C -> inference.F
training.D -> inference.F
