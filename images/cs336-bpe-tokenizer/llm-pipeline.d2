direction: down

stage1: 文本到 Token {
  direction: right
  A: Raw Text {
    style.stroke: "#16a34a"
  }
  B: Tokenizer {
    style.stroke: "#f59e0b"
    style.stroke-width: 3
  }
  C: Token IDs {
    style.stroke: "#16a34a"
  }
  A -> B -> C
}

stage2: Token 到输出分布 {
  direction: right
  D: Embedding {
    style.stroke: "#2563eb"
  }
  E: Transformer {
    style.stroke: "#2563eb"
  }
  F: Logits {
    style.stroke: "#16a34a"
  }
  D -> E -> F
}

stage1 -> stage2
