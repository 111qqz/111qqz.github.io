grid-columns: 1

fwd: "Forward（从左到右）" {
  style.stroke: "#2563eb"
  style.bold: true
  direction: right
  input: "Input" {
    style.stroke: "#2563eb"
  }
  l1: "L₁" {
    style.stroke: "#2563eb"
    style.stroke-width: 3
  }
  l2: "L₂" {
    style.stroke: "#2563eb"
    style.stroke-width: 3
  }
  l3: "L₃" {
    style.stroke: "#2563eb"
    style.stroke-width: 3
  }
  l4: "L₄" {
    style.stroke: "#2563eb"
    style.stroke-width: 3
  }
  loss_node: "Loss" {
    style.stroke: "#2563eb"
  }
  input -> l1 -> l2 -> l3 -> l4 -> loss_node
}

bwd: "Backward（从右到左，梯度依次 ready）" {
  style.stroke: "#f59e0b"
  style.bold: true
  direction: right
  loss_bwd: "Loss" {
    style.stroke: "#f59e0b"
  }
  g4: "g₄ ①\n最先 ready" {
    style.stroke: "#dc2626"
    style.bold: true
    style.stroke-width: 3
  }
  g3: "g₃ ②" {
    style.stroke: "#f59e0b"
    style.stroke-width: 3
  }
  g2: "g₂ ③" {
    style.stroke: "#f59e0b"
    style.stroke-width: 3
  }
  g1: "g₁ ④\n最后 ready" {
    style.stroke: "#dc2626"
    style.bold: true
    style.stroke-width: 3
  }
  loss_bwd -> g4 -> g3 -> g2 -> g1
}
