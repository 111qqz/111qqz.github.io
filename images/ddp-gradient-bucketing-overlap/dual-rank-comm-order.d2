grid-columns: 2

rank0: "Rank 0（较快）" {
  style.stroke: "#2563eb"
  style.bold: true
  direction: down
  r0_ready: "Bucket ready 顺序\n1 → 2 → 3" {
    style.stroke: "#16a34a"
    style.stroke-width: 3
  }
  r0_ar: "AR 发起顺序\n1 → 2 → 3" {
    style.stroke: "#f59e0b"
    style.bold: true
    style.stroke-width: 3
  }
  r0_ready -> r0_ar: "按序发起"
}

rank1: "Rank 1（较慢）" {
  style.stroke: "#dc2626"
  style.bold: true
  direction: down
  r1_ready: "Bucket ready 顺序\n1 → 2 → 3" {
    style.stroke: "#16a34a"
    style.stroke-width: 3
  }
  r1_ar: "AR 发起顺序\n1 → 2 → 3" {
    style.stroke: "#f59e0b"
    style.bold: true
    style.stroke-width: 3
  }
  r1_ready -> r1_ar: "按序发起"
}

key_rule: "关键约束" {
  style.stroke: "#dc2626"
  style.bold: true
  style.stroke-width: 3
  direction: down
  rule1: "Ready 顺序可因执行\n速度不同而略有差异" {
    style.stroke: "#f59e0b"
  }
  rule2: "AR 发起顺序必须一致\n否则集合通信死锁" {
    style.stroke: "#dc2626"
    style.bold: true
    style.stroke-width: 3
  }
  rule1 -> rule2
}
