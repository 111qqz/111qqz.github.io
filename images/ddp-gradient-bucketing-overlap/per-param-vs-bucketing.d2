grid-columns: 2

per_param: "逐参数 All-Reduce" {
  style.stroke: "#dc2626"
  style.bold: true

  direction: down
  p1: "param 1 梯度 → AR ①\n(固定开销 α)" {
    style.stroke: "#f59e0b"
  }
  p2: "param 2 梯度 → AR ②\n(固定开销 α)" {
    style.stroke: "#f59e0b"
  }
  p3: "param 3 梯度 → AR ③\n(固定开销 α)" {
    style.stroke: "#f59e0b"
  }
  dots: "…… 200 个参数 ……\n共 200 次 α" {
    style.stroke: "#dc2626"
    style.stroke-dash: 4
  }
  p200: "param 200 梯度 → AR ⑳⓪\n(固定开销 α)" {
    style.stroke: "#f59e0b"
  }

  p1 -> p2
  p2 -> p3
  p3 -> dots
  dots -> p200
}

bucketing: "Gradient Bucketing" {
  style.stroke: "#16a34a"
  style.bold: true

  direction: down
  b1: "Bucket 1\nparam 1–50 梯度拼接\n→ AR ① (一次 α)" {
    style.stroke: "#2563eb"
    style.stroke-width: 3
  }
  b2: "Bucket 2\nparam 51–100 梯度拼接\n→ AR ② (一次 α)" {
    style.stroke: "#2563eb"
    style.stroke-width: 3
  }
  b3: "Bucket 3\nparam 101–150 梯度拼接\n→ AR ③ (一次 α)" {
    style.stroke: "#2563eb"
    style.stroke-width: 3
  }
  b4: "Bucket 4\nparam 151–200 梯度拼接\n→ AR ④ (一次 α)" {
    style.stroke: "#2563eb"
    style.stroke-width: 3
  }

  b1 -> b2
  b2 -> b3
  b3 -> b4
}
