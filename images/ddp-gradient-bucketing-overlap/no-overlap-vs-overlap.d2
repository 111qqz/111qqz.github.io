grid-columns: 2

no_overlap: "无 Overlap（串行）" {
  style.stroke: "#dc2626"
  style.bold: true
  direction: down

  bwd: "Backward 计算\n0–80 ms" {
    style.stroke: "#2563eb"
    style.stroke-width: 3
  }
  ar_serial: "4 次 AR 依次执行\n80–95 / 95–110\n110–125 / 125–140 ms" {
    style.stroke: "#f59e0b"
    style.stroke-width: 3
  }
  total_no: "总耗时 140 ms\n通信 60 ms 全部暴露" {
    style.stroke: "#dc2626"
    style.bold: true
    style.stroke-width: 3
  }

  bwd -> ar_serial: "backward 结束\n才开始通信"
  ar_serial -> total_no
}

with_overlap: "有 Overlap（流水化）" {
  style.stroke: "#16a34a"
  style.bold: true
  direction: down

  hidden_ar: "Bucket 1–3 AR\n20–35 / 40–55 / 60–75 ms\n与 backward 并行（hidden）" {
    style.stroke: "#16a34a"
    style.stroke-width: 3
  }
  exposed_ar: "Bucket 4 AR\n80–95 ms\nbackward 已结束（exposed）" {
    style.stroke: "#f59e0b"
    style.stroke-width: 3
  }
  total_yes: "总耗时 95 ms\n隐藏 45 ms / 暴露 15 ms" {
    style.stroke: "#16a34a"
    style.bold: true
    style.stroke-width: 3
  }

  hidden_ar -> exposed_ar: "80 ms backward 结束"
  exposed_ar -> total_yes
}
