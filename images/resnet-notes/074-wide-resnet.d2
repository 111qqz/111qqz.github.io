direction: right

orig: "Original ResNet Block" {
  shape: package
  style.stroke: "#aaaaaa"
  Conv1: "Conv 3x3\n64 channels" { style.stroke: "#4a90e2" }
  Conv2: "Conv 3x3\n64 channels" { style.stroke: "#4a90e2" }
  Conv1 -> Conv2
}

wide: "Wide ResNet Block" {
  shape: package
  style.stroke: "#e24a4a"
  Conv1: "Conv 3x3\n64*k channels" { style.stroke: "#f5a623" }
  Conv2: "Conv 3x3\n64*k channels" { style.stroke: "#f5a623" }
  Conv1 -> Conv2
}

orig -> wide: "Increase width (k)\ninstead of depth"
