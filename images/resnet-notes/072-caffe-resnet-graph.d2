direction: down

pool1: { shape: cylinder; style: { stroke: "#aaaaaa"; bold: true } }

res2a_branch1: { shape: rectangle; label: "res2a_branch1\n(Conv 1x1)"; style: { stroke: "#4a90e2"; bold: true } }
res2a_branch2a: { shape: rectangle; label: "res2a_branch2a\n(Conv 1x1)"; style: { stroke: "#50e3c2"; bold: true } }
res2a_branch2b: { shape: rectangle; label: "res2a_branch2b\n(Conv 3x3)"; style: { stroke: "#50e3c2"; bold: true } }
res2a_branch2c: { shape: rectangle; label: "res2a_branch2c\n(Conv 1x1)"; style: { stroke: "#50e3c2"; bold: true } }

res2a: { shape: oval; label: "res2a\n(Eltwise +)"; style: { stroke: "#e24a4a"; bold: true } }

pool1 -> res2a_branch1
pool1 -> res2a_branch2a
res2a_branch2a -> res2a_branch2b
res2a_branch2b -> res2a_branch2c

res2a_branch1 -> res2a
res2a_branch2c -> res2a
