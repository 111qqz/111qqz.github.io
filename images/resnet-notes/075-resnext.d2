direction: down

Split: { shape: circle; label: "Split into C groups (Cardinality)"; style: { stroke: "#aaaaaa"; bold: true } }

Group 1: { shape: rectangle; label: "Conv branch 1"; style: { stroke: "#4a90e2" } }
Group 2: { shape: rectangle; label: "Conv branch 2"; style: { stroke: "#4a90e2" } }
Group 3: { shape: rectangle; label: "..."; style: { stroke: "#aaaaaa"; stroke-dash: 5 } }
Group C: { shape: rectangle; label: "Conv branch C"; style: { stroke: "#4a90e2" } }

Concat: { shape: circle; label: "Concat & Add"; style: { stroke: "#e24a4a"; bold: true } }

Split -> Group 1
Split -> Group 2
Split -> Group 3
Split -> Group C

Group 1 -> Concat
Group 2 -> Concat
Group 3 -> Concat
Group C -> Concat
