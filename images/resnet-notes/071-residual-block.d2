direction: down

x: { shape: circle; style: { stroke: "#aaaaaa"; bold: true } }

Weight layer 1: { shape: rectangle; style: { stroke: "#4a90e2"; bold: true } }
ReLU: { shape: oval; style: { stroke: "#f5a623"; bold: true } }
Weight layer 2: { shape: rectangle; style: { stroke: "#4a90e2"; bold: true } }

Plus: { shape: circle; label: "+"; style: { stroke: "#e24a4a"; bold: true } }
Output ReLU: { shape: oval; label: "ReLU"; style: { stroke: "#f5a623"; bold: true } }

x -> Weight layer 1
Weight layer 1 -> ReLU
ReLU -> Weight layer 2
Weight layer 2 -> Plus: "F(x)"

x -> Plus: "Identity (x)" { style: { stroke: "#e24a4a"; stroke-dash: 5 } }

Plus -> Output ReLU: "F(x) + x"
