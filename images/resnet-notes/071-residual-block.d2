direction: right

x: "x" { shape: circle; style.stroke: "#aaaaaa"; style.bold: true }

w1: "Weight\nlayer 1" { style.stroke: "#4a90e2"; style.bold: true }
relu1: "ReLU" { shape: oval; style.stroke: "#f5a623"; style.bold: true }
w2: "Weight\nlayer 2" { style.stroke: "#4a90e2"; style.bold: true }
Plus: "+" { shape: circle; style.stroke: "#e24a4a"; style.bold: true }
OutReLU: "ReLU" { shape: oval; style.stroke: "#f5a623"; style.bold: true }

x -> w1
w1 -> relu1 -> w2
w2 -> Plus: "F(x)"
x -> Plus: "Identity (x)" { style.stroke: "#e24a4a"; style.stroke-dash: 5 }
Plus -> OutReLU: "F(x) + x"
