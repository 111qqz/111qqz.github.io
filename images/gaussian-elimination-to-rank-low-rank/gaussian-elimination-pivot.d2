grid-columns: 2

step1: "原始矩阵 A" {
  style.stroke: "#2563eb"
  style.bold: true
  style.stroke-width: 3

  r1a: "⟨1⟩  2   3" { style.stroke: "#f59e0b"; style.bold: true }
  r2a: " 2   5   8" { style.stroke: "#6b7280" }
  r3a: " 3   7  11" { style.stroke: "#6b7280" }
  note_a: "r₃ = r₁ + r₂\n（第 3 行是冗余的）" {
    style.stroke: "#dc2626"
    style.stroke-dash: 4
  }

  r1a -> r2a -> r3a: "" { style.stroke: "#e5e7eb" }
  r3a -> note_a: "" { style.stroke: "#dc2626"; style.stroke-dash: 4 }
}

step2: "行阶梯形 U（消元后）" {
  style.stroke: "#16a34a"
  style.bold: true
  style.stroke-width: 3

  r1b: "⟨1⟩  2   3  ← Pivot 1" { style.stroke: "#f59e0b"; style.bold: true }
  r2b: " 0  ⟨1⟩  2  ← Pivot 2" { style.stroke: "#f59e0b"; style.bold: true }
  r3b: " 0   0   0  ← 零行" { style.stroke: "#dc2626"; style.stroke-dash: 4 }
  note_b: "2 个 Pivot\n→ rank(A) = 2" {
    style.stroke: "#16a34a"
    style.bold: true
  }

  r1b -> r2b -> r3b: "" { style.stroke: "#e5e7eb" }
  r3b -> note_b: "" { style.stroke: "#16a34a" }
}

step1 -> step2: "可逆行变换\nR₂ ← R₂ − 2R₁\nR₃ ← R₃ − 3R₁\nR₃ ← R₃ − R₂" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
}
