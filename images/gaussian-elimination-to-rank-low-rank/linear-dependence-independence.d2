grid-columns: 2

dependent: "线性相关 → Rank = 1" {
  style.stroke: "#dc2626"
  style.bold: true
  style.stroke-width: 3

  v1_dep: "v₁ = (1, 2)" {
    style.stroke: "#2563eb"
    style.bold: true
  }
  v2_dep: "v₂ = (2, 4)" {
    style.stroke: "#2563eb"
  }
  relation_dep: "v₂ = 2 × v₁\n方向完全相同\n第二个向量是冗余的" {
    style.stroke: "#dc2626"
    style.stroke-dash: 4
  }
  span_dep: "Span:\n只覆盖一条直线" {
    style.stroke: "#6b7280"
    style.stroke-dash: 4
  }

  v1_dep -> v2_dep: "×2 放大" {
    style.stroke: "#2563eb"
    style.stroke-width: 2
  }
  v2_dep -> relation_dep: "" {
    style.stroke: "#dc2626"
    style.stroke-dash: 4
  }
  relation_dep -> span_dep: "" {
    style.stroke: "#6b7280"
    style.stroke-dash: 4
  }
}

independent: "线性无关 → Rank = 2" {
  style.stroke: "#16a34a"
  style.bold: true
  style.stroke-width: 3

  u1_ind: "u₁ = (1, 0)" {
    style.stroke: "#2563eb"
    style.bold: true
  }
  u2_ind: "u₂ = (0, 1)" {
    style.stroke: "#16a34a"
    style.bold: true
  }
  relation_ind: "u₂ 不能写成 u₁ 的倍数\n两个方向互相独立" {
    style.stroke: "#16a34a"
    style.stroke-dash: 4
  }
  span_ind: "Span:\n覆盖整个二维平面" {
    style.stroke: "#6b7280"
    style.stroke-dash: 4
  }

  u1_ind -> u2_ind: "不同方向" {
    style.stroke: "#16a34a"
    style.stroke-width: 2
  }
  u2_ind -> relation_ind: "" {
    style.stroke: "#16a34a"
    style.stroke-dash: 4
  }
  relation_ind -> span_ind: "" {
    style.stroke: "#6b7280"
    style.stroke-dash: 4
  }
}
