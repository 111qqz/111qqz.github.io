grid-columns: 3

big_w: "W\nm × n 矩阵\n参数: m·n" {
  style.stroke: "#dc2626"
  style.bold: true
  style.stroke-width: 3
}

small_b: "B\nm × r 矩阵" {
  style.stroke: "#2563eb"
  style.bold: true
  style.stroke-width: 3
}

small_a: "A\nr × n 矩阵" {
  style.stroke: "#16a34a"
  style.bold: true
  style.stroke-width: 3
}

big_w -> small_b: "= B × A\n当 rank(W) = r" {
  style.stroke: "#f59e0b"
  style.stroke-width: 2
  style.bold: true
}
small_b -> small_a: "中间维度 r\n≪ min(m, n)" {
  style.stroke: "#f59e0b"
  style.stroke-width: 2
}

example: "例: W ∈ ℝ⁴⁰⁹⁶ˣ⁴⁰⁹⁶,  r = 8\n原始 16,777,216 参数\n→ B + A 只需 65,536 参数（1/256）" {
  style.stroke: "#f59e0b"
  style.bold: true
  style.stroke-width: 2
}

small_a -> example: "" {
  style.stroke: "#f59e0b"
  style.stroke-dash: 4
}
