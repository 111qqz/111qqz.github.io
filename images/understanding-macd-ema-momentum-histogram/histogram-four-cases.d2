grid-columns: 2

case1: "正柱变长\nH > 0，ΔH > 0\n\nDIF 加速远离 DEA（向上）\n上行动能在增强" {
  style.stroke: "#dc2626"
  style.bold: true
  style.stroke-width: 3
}

case2: "正柱缩短\nH > 0，ΔH < 0\n\nDIF 还在 DEA 上方\n但缺口正在收窄\n上行动能在减弱" {
  style.stroke: "#f59e0b"
  style.bold: true
  style.stroke-width: 3
}

case3: "负柱变长\nH < 0，ΔH < 0\n\nDIF 加速远离 DEA（向下）\n下行动能在增强" {
  style.stroke: "#16a34a"
  style.bold: true
  style.stroke-width: 3
}

case4: "负柱缩短\nH < 0，ΔH > 0\n\nDIF 还在 DEA 下方\n但缺口正在收窄\n下行动能在减弱" {
  style.stroke: "#2563eb"
  style.bold: true
  style.stroke-width: 3
}
