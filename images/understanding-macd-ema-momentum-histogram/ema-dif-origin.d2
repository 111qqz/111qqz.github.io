direction: right

price: "收盘价 P_t" {
  style.stroke: "#7c3aed"
  style.bold: true
  style.stroke-width: 3
}

ema12: "EMA₁₂（快线）\nα ≈ 0.154\n对近期价格更敏感" {
  style.stroke: "#2563eb"
  style.bold: true
}

ema26: "EMA₂₆（慢线）\nα ≈ 0.074\n对近期价格更迟钝" {
  style.stroke: "#16a34a"
  style.bold: true
}

dif: "DIF = EMA₁₂ − EMA₂₆\n两条均线的有符号差值" {
  style.stroke: "#dc2626"
  style.bold: true
  style.stroke-width: 3
}

price -> ema12: "短周期平滑"
price -> ema26: "长周期平滑"
ema12 -> dif
ema26 -> dif
