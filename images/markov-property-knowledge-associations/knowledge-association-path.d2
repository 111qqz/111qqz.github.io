direction: right

bellman: "学习\nBellman Equation" {
  style.bold: true
}

markov: "遇到\nMarkov Property" {
  style.bold: true
  style.stroke-width: 3
}

bellman -> markov: "学习过程中"

branch: "" {
  grid-columns: 2
  label: ""

  dp_aftereffect: "DP 无后效性\n（算法竞赛）" {
    style.stroke: "#2563eb"
    style.bold: true
  }

  hmm_chain: "" {
    label: ""

    hmm_node: "Hidden Markov Model\n（推荐系统）" {
      style.stroke: "#16a34a"
      style.bold: true
    }

    hidden_state: "Hidden State" {
      style.stroke: "#16a34a"
    }

    vae_latent: "VAE 的 Latent Variable" {
      style.stroke: "#f59e0b"
      style.bold: true
    }

    hmm_node -> hidden_state: "核心结构" {
      style.stroke: "#16a34a"
    }

    hidden_state -> vae_latent: "潜变量思想联系" {
      style.stroke: "#f59e0b"
      style.stroke-dash: 4
    }
  }
}

markov -> branch.dp_aftereffect: "数学思想相通" {
  style.stroke: "#2563eb"
}

markov -> branch.hmm_chain.hmm_node: "术语联想" {
  style.stroke: "#16a34a"
}
