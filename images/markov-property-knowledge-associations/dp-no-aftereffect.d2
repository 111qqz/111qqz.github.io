direction: right

path_a: "路径 A：经过钥匙房间" {
  style.stroke: "#2563eb"
  style.bold: true

  start_a: "起点" { shape: circle }
  key_room: "钥匙房间\n（拾取钥匙）"
  door_a: "门前\nState = (门前, 有钥匙)" {
    style.stroke: "#16a34a"
    style.bold: true
  }
  result_a: "可以开门\n→ 通过" {
    style.stroke: "#16a34a"
  }

  start_a -> key_room -> door_a -> result_a
}

path_b: "路径 B：直接到达" {
  style.stroke: "#dc2626"
  style.bold: true

  start_b: "起点" { shape: circle }
  corridor: "走廊\n（无钥匙）"
  door_b: "门前\nState = (门前, 无钥匙)" {
    style.stroke: "#dc2626"
    style.bold: true
  }
  result_b: "无法开门\n→ 卡住" {
    style.stroke: "#dc2626"
  }

  start_b -> corridor -> door_b -> result_b
}
