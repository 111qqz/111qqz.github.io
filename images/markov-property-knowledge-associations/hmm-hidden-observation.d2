direction: right

z1: "Z₁" { shape: circle; style.stroke: "#2563eb"; style.bold: true }
z2: "Z₂" { shape: circle; style.stroke: "#2563eb"; style.bold: true }
z3: "Z₃" { shape: circle; style.stroke: "#2563eb"; style.bold: true }
z4: "Z₄" { shape: circle; style.stroke: "#2563eb"; style.bold: true }

o1: "O₁" { shape: diamond; style.stroke: "#16a34a" }
o2: "O₂" { shape: diamond; style.stroke: "#16a34a" }
o3: "O₃" { shape: diamond; style.stroke: "#16a34a" }
o4: "O₄" { shape: diamond; style.stroke: "#16a34a" }

z1 -> z2: "Transition" { style.stroke: "#2563eb" }
z2 -> z3: "" { style.stroke: "#2563eb" }
z3 -> z4: "" { style.stroke: "#2563eb" }

z1 -> o1: "Emission" { style.stroke: "#16a34a"; style.stroke-dash: 4 }
z2 -> o2: "" { style.stroke: "#16a34a"; style.stroke-dash: 4 }
z3 -> o3: "" { style.stroke: "#16a34a"; style.stroke-dash: 4 }
z4 -> o4: "" { style.stroke: "#16a34a"; style.stroke-dash: 4 }
