direction: right

tech: "科技" {
  style.bold: true
  style.stroke: "#2563eb"
  style.stroke-width: 3
}
sports: "体育" {
  style.stroke: "#16a34a"
  style.stroke-width: 3
}
entertainment: "娱乐" {
  style.stroke: "#f59e0b"
  style.stroke-width: 3
}

tech -> tech: "0.80" {
  style.stroke: "#2563eb"
}
tech -> sports: "0.15" {
  style.stroke: "#2563eb"
}
tech -> entertainment: "0.05" {
  style.stroke: "#2563eb"
}

sports -> sports: "0.60" {
  style.stroke: "#16a34a"
}
sports -> tech: "0.20" {
  style.stroke: "#16a34a"
}
sports -> entertainment: "0.20" {
  style.stroke: "#16a34a"
}

entertainment -> entertainment: "0.50" {
  style.stroke: "#f59e0b"
}
entertainment -> tech: "0.30" {
  style.stroke: "#f59e0b"
}
entertainment -> sports: "0.20" {
  style.stroke: "#f59e0b"
}
