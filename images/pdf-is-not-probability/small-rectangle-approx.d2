direction: right

rectangle: "Small Rectangle Approximation" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
  style.bold: true
  label: ""

  direction: right

  dims: {
    label: ""
    direction: down

    h_label: "height = f(x)" {
      style.stroke: "#2563eb"
      style.stroke-width: 2
      style.bold: true
    }
    w_label: "width = delta-x" {
      style.stroke: "#dc2626"
      style.stroke-width: 2
      style.bold: true
    }
    a_label: "area = f(x) x delta-x" {
      style.stroke: "#16a34a"
      style.stroke-width: 3
      style.bold: true
    }

    h_label -> w_label -> a_label
  }

  example: {
    label: ""
    direction: down

    val: "f(175) = 0.08/cm" {style.stroke: "#2563eb"; style.stroke-width: 2}
    dx: "delta-x = 0.1 cm" {style.stroke: "#dc2626"; style.stroke-width: 2}
    prob: "P = 0.08 x 0.1 = 0.008\n(about 0.8%)" {
      style.stroke: "#16a34a"
      style.stroke-width: 3
      style.bold: true
    }

    val -> dx -> prob
  }
}
