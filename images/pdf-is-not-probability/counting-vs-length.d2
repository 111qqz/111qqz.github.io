direction: down

numberline: "Number Line [0, 10]" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
  style.bold: true
  label: ""

  direction: right

  seg1: "[0, 2)" {style.stroke: "#2563eb"; style.stroke-width: 2}
  seg2: "[2, 5]" {style.stroke: "#dc2626"; style.stroke-width: 3; style.bold: true}
  seg3: "(5, 10]" {style.stroke: "#2563eb"; style.stroke-width: 2}

  seg1 -> seg2: {style.stroke: "#dc2626"}
  seg2 -> seg3: {style.stroke: "#dc2626"}
}

both: "Both intervals contain\nuncountably many points" {
  style.stroke: "#f59e0b"
  style.stroke-width: 2
  style.bold: true
}

numberline -> both

wrong: "Wrong approach" {
  style.stroke: "#dc2626"
  style.stroke-width: 2
  style.bold: true

  label: "points in [2,5]\n-----------------\npoints in [0,10]\n\n= uncountable / uncountable = ???"
}

right_way: "Correct approach" {
  style.stroke: "#16a34a"
  style.stroke-width: 2
  style.bold: true

  label: "length([2,5])     3\n------------- = ---- = 0.3\nlength([0,10])    10"
}

both -> wrong: {style.stroke: "#dc2626"; style.stroke-dash: 3}
both -> right_way: {style.stroke: "#16a34a"; style.stroke-width: 2}
