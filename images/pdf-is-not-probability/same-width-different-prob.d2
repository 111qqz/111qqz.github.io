direction: down

compare: "Two Intervals, Same Width = 1 cm" {
  style.stroke: "#f59e0b"
  style.stroke-width: 2
  style.bold: true

  grid-columns: 2

  interval1: "[174, 175] cm\nhigh density region\nlarge area under curve\nhigh probability" {
    style.stroke: "#dc2626"
    style.stroke-width: 3
    style.bold: true
  }

  interval2: "[210, 211] cm\nlow density region\ntiny area under curve\nlow probability" {
    style.stroke: "#2563eb"
    style.stroke-width: 2
  }
}

compare -> conclusion

conclusion: "Same interval length, different probability\nNeed f(x) to describe how dense probability is at each x" {
  style.stroke: "#16a34a"
  style.stroke-width: 3
  style.bold: true
}
