direction: right

pop: "Population" {
  style.stroke: "#2563eb"
  style.stroke-width: 3
  style.bold: true

  direction: down

  density: "density\npeople / km^2" {style.stroke: "#2563eb"; style.stroke-width: 2}
  times: "x" {style.stroke: "#2563eb"; style.stroke-width: 2}
  region: "area (km^2)" {style.stroke: "#2563eb"; style.stroke-width: 2}
  eq: "=" {style.stroke: "#2563eb"; style.stroke-width: 2}
  total: "people" {style.stroke: "#2563eb"; style.stroke-width: 2; style.bold: true}

  density -> times -> region -> eq -> total
}

mass: "Mass" {
  style.stroke: "#16a34a"
  style.stroke-width: 3
  style.bold: true

  direction: down

  density: "density\nkg / m" {style.stroke: "#16a34a"; style.stroke-width: 2}
  times: "x" {style.stroke: "#16a34a"; style.stroke-width: 2}
  region: "length (m)" {style.stroke: "#16a34a"; style.stroke-width: 2}
  eq: "=" {style.stroke: "#16a34a"; style.stroke-width: 2}
  total: "kg" {style.stroke: "#16a34a"; style.stroke-width: 2; style.bold: true}

  density -> times -> region -> eq -> total
}

prob: "Probability" {
  style.stroke: "#dc2626"
  style.stroke-width: 3
  style.bold: true

  direction: down

  density: "density\n1 / cm" {style.stroke: "#dc2626"; style.stroke-width: 2}
  times: "x" {style.stroke: "#dc2626"; style.stroke-width: 2}
  region: "length (cm)" {style.stroke: "#dc2626"; style.stroke-width: 2}
  eq: "=" {style.stroke: "#dc2626"; style.stroke-width: 2}
  total: "probability\n(dimensionless)" {style.stroke: "#dc2626"; style.stroke-width: 2; style.bold: true}

  density -> times -> region -> eq -> total
}

common: "Density is a local rate\nnot a total quantity" {
  style.stroke: "#f59e0b"
  style.stroke-width: 3
  style.bold: true
}

pop -> common: {style.stroke: "#f59e0b"; style.stroke-dash: 3}
mass -> common: {style.stroke: "#f59e0b"; style.stroke-dash: 3}
prob -> common: {style.stroke: "#f59e0b"; style.stroke-dash: 3}
