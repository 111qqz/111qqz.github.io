grid-columns: 3

pop: "1. 人口密度 (Population Density)" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
  direction: down

  rate1: "局部比率 (Local Rate):\nρ = 人口 / 面积 (单位: 人 / km²)\n描述某区域的人口密集程度" {
    style.stroke: "#2563eb"
    style.bold: true
  }

  meas1: "空间测度 (Spatial Measure):\n二维地理区域面积 A (单位: km²)" {
    style.stroke: "#2563eb"
  }

  total1: "宏观物理总量 (Total Quantity):\n总人口 N = ∬ ρ dA (单位: 人)\n密度乘面积才产生人数" {
    style.stroke: "#16a34a"
    style.stroke-width: 2
    style.bold: true
  }

  rate1 -> meas1 -> total1
}

mass: "2. 质量线密度 (Mass Linear Density)" {
  style.stroke: "#f59e0b"
  style.stroke-width: 2
  direction: down

  rate2: "局部比率 (Local Rate):\nλ = 质量 / 长度 (单位: kg / m)\n描述细杆局部的质量分布" {
    style.stroke: "#f59e0b"
    style.bold: true
  }

  meas2: "空间测度 (Spatial Measure):\n一维物体物理长度 L (单位: m)" {
    style.stroke: "#f59e0b"
  }

  total2: "宏观物理总量 (Total Quantity):\n总质量 M = ∫ λ dx (单位: kg)\n密度乘长度才产生质量" {
    style.stroke: "#16a34a"
    style.stroke-width: 2
    style.bold: true
  }

  rate2 -> meas2 -> total2
}

prob: "3. 概率密度 (Probability Density, PDF)" {
  style.stroke: "#dc2626"
  style.stroke-width: 3
  style.bold: true
  direction: down

  rate3: "局部比率 (Local Rate):\nf(x) = 概率 / 长度 (单位: 1 / cm)\n描述点 x 附近的概率稠密程度" {
    style.stroke: "#dc2626"
    style.bold: true
  }

  meas3: "空间测度 (Spatial Measure):\n连续实数区间长度 Δx (单位: cm)" {
    style.stroke: "#dc2626"
  }

  total3: "宏观概率总量 (Total Measure):\n总概率 P = ∫ f(x) dx (无量纲纯数值)\n密度对区间做面积积分才产生概率" {
    style.stroke: "#16a34a"
    style.stroke-width: 3
    style.bold: true
  }

  rate3 -> meas3 -> total3
}
