direction: down

curve_side: "Density Curve on [174.5, 175.5]" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
  style.bold: true

  grid-columns: 2

  above: "Some parts of f(x)\nare above the average" {style.stroke: "#dc2626"; style.stroke-width: 2}
  below: "Some parts of f(x)\nare below the average" {style.stroke: "#f59e0b"; style.stroke-width: 2}
}

curve_side -> rect_side: "area under curve = area of rectangle" {style.stroke: "#dc2626"; style.bold: true}

rect_side: "Average Density Rectangle" {
  style.stroke: "#16a34a"
  style.stroke-width: 3
  style.bold: true

  grid-columns: 2

  rect: "Flat rectangle\nheight = 0.079/cm\nwidth = 1 cm" {style.stroke: "#16a34a"; style.stroke-width: 2}
  area: "area = 0.079\n= interval\nprobability" {style.stroke: "#16a34a"; style.stroke-width: 3; style.bold: true}
}
