direction: down

discrete: "Discrete: Fair Die" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
  style.bold: true

  grid-columns: 3

  d1: "x=1  P=1/6" {style.stroke: "#2563eb"; style.stroke-width: 2; style.bold: true}
  d2: "x=2  P=1/6" {style.stroke: "#2563eb"; style.stroke-width: 2}
  d3: "x=3  P=1/6" {style.stroke: "#2563eb"; style.stroke-width: 2}
  d4: "x=4  P=1/6" {style.stroke: "#2563eb"; style.stroke-width: 2}
  d5: "x=5  P=1/6" {style.stroke: "#2563eb"; style.stroke-width: 2}
  d6: "x=6  P=1/6" {style.stroke: "#2563eb"; style.stroke-width: 2}
}

discrete -> continuous: "vs" {style.stroke: "#f59e0b"; style.bold: true}

continuous: "Continuous: U(0,1)" {
  style.stroke: "#dc2626"
  style.stroke-width: 2
  style.bold: true

  grid-columns: 2

  fact1: "P(X = x) = 0\nfor every single x" {style.stroke: "#f59e0b"; style.stroke-width: 2; style.bold: true}
  question: "P(0 <= X <= 1) = 1\nWhere does probability live?" {style.stroke: "#dc2626"; style.stroke-width: 3; style.bold: true}
}
