grid-columns: 2

discrete: "离散概率模型 (Discrete Probability Mass)" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
  style.bold: true
  direction: down

  sample_d: "样本空间: 离散孤立点集\nX ∈ {1, 2, 3, 4, 5, 6} (有限或可数无限)" {
    style.stroke: "#2563eb"
  }

  prob_d: "单点概率: 直接定义非零质量\nP(X = x_i) = p_i > 0 (如掷骰子单点 1/6)" {
    style.stroke: "#2563eb"
    style.stroke-width: 2
    style.bold: true
  }

  calc_d: "总概率求解: 离散直接求和\n∑ P(X = x_i) = 1\n概率直接挂载在具体的「点」上" {
    style.stroke: "#16a34a"
    style.stroke-width: 2
    style.bold: true
  }

  sample_d -> prob_d: "点对应质量"
  prob_d -> calc_d: "离散累加"
}

continuous: "连续概率模型 (Continuous Probability Density)" {
  style.stroke: "#16a34a"
  style.stroke-width: 3
  style.bold: true
  direction: down

  sample_c: "样本空间: 不可数连续连续统\nX ∈ [a, b] ⊂ ℝ (区间内包含不可数无穷个点)" {
    style.stroke: "#16a34a"
  }

  prob_c: "单点概率: 任意单点概率恒为零\nP(X = x) = 0 (不可数点集无法分配有限正质量)" {
    style.stroke: "#dc2626"
    style.stroke-width: 2
    style.bold: true
  }

  calc_c: "总概率求解: 连续区间面积积分\nP(X ∈ [a,b]) = ∫ f(x) dx = 1\n概率是曲线下方具有宽度的「面积」，而非单点高度" {
    style.stroke: "#16a34a"
    style.stroke-width: 3
    style.bold: true
  }

  sample_c -> prob_c: "连续统不可切分"
  prob_c -> calc_c: "转向区间积分"
}
