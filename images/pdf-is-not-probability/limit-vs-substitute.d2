direction: down

approach: "h -> 0 (limit)" {
  style.stroke: "#16a34a"
  style.stroke-width: 3
  style.bold: true

  grid-columns: 2

  v1: "h = 1, 0.1, 0.01, 0.001, ...\ngets smaller and smaller" {style.stroke: "#2563eb"; style.stroke-width: 2}
  v2: "Approaches 0\nbut never equals 0\nwe study the trend" {style.stroke: "#16a34a"; style.stroke-width: 3; style.bold: true}
}

approach -> substitute: "NOT the same operation" {style.stroke: "#dc2626"; style.stroke-width: 3; style.bold: true; style.stroke-dash: 5}

substitute: "h = 0 (direct substitution)" {
  style.stroke: "#dc2626"
  style.stroke-width: 3
  style.bold: true

  grid-columns: 2

  direct: "Immediately set h = 0\nNo process, no trend" {style.stroke: "#dc2626"; style.stroke-width: 2}
  problem: "Interval vanishes completely\nNothing left to measure\nOften produces 0/0" {style.stroke: "#dc2626"; style.stroke-width: 2; style.bold: true}
}
