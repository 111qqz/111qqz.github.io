direction: down

progression: "" {
  label: ""
  grid-columns: 3

  s1: "Step 1\n\n4 wide bars\nrough approximation\nlarge gaps between\ncurve and bars" {
    style.stroke: "#2563eb"
    style.stroke-width: 2
    style.bold: true
  }

  s2: "Step 2\n\n10 narrow bars\nbetter approximation\nsmaller gaps\ncloser to curve" {
    style.stroke: "#f59e0b"
    style.stroke-width: 2
    style.bold: true
  }

  s3: "Step 3\n\ninfinitely thin bars\nperfect fit to curve\nintegral f(x) dx\n= exact area" {
    style.stroke: "#16a34a"
    style.stroke-width: 3
    style.bold: true
  }
}

progression -> conclusion

conclusion: "Sum f(xi) delta-x    ---->    integral f(x) dx = exact area = probability" {
  style.stroke: "#16a34a"
  style.stroke-width: 3
  style.bold: true
}
