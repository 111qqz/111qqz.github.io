direction: down

curve: "At Point x on the Density Curve" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
  style.bold: true

  direction: right

  h_val: "height = f(x) > 0" {style.stroke: "#2563eb"; style.stroke-width: 3; style.bold: true}
  w_val: "width = 0\n(single point)" {style.stroke: "#dc2626"; style.stroke-width: 3; style.bold: true}
  a_val: "area = 0" {style.stroke: "#dc2626"; style.stroke-width: 3; style.bold: true}

  h_val -> w_val -> a_val
}

curve -> conclusion

conclusion: "P(X = x) = 0\nPositive density does NOT mean positive probability" {
  style.stroke: "#16a34a"
  style.stroke-width: 3
  style.bold: true
}
