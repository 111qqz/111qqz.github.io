direction: down

window: "Sliding Window Around x" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
  style.bold: true

  grid-columns: 2

  interval: "Take interval\n[x - h/2, x + h/2]\nwidth = h" {style.stroke: "#2563eb"; style.stroke-width: 2}
  ratio: "Compute ratio:\nP(interval) / h\n= average density" {style.stroke: "#f59e0b"; style.stroke-width: 2; style.bold: true}
}

window -> result: "Shrink h -> 0, average density converges to..." {style.stroke: "#dc2626"; style.stroke-width: 2; style.bold: true}

result: "f(x) = local probability density  (NOT the same as P(X = x))" {
  style.stroke: "#16a34a"
  style.stroke-width: 3
  style.bold: true
}
