direction: right

chart: "U(0, 10): Probability = Area" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
  style.bold: true
  label: ""

  direction: right

  axis: {
    label: ""
    direction: right

    full: "Density = 0.1\n(height of rectangle)\n\n0 ========================== 10\n         full width = 10" {
      style.stroke: "#2563eb"
      style.stroke-width: 2
    }

    shaded: "[2, 5] shaded\nwidth = 3" {
      style.stroke: "#dc2626"
      style.stroke-width: 3
      style.bold: true
    }
  }

  calc: {
    label: ""
    direction: down

    h: "height = 0.1" {style.stroke: "#2563eb"; style.stroke-width: 2}
    w: "width = 3" {style.stroke: "#dc2626"; style.stroke-width: 2}
    a: "area = 0.1 x 3 = 0.3" {style.stroke: "#16a34a"; style.stroke-width: 3; style.bold: true}
    eq: "Probability = Area" {style.stroke: "#16a34a"; style.stroke-width: 3; style.bold: true}

    h -> w -> a -> eq
  }
}
