direction: down

rect: "U(0, 0.5)" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
  style.bold: true

  direction: right

  h_val: "f(x) = 2\n(density > 1)" {style.stroke: "#dc2626"; style.stroke-width: 3; style.bold: true}
  w_val: "width = 0.5" {style.stroke: "#2563eb"; style.stroke-width: 2}
  a_val: "area = 2 x 0.5 = 1" {style.stroke: "#16a34a"; style.stroke-width: 3; style.bold: true}

  h_val -> w_val -> a_val
}

rect -> key

key: "density > 1 does NOT mean probability > 1\ndensity has unit (1/length), probability is dimensionless" {
  style.stroke: "#dc2626"
  style.stroke-width: 3
  style.bold: true
}
