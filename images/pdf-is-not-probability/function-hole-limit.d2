direction: down

func: "g(x) = (x^2 - 1)/(x - 1)" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
  style.bold: true

  grid-columns: 2

  line: "For x != 1:\ng(x) = x + 1\n(straight line)" {style.stroke: "#2563eb"; style.stroke-width: 2}
  hole: "At x = 1:\n0/0 undefined\n(open circle on graph)" {style.stroke: "#dc2626"; style.stroke-width: 3; style.bold: true}
}

func -> limit_box: "but near x = 1..." {style.stroke: "#dc2626"; style.bold: true}

limit_box: "Limit Exists Despite the Hole" {
  style.stroke: "#16a34a"
  style.stroke-width: 3
  style.bold: true

  grid-columns: 2

  nearby: "g(0.99) = 1.99\ng(0.999) = 1.999\ng(1.001) = 2.001" {style.stroke: "#f59e0b"; style.stroke-width: 2}
  result: "lim g(x) = 2\nas x -> 1\n\nLimit cares about\nnearby, not the point" {style.stroke: "#16a34a"; style.stroke-width: 3; style.bold: true}
}
