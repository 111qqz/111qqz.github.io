direction: down

RCNN: {
  shape: package
  label: "R-CNN"
  style: { stroke: "#aaaaaa" }
  "Selective Search" -> "Crop / Warp" -> "CNN per RoI" -> "SVM & BBox Reg"
}

FastRCNN: {
  shape: package
  label: "Fast R-CNN"
  style: { stroke: "#aaaaaa" }
  "Image" -> "CNN" -> "Feature Map"
  "Selective Search" -> "RoI Pooling"
  "Feature Map" -> "RoI Pooling"
  "RoI Pooling" -> "FC Layers" -> "Softmax & BBox Reg"
}

FasterRCNN: {
  shape: package
  label: "Faster R-CNN"
  style: { stroke: "#4a90e2"; bold: true }
  "Image " -> "CNN " -> "Feature Map "
  "Feature Map " -> "RPN"
  "RPN" -> "Proposals"
  "Feature Map " -> "RoI Pooling "
  "Proposals" -> "RoI Pooling "
  "RoI Pooling " -> "FC Layers " -> "Softmax & BBox Reg "
}

RCNN -> FastRCNN -> FasterRCNN { style: { stroke: transparent } }
