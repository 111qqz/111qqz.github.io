direction: down

FeatureMap: { shape: document; label: "Conv Feature Map"; style: { stroke: "#aaaaaa"; bold: true } }

SlidingWindow: { shape: rectangle; label: "3x3 Conv\n(Sliding Window)"; style: { stroke: "#f5a623"; bold: true } }

Intermediate: { shape: document; label: "256-d vector"; style: { stroke: "#aaaaaa" } }

ClsLayer: { shape: rectangle; label: "cls layer (1x1 conv)\n2k scores"; style: { stroke: "#4a90e2"; bold: true } }
RegLayer: { shape: rectangle; label: "reg layer (1x1 conv)\n4k coordinates"; style: { stroke: "#50e3c2"; bold: true } }

FeatureMap -> SlidingWindow
SlidingWindow -> Intermediate
Intermediate -> ClsLayer
Intermediate -> RegLayer
