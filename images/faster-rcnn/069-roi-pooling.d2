direction: right

InputFeature: {
  shape: step
  label: "任意大小 RoI\n(h × w)"
}

Projection: {
  shape: rectangle
  label: "映射到 Feature Map"
}

GridDivision: {
  shape: rectangle
  label: "划分为 H × W 个网格\n(如 7 × 7)"
}

MaxPool: {
  shape: rectangle
  label: "网格内做 Max-Pooling"
}

FixedVector: {
  shape: step
  label: "固定尺寸输出\n(7 × 7 × C)"
}

InputFeature -> Projection -> GridDivision -> MaxPool -> FixedVector
