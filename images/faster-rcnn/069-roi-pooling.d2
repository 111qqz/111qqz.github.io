direction: right

InputFeature: {
  shape: step
  label: "Input Feature Map (e.g., 8x8)\nwith Proposal (e.g., 7x5)"
  style: { stroke: "#aaaaaa"; bold: true }
}

Divide: {
  shape: rectangle
  label: "Divide proposal into target grid\n(e.g., 2x2 cells)\nFloor/Ceil for irregular splits"
  style: { stroke: "#f5a623"; bold: true }
}

MaxPool: {
  shape: rectangle
  label: "Max Pool inside each cell"
  style: { stroke: "#4a90e2"; bold: true }
}

Output: {
  shape: document
  label: "Fixed-size Output\n(e.g., 2x2)"
  style: { stroke: "#50e3c2"; bold: true }
}

InputFeature -> Divide -> MaxPool -> Output
