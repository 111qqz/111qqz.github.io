grid-columns: 2

v_panel: "V^π(s)：State Value" {
  style.bold: true
  style.stroke: "#2563eb"
  style.stroke-width: 3

  s_v: "当前 State s" {
    style.bold: true
  }
  choose: "按 π 选择 Action" {
    style.stroke: "#f59e0b"
    style.bold: true
    style.stroke-width: 3
  }
  next_v: "下一 State s'"
  continue_v: "继续按 π 行动"
  future_v: "期望 Return"

  s_v -> choose
  choose -> next_v
  next_v -> continue_v
  continue_v -> future_v
}

q_panel: "Q^π(s, a)：Action Value" {
  style.bold: true
  style.stroke: "#dc2626"
  style.stroke-width: 3

  s_q: "当前 State s" {
    style.bold: true
  }
  fix: "Action 固定为 a" {
    style.stroke: "#dc2626"
    style.bold: true
    style.stroke-width: 3
  }
  next_q: "下一 State s'"
  continue_q: "继续按 π 行动"
  future_q: "期望 Return"

  s_q -> fix
  fix -> next_q
  next_q -> continue_q
  continue_q -> future_q
}
