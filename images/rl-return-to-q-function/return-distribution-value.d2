grid-columns: 2

case1: "情况 1：A 更好" {
  style.bold: true

  qa: "Q(S, A) = 3.6" {
    style.stroke: "#2563eb"
    style.bold: true
    style.stroke-width: 3
  }
  qb: "Q(S, B) = 2.9" {
    style.stroke: "#2563eb"
  }
  val: "V = 0.25 × 3.6 + 0.75 × 2.9\n= 3.075" {
    style.stroke: "#16a34a"
    style.bold: true
    style.stroke-width: 3
  }

  qa -> val: "π(A) = 0.25"
  qb -> val: "π(B) = 0.75"
}

case2: "情况 2：B 更好" {
  style.bold: true

  qa2: "Q(S, A) = 0.6" {
    style.stroke: "#dc2626"
  }
  qb2: "Q(S, B) = 3.9" {
    style.stroke: "#dc2626"
    style.bold: true
    style.stroke-width: 3
  }
  val2: "V = 0.25 × 0.6 + 0.75 × 3.9\n= 3.075" {
    style.stroke: "#16a34a"
    style.bold: true
    style.stroke-width: 3
  }

  qa2 -> val2: "π(A) = 0.25"
  qb2 -> val2: "π(B) = 0.75"
}
