direction: down

pi: "Policy π" {
  style.bold: true
  style.stroke-width: 3
}
eval_q: "评估 Q^π 或 V^π" {
  style.stroke: "#2563eb"
  style.bold: true
}
improve_pi: "改进 Policy → 新的 π" {
  style.stroke: "#16a34a"
  style.bold: true
  style.stroke-width: 3
}

pi -> eval_q: "Policy Evaluation"
eval_q -> improve_pi: "根据 Q 值选更好的 Action"
improve_pi -> pi: "Policy Improvement（重复迭代）" {
  style.stroke-dash: 4
  style.stroke: "#f59e0b"
}
