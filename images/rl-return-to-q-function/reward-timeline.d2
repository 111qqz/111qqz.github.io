grid-columns: 2

trajectory: "三步游戏轨迹" {
  style.bold: true
  style.stroke: "#2563eb"
  style.stroke-width: 3

  s0: "S₀"
  s1: "S₁"
  s2: "S₂"
  terminal: "Terminal" {
    style.stroke: "#16a34a"
    style.bold: true
    style.stroke-width: 3
  }

  s0 -> s1: "r₁ = 0" {
    style.stroke: "#f59e0b"
  }
  s1 -> s2: "r₂ = 0" {
    style.stroke: "#f59e0b"
  }
  s2 -> terminal: "r₃ = +10" {
    style.stroke: "#16a34a"
    style.bold: true
  }
}

computation: "Return 计算（γ = 0.9）" {
  style.bold: true
  style.stroke: "#16a34a"
  style.stroke-width: 3

  g2: "G₂ = r₃ = 10" {
    style.bold: true
  }
  g1: "G₁ = 0 + 0.9 × 10 = 9" {
    style.bold: true
  }
  g0: "G₀ = 0 + 0 + 0.81 × 10\n= 8.1" {
    style.bold: true
  }

  g2 -> g1: "从后往前"
  g1 -> g0: "继续往前"
}
