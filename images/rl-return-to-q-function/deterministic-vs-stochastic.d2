grid-columns: 2

deterministic: "Deterministic Policy" {
  style.bold: true
  style.stroke: "#2563eb"
  style.stroke-width: 3

  state_d: "State S" {
    style.bold: true
  }
  action_a: "Action A (100%)" {
    style.bold: true
  }

  state_d -> action_a: "确定输出" {
    style.stroke: "#2563eb"
  }
}

stochastic: "Stochastic Policy" {
  style.bold: true
  style.stroke: "#f59e0b"
  style.stroke-width: 3

  state_s: "State S" {
    style.bold: true
  }
  act_a: "Action A" {
    style.bold: true
  }
  act_b: "Action B" {
    style.bold: true
  }
  act_c: "Action C" {
    style.bold: true
  }

  state_s -> act_a: "70%" {
    style.stroke: "#f59e0b"
  }
  state_s -> act_b: "20%" {
    style.stroke: "#f59e0b"
  }
  state_s -> act_c: "10%" {
    style.stroke: "#f59e0b"
  }
}
