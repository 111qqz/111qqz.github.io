grid-columns: 2

policy_rule: "Policy π（策略规则）" {
  style.bold: true
  style.stroke: "#2563eb"
  style.stroke-width: 3

  desc: "根据当前 State\n选择 Action 的规则" {
    style.bold: true
  }
  r1: "上涨 → A:80% / B:20%"
  r2: "震荡 → A:50% / B:50%"
  r3: "下跌 → A:10% / B:90%"

  desc -> r1
  r1 -> r2
  r2 -> r3
}

action_seq: "Action Sequence（动作序列）" {
  style.bold: true
  style.stroke: "#f59e0b"
  style.stroke-width: 3

  desc2: "一串已执行的动作记录\n不包含状态信息" {
    style.bold: true
  }
  a1: "t=0: A"
  a2: "t=1: B"
  a3: "t=2: B"
  a4: "t=3: A"

  desc2 -> a1
  a1 -> a2
  a2 -> a3
  a3 -> a4
}
