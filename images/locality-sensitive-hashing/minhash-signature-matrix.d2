direction: down

raw_matrix: "特征布尔矩阵 (7 行 Shingle × 4 网页文档)" {
  style.stroke: "#2563eb"
  style.bold: true
  table: {
    shape: sql_table
    "行 0": "Doc 1: 1 | Doc 2: 0 | Doc 3: 0 | Doc 4: 1"
    "行 1": "Doc 1: 0 | Doc 2: 0 | Doc 3: 1 | Doc 4: 0"
    "行 2": "Doc 1: 1 | Doc 2: 1 | Doc 3: 0 | Doc 4: 1"
    "行 3": "Doc 1: 1 | Doc 2: 0 | Doc 3: 1 | Doc 4: 1"
    "行 4": "Doc 1: 0 | Doc 2: 1 | Doc 3: 0 | Doc 4: 0"
    "行 5": "Doc 1: 1 | Doc 2: 0 | Doc 3: 0 | Doc 4: 0"
    "行 6": "Doc 1: 0 | Doc 2: 1 | Doc 3: 1 | Doc 4: 0"
  }
}

perm: "3 组随机行置换 (π_1, π_2, π_3)\nh_i(C) = 置换序列中首个值为 1 的行号" {
  shape: diamond
  style.stroke: "#f59e0b"
  style.bold: true
}

sig_matrix: "MinHash 签名矩阵 (3 行 × 4 列，特征从 7 维降至 3 维)" {
  style.stroke: "#16a34a"
  style.bold: true
  table: {
    shape: sql_table
    "置换 π_1 (蓝)": "Doc 1: 2 | Doc 2: 1 | Doc 3: 2 | Doc 4: 1"
    "置换 π_2 (绿)": "Doc 1: 1 | Doc 2: 2 | Doc 3: 1 | Doc 4: 1"
    "置换 π_3 (红)": "Doc 1: 3 | Doc 2: 4 | Doc 3: 2 | Doc 4: 3"
  }
}

raw_matrix -> perm: "独立随机置换各行顺序"
perm -> sig_matrix: "记录最小非零行号生成签名"
