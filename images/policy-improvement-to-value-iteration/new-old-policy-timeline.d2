direction: down

state_s: "当前状态 s —— 准备选择一个动作" {
  style.bold: true
  style.stroke: "#2563eb"
  style.stroke-width: 2
}

action_new: "新策略 π' 决定当前动作：A_t = π'(s)" {
  style.stroke: "#16a34a"
  style.stroke-width: 3
  style.bold: true
}

env_response: "环境根据 (s, π'(s)) 产生 R_{t+1}，并转移到 S_{t+1}" {
  style.stroke: "#f59e0b"
  style.stroke-width: 2
}

future_old: "从 S_{t+1} 开始，后续所有动作全部按旧策略 π 执行" {
  style.stroke: "#9ca3af"
  style.stroke-width: 2
  style.stroke-dash: 4
}

result: "整体期望 Return = Q^π(s, π'(s))：第一步新策略，后续旧策略" {
  style.bold: true
  style.stroke-width: 2
}

state_s -> action_new: "新策略选动作" {
  style.stroke: "#16a34a"
  style.bold: true
}
action_new -> env_response: "执行"
env_response -> future_old: "旧策略接管" {
  style.stroke: "#9ca3af"
}
future_old -> result
