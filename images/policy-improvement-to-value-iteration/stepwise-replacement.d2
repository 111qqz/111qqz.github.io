direction: down

step0: "全部旧策略 π —— 期望 Return = V^π(s)" {
  style.stroke: "#9ca3af"
  style.stroke-width: 2
}

step1: "第 1 步换成 π' 动作，后续仍用 π —— = Q^π(s, π'(s))" {
  style.stroke: "#16a34a"
  style.stroke-width: 2
}

step2: "前 2 步…前 k 步用 π' 选动作，后续仍用 π" {
  style.stroke: "#16a34a"
  style.stroke-width: 2
  style.bold: true
}

stepN: "全部新策略 π' —— 期望 Return = V^{π'}(s)" {
  style.stroke: "#16a34a"
  style.stroke-width: 3
  style.bold: true
}

step0 -> step1: "≤" {
  style.bold: true
  style.stroke: "#2563eb"
}
step1 -> step2: "≤  反复用 V^π(s') ≤ Q^π(s',π'(s')) 替换" {
  style.bold: true
  style.stroke: "#2563eb"
}
step2 -> stepN: "≤  最终所有步骤都由 π' 控制" {
  style.bold: true
  style.stroke: "#2563eb"
}
