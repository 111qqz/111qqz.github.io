grid-columns: 3

round0: "π₀：初始策略" {
  a0: "State A\n→ 结束 (R=1)\nV(A) = 1" {
    style.bold: true
    style.stroke: "#2563eb"
    style.stroke-width: 2
  }
  b0: "State B\n→ b₀ (R=0)\nV(B) = 0" {
    style.stroke: "#9ca3af"
    style.stroke-width: 2
  }
  q0: "Q(A, 前往B)\n= 0 + 0.9×0\n= 0 < 1" {
    style.stroke: "#dc2626"
    style.stroke-dash: 4
  }
  a0 -> b0: "前往B?\nQ=0" {
    style.stroke: "#dc2626"
    style.stroke-dash: 4
  }
}

round1: "π₁：B 改进" {
  a1: "State A\n→ 结束 (R=1)\nV(A) = 1" {
    style.bold: true
    style.stroke: "#2563eb"
    style.stroke-width: 2
  }
  b1: "State B\n→ b₁ (R=3)\nV(B) = 3" {
    style.stroke: "#16a34a"
    style.stroke-width: 3
    style.bold: true
  }
  q1: "Q(A, 前往B)\n= 0 + 0.9×3\n= 2.7 > 1" {
    style.stroke: "#16a34a"
    style.bold: true
  }
  a1 -> b1: "前往B?\nQ=2.7" {
    style.stroke: "#16a34a"
    style.bold: true
  }
}

round2: "π₂：收敛" {
  a2: "State A\n→ 前往B\nV(A) = 2.7" {
    style.bold: true
    style.stroke: "#16a34a"
    style.stroke-width: 3
  }
  b2: "State B\n→ b₁ (R=3)\nV(B) = 3" {
    style.stroke: "#16a34a"
    style.stroke-width: 3
    style.bold: true
  }
  a2 -> b2: "前往B\nQ=2.7" {
    style.stroke: "#16a34a"
    style.bold: true
  }
}
