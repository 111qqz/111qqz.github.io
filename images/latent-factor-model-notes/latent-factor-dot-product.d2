direction: right

user_vec: "用户 u 隐向量 p_u\n(用户在 K 个维度的偏好)" {
  style.stroke: "#2563eb"
  style.bold: true
  f1: "p_u1: 科幻偏好 = 0.9"
  f2: "p_u2: 悬疑偏好 = 0.8"
  f3: "p_u3: 动作偏好 = 0.6"
  f4: "p_u4: 爱情偏好 = 0.1"
}

item_vec: "物品 i 隐向量 q_i\n(物品在 K 个维度的特征)" {
  style.stroke: "#8b5cf6"
  style.bold: true
  f1: "q_1i: 科幻题材 = 0.8"
  f2: "q_2i: 悬疑题材 = 0.9"
  f3: "q_3i: 动作题材 = 0.5"
  f4: "q_4i: 爱情题材 = 0.1"
}

calc: "逐项乘积累加 (向量内积)\n∑ p_uk · q_ki" {
  shape: diamond
  style.stroke: "#f59e0b"
  style.bold: true
  f1: "0.9 × 0.8 = 0.72"
  f2: "0.8 × 0.9 = 0.72"
  f3: "0.6 × 0.5 = 0.30"
  f4: "0.1 × 0.1 = 0.01"
}

result: "预测兴趣度得分 r̂_ui\n(契合度越高，推荐排名越靠前)" {
  style.stroke: "#16a34a"
  style.bold: true
  score: "r̂_ui = 0.72 + 0.72 + 0.30 + 0.01 = 1.75" {
    style.bold: true
  }
}

user_vec -> calc: "输入偏好向量"
item_vec -> calc: "输入特征向量"
calc -> result: "求和输出标量得分"
