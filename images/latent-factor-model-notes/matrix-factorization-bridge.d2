direction: down

p_mat: "P 矩阵：用户-隐因子偏好 (|U| × K)" {
  style.stroke: "#2563eb"
  style.bold: true
  table: {
    shape: sql_table
    "User 1": "F1(科幻): 0.8 | F2(动作): 0.6 | F3(爱情): 0.1 | F4(喜剧): 0.2"
    "User 2": "F1(科幻): 0.1 | F2(动作): 0.2 | F3(爱情): 0.9 | F4(喜剧): 0.7"
    "User 3": "F1(科幻): 0.7 | F2(动作): 0.8 | F3(爱情): 0.2 | F4(喜剧): 0.1"
  }
}

q_mat: "Q 矩阵：隐因子-物品权重 (K × |I|)" {
  style.stroke: "#8b5cf6"
  style.bold: true
  table: {
    shape: sql_table
    "F1(科幻)": "Item 1: 0.9 | Item 2: 0.1 | Item 3: 0.8 | Item 4: 0.2"
    "F2(动作)": "Item 1: 0.7 | Item 2: 0.2 | Item 3: 0.6 | Item 4: 0.1"
    "F3(爱情)": "Item 1: 0.1 | Item 2: 0.8 | Item 3: 0.2 | Item 4: 0.7"
    "F4(喜剧)": "Item 1: 0.2 | Item 2: 0.6 | Item 3: 0.1 | Item 4: 0.9"
  }
}

r_mat: "R 矩阵：预测用户-物品评分 (R̂ = P · Q, 大小 |U| × |I|)" {
  style.stroke: "#16a34a"
  style.bold: true
  table: {
    shape: sql_table
    "User 1": "Item 1: 4.8 | Item 2: 1.5 | Item 3: 4.2 | Item 4: 1.8"
    "User 2": "Item 1: 1.4 | Item 2: 4.5 | Item 3: 1.6 | Item 4: 4.3"
    "User 3": "Item 1: 4.6 | Item 2: 1.6 | Item 3: 4.1 | Item 4: 1.7"
  }
}

p_mat -> r_mat: "用户偏好向量 p_u (第 u 行)"
q_mat -> r_mat: "物品属性向量 q_i (第 i 列)"
