direction: down

sparse_box: "观测评分矩阵 R (高维稀疏)" {
  style.stroke: "#2563eb"
  style.bold: true

  table: {
    shape: sql_table
    "User 1": "Item 1: 5.0 | Item 2: ?   | Item 3: 2.0 | Item 4: ?"
    "User 2": "Item 1: ?   | Item 2: 1.0 | Item 3: ?   | Item 4: 4.0"
    "User 3": "Item 1: 4.0 | Item 2: ?   | Item 3: ?   | Item 4: 5.0"
    "User 4": "Item 1: ?   | Item 2: 3.0 | Item 3: 1.0 | Item 4: ?"
  }
}

lfm_core: "LFM 矩阵分解与隐因子建模\n(利用低维隐向量表示用户偏好与物品特征)" {
  shape: diamond
  style.stroke: "#f59e0b"
  style.bold: true
}

dense_box: "预测评分矩阵 R̂ (稠密满矩阵，用于排序推荐)" {
  style.stroke: "#16a34a"
  style.bold: true

  table: {
    shape: sql_table
    "User 1": "Item 1: 5.0 | Item 2: 3.2 | Item 3: 2.0 | Item 4: 4.1"
    "User 2": "Item 1: 2.8 | Item 2: 1.0 | Item 3: 1.5 | Item 4: 4.0"
    "User 3": "Item 1: 4.0 | Item 2: 2.6 | Item 3: 3.1 | Item 4: 5.0"
    "User 4": "Item 1: 1.9 | Item 2: 3.0 | Item 3: 1.0 | Item 4: 2.4"
  }
}

sparse_box -> lfm_core: "输入已知评分样本"
lfm_core -> dense_box: "内积预测补全缺失值"
