direction: right

four_box: "四方向 Freeman 链码 (4-Connected)" {
  style.stroke: "#2563eb"
  style.bold: true

  grid-columns: 3
  grid-gap: 20

  b1: "" { style.opacity: 0 }
  n_dir: "1 (正北 90°)" { style.stroke: "#2563eb" }
  b2: "" { style.opacity: 0 }

  w_dir: "2 (正西 180°)" { style.stroke: "#2563eb" }
  center_p: "中心点 P" { shape: circle; style.bold: true }
  e_dir: "0 (正东 0°)" { style.stroke: "#2563eb" }

  b3: "" { style.opacity: 0 }
  s_dir: "3 (正南 270°)" { style.stroke: "#2563eb" }
  b4: "" { style.opacity: 0 }
}

eight_box: "八方向 Freeman 链码 (8-Connected)" {
  style.stroke: "#16a34a"
  style.bold: true

  grid-columns: 3
  grid-gap: 20

  nw: "3 (西北 135°)" { style.stroke: "#16a34a" }
  n: "2 (正北 90°)" { style.stroke: "#16a34a" }
  ne: "1 (东北 45°)" { style.stroke: "#16a34a" }

  w: "4 (正西 180°)" { style.stroke: "#16a34a" }
  center_p8: "中心点 P" { shape: circle; style.bold: true }
  e: "0 (正东 0°)" { style.stroke: "#16a34a" }

  sw: "5 (西南 225°)" { style.stroke: "#16a34a" }
  s: "6 (正南 270°)" { style.stroke: "#16a34a" }
  se: "7 (东南 315°)" { style.stroke: "#16a34a" }
}
