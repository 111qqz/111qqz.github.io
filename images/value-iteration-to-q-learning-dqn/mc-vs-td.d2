grid-columns: 2

mc_side: "Monte Carlo" {
  mc_start: "从 s₀ 开始" {
    style.stroke: "#2563eb"
    style.stroke-width: 2
    style.bold: true
  }
  mc_traj: "走完整条轨迹\ns₀→s₁→…→终止" {
    style.stroke: "#9ca3af"
    style.stroke-width: 2
  }
  mc_target: "Target = G₀\n实际采样 Return\n无 Bootstrapping" {
    style.bold: true
    style.stroke: "#16a34a"
    style.stroke-width: 3
  }

  mc_start -> mc_traj: "逐步交互"
  mc_traj -> mc_target: "轨迹结束后计算"
}

td_side: "TD（Q-Learning）" {
  td_start: "在 s 执行 a" {
    style.stroke: "#2563eb"
    style.stroke-width: 2
    style.bold: true
  }
  td_obs: "观察 R 和 s'" {
    style.stroke: "#f59e0b"
    style.stroke-width: 2
  }
  td_target: "Target = R + γ max Q(s',a')\n一步真实 + 估计\nBootstrapping" {
    style.bold: true
    style.stroke: "#7c3aed"
    style.stroke-width: 3
  }

  td_start -> td_obs: "一步交互"
  td_obs -> td_target: "每步即可更新"
}
