grid-columns: 2

table_side: "Q 表（Tabular）" {
  table_header: "Q(s, a) 查找表" {
    style.bold: true
    style.stroke: "#2563eb"
    style.stroke-width: 2
  }
  table_grid: "s₁: [2.1, 0.5, 1.3]\ns₂: [0.8, 3.2, 0.1]\ns₃: [1.5, 0.9, 2.7]\n…" {
    style.stroke: "#9ca3af"
    style.stroke-width: 2
  }
  table_note: "每个 (s,a) 一个独立数值\n无泛化能力" {
    style.stroke: "#dc2626"
    style.stroke-width: 2
  }

  table_header -> table_grid: "查表"
  table_grid -> table_note
}

net_side: "Q 网络（DQN）" {
  state_input: "输入：状态 s" {
    style.bold: true
    style.stroke: "#2563eb"
    style.stroke-width: 2
  }
  nn: "神经网络 Q_θ\n参数 θ 共享" {
    style.stroke: "#7c3aed"
    style.stroke-width: 3
    style.bold: true
  }
  q_output: "输出：\n[Q(s,a₁), Q(s,a₂), Q(s,a₃)]" {
    style.stroke: "#f59e0b"
    style.stroke-width: 2
  }
  argmax_node: "argmax → 选择动作\n参数共享 → 可泛化" {
    style.stroke: "#16a34a"
    style.stroke-width: 2
    style.bold: true
  }

  state_input -> nn: "前向传播"
  nn -> q_output: "一次输出所有动作"
  q_output -> argmax_node
}
