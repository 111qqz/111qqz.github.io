  act: "Activations\n0.5 GB (重算)" {
    style.stroke: "#f59e0b"
    style.stroke-dash: 4
  }
  opt: "Optimizer States\n84 GB" {
    style.stroke: "#dc2626"
    style.stroke-width: 3
  }
  grad: "Gradients\n14 GB" {
    style.stroke: "#16a34a"
  }
  param: "Parameters\n14 GB" {
    style.stroke: "#2563eb"
  }
  total: "GPU 合计\n≈ 114.5 GB\n仍超 80 GB" {
    style.stroke: "#dc2626"
    style.bold: true
    style.stroke-dash: 4
  }

  param -> grad -> opt -> act -> total
}

config_c: "C. Optimizer Offloading" {
  style.stroke: "#16a34a"
  style.bold: true

  act: "Activations\n30.6 GB" {
    style.stroke: "#f59e0b"
    style.stroke-width: 3
  }
  grad: "Gradients\n14 GB" {
    style.stroke: "#16a34a"
  }
  param: "Parameters\n14 GB" {
    style.stroke: "#2563eb"
  }
  total: "GPU 合计\n≈ 60.6 GB\n可行" {
    style.stroke: "#16a34a"
    style.bold: true
  }
  cpu: "CPU DRAM:\nOptimizer States\n84 GB" {
    style.stroke: "#f59e0b"
    style.stroke-dash: 4
  }

  param -> grad -> act -> total
  total -> cpu: "Offloaded" { style.stroke-dash: 4 }
}

