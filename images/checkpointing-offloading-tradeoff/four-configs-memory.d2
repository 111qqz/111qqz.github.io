grid-columns: 4

config_a: "A. 原始训练" {
  style.stroke: "#dc2626"
  style.bold: true

  act: "Activations\n30.6 GB" {
    style.stroke: "#f59e0b"
    style.stroke-width: 3
  }
  opt: "Optimizer States\n84 GB" {
    style.stroke: "#dc2626"
    style.stroke-width: 3
  }
  grad: "Gradients\n14 GB" {
    style.stroke: "#16a34a"
  }
  param: "Parameters\n14 GB" {
    style.stroke: "#2563eb"
  }
  total: "GPU 合计\n≈ 145 GB\n远超 80 GB" {
    style.stroke: "#dc2626"
    style.bold: true
    style.stroke-dash: 4
  }

  param -> grad -> opt -> act -> total
}

config_b: "B. Checkpointing" {
  style.stroke: "#f59e0b"
