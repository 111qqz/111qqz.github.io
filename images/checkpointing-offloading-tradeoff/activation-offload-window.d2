direction: right

execution: "训练执行顺序" {
  direction: right
  f1: "F1" { style.stroke: "#2563eb" }
  f2: "F2" { style.stroke: "#2563eb" }
  f3: "F3" { style.stroke: "#2563eb" }
  f4: "F4" { style.stroke: "#2563eb" }
  b4: "B4" { style.stroke: "#dc2626" }
  b3: "B3" { style.stroke: "#dc2626" }
  b2: "B2" { style.stroke: "#dc2626" }
  b1: "B1" { style.stroke: "#dc2626" }

  f1 -> f2 -> f3 -> f4 -> b4 -> b3 -> b2 -> b1
}

early: "Act_L1\nF1 产生 → B1 使用\n窗口宽裕" {
  style.stroke: "#16a34a"
  style.bold: true
  style.stroke-dash: 4
}

late_act: "Act_L3\nF3 产生 → B3 使用\n窗口很短" {
  style.stroke: "#f59e0b"
  style.bold: true
  style.stroke-dash: 4
}

execution.f1 -> early: "" {
  style.stroke-dash: 4
  style.stroke: "#16a34a"
}
early -> execution.b1: "" {
  style.stroke-dash: 4
  style.stroke: "#16a34a"
}

execution.f3 -> late_act: "" {
  style.stroke-dash: 4
  style.stroke: "#f59e0b"
}
late_act -> execution.b3: "" {
  style.stroke-dash: 4
  style.stroke: "#f59e0b"
}
