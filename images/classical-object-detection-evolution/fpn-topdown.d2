direction: down

c5: "C5 (deep, strong semantics, low resolution)" {style.stroke: "#2563eb"; style.bold: true; style.stroke-width: 2}
p5: P5

c4: C4 {style.stroke: "#2563eb"}
p4: "P4 = upsample(P5) + lateral(C4)" {style.stroke: "#16a34a"; style.stroke-width: 2}

c3: C3 {style.stroke: "#2563eb"}
p3: "P3 = upsample(P4) + lateral(C3)" {style.stroke: "#16a34a"; style.stroke-width: 2}

c2: "C2 (shallow, high resolution)" {style.stroke: "#2563eb"}
p2: "P2 = upsample(P3) + lateral(C2)\nhigh res + strong semantics" {style.stroke: "#16a34a"; style.bold: true; style.stroke-width: 2}

c5 -> p5: "1×1 conv"
p5 -> p4: "upsample"
c4 -> p4: "lateral" {style.stroke-dash: 4}
p4 -> p3: "upsample"
c3 -> p3: "lateral" {style.stroke-dash: 4}
p3 -> p2: "upsample"
c2 -> p2: "lateral" {style.stroke-dash: 4}
