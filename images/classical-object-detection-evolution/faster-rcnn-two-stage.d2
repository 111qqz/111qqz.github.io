direction: down

input: "Image → Backbone → Feature Map"

rpn: "Stage 1: RPN\n(objectness + coarse box regression)" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
  style.bold: true
}

proposals: "~300 Proposals (dense → sparse)" {
  style.stroke: "#f59e0b"
  style.stroke-width: 2
}

cls_reg: "Stage 2: RoI Pool → Cls + BBox Regression" {
  style.stroke: "#16a34a"
  style.stroke-width: 2
  style.bold: true
}

input -> rpn: "Where might objects be?"
rpn -> proposals
proposals -> cls_reg: "What exactly are they?"
input -> cls_reg: "shared features" {style.stroke-dash: 4}
