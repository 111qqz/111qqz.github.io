direction: down

point: "Anchor-Free: Feature Map 上的一个 Point" {
  style.stroke: "#dc2626"
  style.stroke-width: 2
  style.bold: true
}
ltrb: "Network 预测 left, top, right, bottom"
box: "Predicted Bounding Box" {
  style.stroke: "#16a34a"
  style.stroke-width: 2
}

point -> ltrb: "'从这个点出发，边界在哪？'"
