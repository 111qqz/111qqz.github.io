direction: down

sw: "Sliding Window: 暴力枚举所有位置和尺度 (exhaustive search)" {style.stroke: "#9ca3af"}
frcnn: "Faster R-CNN: learned proposal generation → two-stage (dense→sparse)" {style.stroke: "#2563eb"; style.stroke-width: 2; style.bold: true}
ssd: "SSD: 删除 proposal stage → single-stage dense prediction" {style.stroke: "#f59e0b"; style.stroke-width: 2}
fpn: "FPN: top-down pathway 把 strong semantics 传回 high-res feature map" {style.stroke: "#16a34a"; style.stroke-width: 2}
retina: "RetinaNet: Focal Loss 解决 dense detection 极端 class imbalance" {style.stroke: "#dc2626"; style.stroke-width: 2; style.bold: true}
fcos: "FCOS / Anchor-Free: 删除 handcrafted anchor template, point → (l, t, r, b)" {style.stroke: "#7c3aed"; style.stroke-width: 2; style.bold: true}

sw -> frcnn
frcnn -> ssd
ssd -> fpn
fpn -> retina
retina -> fcos
