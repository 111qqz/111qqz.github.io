direction: down

input: Image → CNN

cls_head: Classification Head {style.stroke: "#2563eb"; style.stroke-width: 2}
cls_out: "Output: class label\n(固定维度)" {style.stroke: "#2563eb"}

det_head: Detection Head {style.stroke: "#dc2626"; style.stroke-width: 2; style.bold: true}
det_out: "Output: (class, conf, x1, y1, x2, y2) × N\n(不定数量)" {style.stroke: "#dc2626"; style.bold: true}

input -> cls_head -> cls_out
input -> det_head -> det_out
