direction: right

t100: "t = 100" {
  style.stroke: "#2563eb"
  style.bold: true

  direction: down

  signal: "信号 √ᾱ_t ≈ 0.95\n(图片轮廓清晰)" {
    style.stroke: "#2563eb"
    style.stroke-width: 3
    style.bold: true
  }
  noise: "噪声 √(1-ᾱ_t) ≈ 0.31\n(轻微模糊)" {
    style.stroke: "#f59e0b"
    style.stroke-dash: 4
  }
}

t500: "t = 500" {
  style.stroke: "#f59e0b"
  style.bold: true

  direction: down

  signal: "信号 √ᾱ_t ≈ 0.50\n(依稀可辨)" {
    style.stroke: "#2563eb"
  }
  noise: "噪声 √(1-ᾱ_t) ≈ 0.87\n(严重失真)" {
    style.stroke: "#f59e0b"
    style.stroke-width: 3
    style.bold: true
  }
}

t900: "t = 900" {
  style.stroke: "#dc2626"
  style.bold: true

  direction: down

  signal: "信号 √ᾱ_t ≈ 0.05\n(几乎为零)" {
    style.stroke: "#2563eb"
    style.stroke-dash: 4
  }
  noise: "噪声 √(1-ᾱ_t) ≈ 1.00\n(接近纯噪声)" {
    style.stroke: "#dc2626"
    style.stroke-width: 3
    style.bold: true
  }
}

t100 -> t500: "ᾱ_t 递减" {
  style.stroke-dash: 4
}
t500 -> t900: "ᾱ_t 递减" {
  style.stroke-dash: 4
}

summary: "不同 timestep\n= 不同难度的去噪任务" {
  style.bold: true
  style.stroke: "#16a34a"
  style.stroke-width: 3
  style.font-size: 18
}

t500 -> summary {
  style.opacity: 0
}
