grid-columns: 2

forward: "前向扩散（已知规则）" {
  style.stroke: "#2563eb"
  style.bold: true

  direction: down

  x0: "x₀\n(原始图片)" {
    style.bold: true
  }
  xt: "x_t\n(噪声图片)" {
    style.stroke: "#f59e0b"
  }

  x0 -> xt: "加噪" {
    style.stroke: "#2563eb"
    style.bold: true
    style.stroke-width: 3
  }

  info: "已知 x₀\n已知 ε ~ N(0, I)\n已知 noise schedule ᾱ_t\n\n可以直接计算" {
    style.stroke: "#16a34a"
    style.bold: true
  }
}

reverse: "反向生成（需要学习）" {
  style.stroke: "#dc2626"
  style.bold: true

  direction: down

  xt2: "x_T\n(纯噪声)" {
    style.stroke: "#f59e0b"
  }
  x02: "x₀\n(???)" {
    style.stroke: "#dc2626"
    style.bold: true
    style.stroke-width: 3
  }

  xt2 -> x02: "去噪" {
    style.stroke: "#dc2626"
    style.bold: true
    style.stroke-width: 3
  }

  info2: "不知道 x₀\n不知道真实 ε\n不知道数据分布 p(x₀)\n\n必须用网络学习" {
    style.stroke: "#dc2626"
    style.bold: true
  }
}
