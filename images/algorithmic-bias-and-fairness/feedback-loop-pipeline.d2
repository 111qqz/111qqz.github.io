grid-columns: 2

step1: "1. 历史人工偏好与经验法则\n过往面试官倾向录用特定高校候选人\n产生非均衡的历史招聘记录" {
  style.stroke: "#2563eb"
  style.bold: true
}

step2: "2. 观测截断与选择偏差（Selection Bias）\n仅被录用者能产生后续工作绩效数据\n未被录用者的真实潜力永远不可见" {
  style.stroke: "#f59e0b"
  style.bold: true
}

step4: "4. 算法决策落地与偏差固化\n模型拒绝更多非目标背景候选人\n进一步压缩多元背景的进入渠道" {
  style.stroke: "#dc2626"
  style.bold: true
}

step3: "3. 算法模型拟合有偏数据\n模型将可观测到的数据视为全部事实\n将历史特定群体的成功过度归因于背景" {
  style.stroke: "#16a34a"
  style.bold: true
}

step1 -> step2: "筛选产生录用池"
step2 -> step3: "提供训练样本与标注"
step3 -> step4: "模型部署自动化决策"
step4 -> step1: "反馈闭环：产生更极端的新一轮历史数据" {
  style.stroke: "#dc2626"
  style.stroke-dash: 4
}
