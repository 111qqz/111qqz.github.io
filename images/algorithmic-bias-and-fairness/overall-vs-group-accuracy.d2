direction: right

dataset: "测试集样本池\n总计 1000 个样本" {
  style.stroke: "#2563eb"
  style.bold: true
}

groups: "" {
  grid-columns: 2

  group_a: "多数群体 A（900 样本）\n占比 90%" {
    style.stroke: "#16a34a"
    correct_a: "预测正确：891\n预测错误：9\n群体准确率：99.0%" {
      style.stroke: "#16a34a"
    }
  }

  group_b: "少数群体 B（100 样本）\n占比 10%" {
    style.stroke: "#dc2626"
    style.bold: true
    correct_b: "预测正确：60\n预测错误：40\n群体准确率：60.0%" {
      style.stroke: "#dc2626"
    }
  }
}

overall: "全局统计度量（加权平均）\n总正确数：891 + 60 = 951\n总体准确率：95.1%\n少数群体的极端错误率被总量稀释" {
  style.stroke: "#f59e0b"
  style.bold: true
}

dataset -> groups.group_a: "90% 样本输入"
dataset -> groups.group_b: "10% 样本输入"
groups.group_a -> overall: "提供 891 正确"
groups.group_b -> overall: "提供 60 正确"
