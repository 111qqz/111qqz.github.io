direction: right

benchmark_title: "商业人脸性别分类评测（Gender Shades, 2018）\n任务：从人脸图像判定性别（非身份识别）" {
  style.stroke: "#2563eb"
  style.bold: true
}

comparison: "" {
  grid-columns: 2

  lighter_group: "较浅肤色受试群体（Lighter）" {
    style.stroke: "#16a34a"

    lighter_male: "较浅肤色男性（Lighter Male）\n分类错误率：0.8%\n识别表现最优" {
      style.stroke: "#16a34a"
    }
    lighter_female: "较浅肤色女性（Lighter Female）\n分类错误率：7.1%" {
      style.stroke: "#2563eb"
    }
    lighter_male -> lighter_female: "性别维度差异" {
      style.stroke-dash: 3
    }
  }

  darker_group: "较深肤色受试群体（Darker）" {
    style.stroke: "#dc2626"
    style.bold: true

    darker_male: "较深肤色男性（Darker Male）\n分类错误率：12.0%" {
      style.stroke: "#f59e0b"
    }
    darker_female: "较深肤色女性（Darker Female）\n分类错误率：高达 34.7%\n交叉重叠导致错误率激增" {
      style.stroke: "#dc2626"
      style.bold: true
    }
    darker_male -> darker_female: "交叉维度叠加" {
      style.stroke-dash: 3
    }
  }
}

benchmark_title -> comparison.lighter_group: "输入较浅肤色测试子集"
benchmark_title -> comparison.darker_group: "输入较深肤色测试子集"
