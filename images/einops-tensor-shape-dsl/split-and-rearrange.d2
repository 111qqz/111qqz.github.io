direction: down

A: "[B, S, H*D]\n输入：batch × seq × hidden"
B: "[B, S, H, D]\nsplit hidden → heads × head_dim"
C: "[B, H, S, D]\nrearrange axes"

A -> B: "(h d) 拆分"
B -> C: "axis 重排"

A.style: {
  stroke: blue
  stroke-width: 3
}
B.style: {
  stroke: blue
}
C.style: {
  stroke: green
  stroke-width: 3
}
