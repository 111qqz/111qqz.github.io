direction: down

stack: "x86 经典函数调用栈帧布局 (Stack Frame，内存由高向低增长 ↓)" {
  shape: sql_table
  "[ebp + 12] 高地址": "函数参数 2：Caller 从右向左压栈 (如 arg2)"
  "[ebp + 8] 高地址": "函数参数 1：Caller 压栈 (如 arg1)"
  "[ebp + 4] 高地址": "返回地址 Return EIP：call 指令自动压入主调函数下一条指令"
  "[ebp + 0] 帧指针基准": "Saved EBP：旧栈帧基指针 (由 push ebp; mov ebp, esp 保存)"
  "[ebp - 4] 低地址": "局部变量 1：被调函数内部局部变量 (sub esp, N 分配)"
  "[ebp - 8] 低地址": "局部变量 2：被调函数内部局部变量"
  "当前 ESP 栈顶": "当前栈顶指针 ESP 指向的位置 (动态随 push/pop 变动)"
}
