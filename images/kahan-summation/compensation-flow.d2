direction: right
input: "当前输入 xᵢ" {height: 100}
old_residual: "上一轮残差 cᵢ₋₁" {height: 100}
old_sum: "上一轮和 sᵢ₋₁" {height: 100}
correct: "修正输入\nyᵢ = xᵢ − cᵢ₋₁" {height: 120; style.stroke: "#2563eb"}
add: "FP32 加法\ntᵢ = sᵢ₋₁ + yᵢ" {style.bold: true}
residual: "计算本轮残差\ncᵢ = (tᵢ − sᵢ₋₁) − yᵢ" {style.stroke: "#f59e0b"}
next: "下一轮\n使用 cᵢ" {style.stroke: "#f59e0b"}
sum: "下一轮\n使用 sᵢ = tᵢ" {style.stroke: "#16a34a"}
input -> correct
old_residual -> correct
old_sum -> add
old_sum -> residual
correct -> add: "yᵢ"
add -> residual: "tᵢ"
correct -> residual: "yᵢ"
add -> sum: "tᵢ"
residual -> next: "cᵢ"
