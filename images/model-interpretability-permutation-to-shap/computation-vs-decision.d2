grid-columns: 2

forward_pass: "前向计算：完全透明且确定" {
  style.stroke: "#2563eb"
  style.bold: true

  input_vec: "特征输入向量 x\n(batch_size, feature_num)"
  hidden_layers: "参数矩阵乘法与激活函数\nW2 · σ(W1 · x + b1) + b2"
  output_val: "确定性预测标量 ŷ\n数值精确、计算过程完全透明"

  input_vec -> hidden_layers -> output_val
}

decision_attribution: "决策归因：高维隐式黑盒" {
  style.stroke: "#dc2626"
  style.bold: true

  question_why: "为什么给出该预测？\n是哪些特征推高或压低了数值？"
  entangled_space: "高维空间中的非线性交互\n特征之间互相交织，无法线性拆解"
  attribution_gap: "解释鸿沟：知道'怎么计算的'\n不等于理解'依赖什么逻辑做决策'"

  question_why -> entangled_space -> attribution_gap
}
