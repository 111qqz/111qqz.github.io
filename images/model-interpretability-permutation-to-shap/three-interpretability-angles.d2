grid-columns: 3

angle1: "视角一：特征重要度\n(Feature Importance)" {
  style.stroke: "#2563eb"

  q1: "核心问题：\n已训练好的模型当前依赖哪些特征？"
  method1: "典型方法：\nPermutation Importance / 平均绝对 SHAP"
  target1: "评估对象：\n固定模型权重下对特征扰动的敏感程度"

  q1 -> method1 -> target1
}

angle2: "视角二：特征筛选\n(Feature Selection)" {
  style.stroke: "#16a34a"

  q2: "核心问题：\n哪些特征具有真正的增量预测价值？"
  method2: "典型方法：\nRecursive Feature Elimination (RFE)"
  target2: "评估对象：\n剔除特征并重新训练后的泛化表现"

  q2 -> method2 -> target2
}

angle3: "视角三：单次局部归因\n(Local Attribution)" {
  style.stroke: "#f59e0b"

  q3: "核心问题：\n针对某次具体预测，各特征贡献如何？"
  method3: "典型方法：\nLIME 局部线性近似 / SHAP 边际分配"
  target3: "评估对象：\n单样本预测值偏离基准的特征拆解"

  q3 -> method3 -> target3
}
