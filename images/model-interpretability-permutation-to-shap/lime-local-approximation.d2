grid-columns: 2

global_view: "全局视角：复杂的非线性曲面" {
  style.stroke: "#f59e0b"

  complex_model: "全局复杂神经网络 f(x)\n决策曲面剧烈扭曲、高阶相互交织"
  global_dilemma: "若在全局强求线性可解释\n模型精度将面临毁灭性塌陷"

  complex_model -> global_dilemma
}

local_view: "局部视角：聚焦特定样本的微小邻域" {
  style.stroke: "#16a34a"

  target_point: "待解释的目标样本 x₀\n(模型给出预测值 ŷ₀ = f(x₀))"
  perturb_sample: "在 x₀ 邻近区域加权扰动采样\n距离越近样本赋予越高权重"
  fit_proxy: "训练局部代理线性模型 g(z)\n以加权最小二乘拟合局部行为"
  explain_output: "解析代理模型线性权重 w\n作为本次预测的特征局部贡献"

  target_point -> perturb_sample -> fit_proxy -> explain_output
}
