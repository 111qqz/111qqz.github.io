grid-columns: 2

full_attn: "Full Self-Attention" {
  style.bold: true

  table: {
    shape: sql_table
    "": "我 | 今天 | 学习 | AI"
    "我": "✓ | ✓ | ✓ | ✓"
    "今天": "✓ | ✓ | ✓ | ✓"
    "学习": "✓ | ✓ | ✓ | ✓"
    "AI": "✓ | ✓ | ✓ | ✓"
  }

  note: "所有 Query 可以关注\n所有 Key（全连接）" {
    style.stroke: "#2563eb"
    style.stroke-dash: 4
  }

  table -> note
}

causal_attn: "Causal Attention" {
  style.bold: true

  table: {
    shape: sql_table
    "": "我 | 今天 | 学习 | AI"
    "我": "✓ | −∞ | −∞ | −∞"
    "今天": "✓ | ✓ | −∞ | −∞"
    "学习": "✓ | ✓ | ✓ | −∞"
    "AI": "✓ | ✓ | ✓ | ✓"
  }

  note: "Query i 只能关注\nKey j ≤ i（下三角）" {
    style.stroke: "#dc2626"
    style.stroke-dash: 4
  }

  table -> note
}
