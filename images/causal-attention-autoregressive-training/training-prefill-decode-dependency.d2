grid-columns: 2

train_prefill: "Training / Prefill" {
  style.bold: true
  style.stroke: "#2563eb"

  input: "完整输入序列已知" {
    style.stroke: "#16a34a"
    style.stroke-width: 3
  }

  compute: "所有位置\n并行计算 Attention" {
    style.stroke: "#2563eb"
  }

  output: "所有位置的\n预测同时产生" {
    style.stroke: "#2563eb"
  }

  input -> compute: "Q, K, V 一次性准备好"
  compute -> output: "矩阵运算"

  note: "Causal Mask 只影响\nattention weight 分布\n不影响计算顺序" {
    style.stroke-dash: 4
    style.stroke: "#f59e0b"
  }

  output -> note
}

decode: "Decode（自回归生成）" {
  style.bold: true
  style.stroke: "#dc2626"

  step1: "Token 1（已知）" {
    style.stroke: "#16a34a"
  }
  step2: "生成 Token 2"
  step3: "生成 Token 3"
  step4: "生成 Token 4"

  step1 -> step2: "依赖 Token 1" {
    style.stroke: "#dc2626"
    style.bold: true
  }
  step2 -> step3: "依赖 Token 1–2" {
    style.stroke: "#dc2626"
    style.bold: true
  }
  step3 -> step4: "依赖 Token 1–3" {
    style.stroke: "#dc2626"
    style.bold: true
  }

  note: "每步必须等上一步\n生成结果（串行）" {
    style.stroke-dash: 4
    style.stroke: "#f59e0b"
  }

  step4 -> note
}
