grid-columns: 3

enc: "Encoder\nSelf-Attention" {
  style.bold: true
  style.stroke: "#2563eb"

  desc: "Source Token 之间\n双向全连接" {
    style.stroke-dash: 4
  }

  t1: "The"
  t2: "cat"
  t3: "sat"

  t1 -> t2
  t1 -> t3
  t2 -> t1
  t2 -> t3
  t3 -> t1
  t3 -> t2
}

dec_self: "Decoder\nCausal Self-Attention" {
  style.bold: true
  style.stroke: "#dc2626"

  desc: "Target Token 只能\n关注已生成的位置" {
    style.stroke-dash: 4
  }

  d1: "那只"
  d2: "猫"
  d3: "坐在"

  d2 -> d1
  d3 -> d1
  d3 -> d2
}

dec_cross: "Decoder\nCross-Attention" {
  style.bold: true
  style.stroke: "#16a34a"

  desc: "每个 Target Token\n可读取全部 Encoder 输出" {
    style.stroke-dash: 4
  }

  src: "Encoder 输出\n（完整 Source）" {
    style.stroke: "#2563eb"
  }
  tgt: "当前 Decoder\n位置" {
    style.stroke: "#dc2626"
  }

  src -> tgt: "全部可见"
}
