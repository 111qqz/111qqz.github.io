direction: down

chunk1: "chunk 1\nforward + backward" {
  style.stroke: "#2563eb"
  style.bold: true
}
chunk2: "chunk 2\nforward + backward" {
  style.stroke: "#2563eb"
  style.bold: true
}
chunk3: "chunk 3\nforward + backward" {
  style.stroke: "#2563eb"
  style.bold: true
}

chunk1 -> chunk2: "h 的数值继续传" { style.stroke: "#16a34a" }
chunk2 -> chunk1: "gradient 在这里被 detach() 切断" {
  style.stroke: "#dc2626"
  style.stroke-dash: 4
}

chunk2 -> chunk3: "h 的数值继续传" { style.stroke: "#16a34a" }
chunk3 -> chunk2: "gradient 在这里被 detach() 切断" {
  style.stroke: "#dc2626"
  style.stroke-dash: 4
}
