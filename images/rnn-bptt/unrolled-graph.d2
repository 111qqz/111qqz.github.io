direction: down

h0: "h₀" { shape: circle }
h1: "h₁" { shape: circle }
h2: "h₂" { shape: circle }
h3: "h₃" { shape: circle }

w: "W\n（只有一份 parameter）" {
  style.stroke: "#2563eb"
  style.bold: true
}

h0 -> h1
h1 -> h2
h2 -> h3

w -> h1: "use site @t1" { style.stroke: "#2563eb"; style.stroke-dash: 4 }
w -> h2: "use site @t2" { style.stroke: "#2563eb"; style.stroke-dash: 4 }
w -> h3: "use site @t3" { style.stroke: "#2563eb"; style.stroke-dash: 4 }
