direction: down

a: "RNN parameter sharing\n（一份 W，多个 use site）" { style.stroke: "#2563eb" }
b: "time-unrolled computation graph\n→ BPTT（普通 backprop）" {
  style.stroke: "#2563eb"
  style.bold: true
}
c: "gradient 在 shared parameter 上累加\nfuture loss 监督 earlier hidden state"
d: "跨时间 Jacobian 连乘\n→ vanishing / exploding gradient" { style.stroke: "#dc2626" }
e: "TBPTT / gradient clipping / LSTM·GRU" { style.stroke: "#16a34a" }

a -> b -> c -> d -> e
