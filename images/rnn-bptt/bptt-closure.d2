direction: right

a: "RNN parameter sharing\n一份 W，多个 use site" { style.stroke: "#2563eb" }
b: "time-unrolled graph\n→ BPTT（普通 backprop）" {
  style.stroke: "#2563eb"
  style.bold: true
}
c: "gradient 在 shared param 上累加\nfuture loss 监督 earlier state"
d: "跨时间 Jacobian 连乘\n→ vanishing / exploding" { style.stroke: "#dc2626" }
e: "TBPTT / clipping\nLSTM · GRU" { style.stroke: "#16a34a" }

a -> b -> c -> d -> e
