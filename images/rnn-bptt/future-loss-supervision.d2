direction: right

h1: "h₁" {
  shape: circle
  style.bold: true
}
h2: "h₂" { shape: circle }
h3: "h₃" { shape: circle }

p1: "prediction₁" { style.stroke: "#16a34a" }
p2: "prediction₂" { style.stroke: "#16a34a" }
p3: "prediction₃" { style.stroke: "#16a34a" }

L1: "L₁" { style.stroke: "#dc2626" }
L2: "L₂" { style.stroke: "#dc2626" }
L3: "L₃" { style.stroke: "#dc2626" }

h1 -> h2
h2 -> h3

h1 -> p1
h2 -> p2
h3 -> p3

p1 -> L1 { style.stroke-dash: 4 }
p2 -> L2 { style.stroke-dash: 4 }
p3 -> L3 { style.stroke-dash: 4 }

L2 -> h1: "future loss 的 gradient" {
  style.stroke: "#dc2626"
  style.stroke-dash: 4
}
L3 -> h1: "future loss 的 gradient" {
  style.stroke: "#dc2626"
  style.stroke-dash: 4
}
