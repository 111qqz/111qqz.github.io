grid-columns: 2

stock_box: "股票做空交易 (单维价格博弈)" {
  style.stroke: "#2563eb"
  style.stroke-width: 2

  s_thesis: "核心判断：方向 (Direction)\n预期泡泡玛特股价从 142 港元下跌" {
    style.stroke: "#2563eb"
  }

  s_pnl: "收益结构：线性对称\n股价下跌 1 港元，获利 1 港元\n股价上涨 1 港元，亏损 1 港元" {
    style.stroke: "#64748b"
  }

  s_borrow: "交易机制：融券做空\n需借入股票、支付融券利息\n承担潜在无上限的逼空风险" {
    style.stroke: "#64748b"
  }

  s_time: "时间特性：无硬性到期日\n保证金充足前提下\n可长期持有等待趋势兑现" {
    style.stroke: "#64748b"
  }

  s_thesis -> s_pnl: "方向直接映射损益"
  s_pnl -> s_borrow: "依赖融券通道"
  s_borrow -> s_time: "时间不产生固定损耗"
}

option_box: "买入 Put 看跌期权 (四维约束拼图)" {
  style.stroke: "#dc2626"
  style.stroke-width: 2

  d1: "1. 方向 (Direction)\n标的价格必须朝看跌方向运动" {
    style.stroke: "#dc2626"
  }

  d2: "2. 幅度 (Magnitude)\n下跌幅度必须穿透权利金成本\n跌破 140.50 港元到期才有净利润" {
    style.stroke: "#dc2626"
  }

  d3: "3. 时间 (Timing)\n必须在 11 天内兑现跌势\n每日承受 Theta 时间价值衰减" {
    style.stroke: "#dc2626"
  }

  d4: "4. 波动率 (Volatility)\n隐含波动率若快速下降\nVega 损失会直接侵蚀权利金" {
    style.stroke: "#dc2626"
  }

  o_result: "非对称收益结构\n最大损失锁定为 900 港元权利金\n四重维度共同决定期权价格" {
    style.stroke: "#f59e0b"
    style.bold: true
  }

  d1 -> d2
  d2 -> d3
  d3 -> d4
  d4 -> o_result: "综合决定买方胜负"
}
