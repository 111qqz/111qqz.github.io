grid-columns: 3

case_heavy: "t = 800（重噪声）" {
  style.stroke: "#dc2626"
  style.bold: true

  direction: down

  input_h: "x₈₀₀\n(几乎纯噪声)"

  net_h: "U-Net(θ)" {
    style.stroke: "#16a34a"
    style.bold: true
    style.stroke-width: 3
  }

  output_h: "ε̂₁\n预测大幅度噪声" {
    style.stroke: "#dc2626"
  }

  input_h -> net_h -> output_h
}

case_mid: "t = 300（中等噪声）" {
  style.stroke: "#f59e0b"
  style.bold: true

  direction: down

  input_m: "x₃₀₀\n(中等噪声)"

  net_m: "U-Net(θ)" {
    style.stroke: "#16a34a"
    style.bold: true
    style.stroke-width: 3
  }

  output_m: "ε̂₂\n预测中等噪声" {
    style.stroke: "#f59e0b"
  }

  input_m -> net_m -> output_m
}

case_light: "t = 50（轻噪声）" {
  style.stroke: "#2563eb"
  style.bold: true

  direction: down

  input_l: "x₅₀\n(轻微噪声)"

  net_l: "U-Net(θ)" {
    style.stroke: "#16a34a"
    style.bold: true
    style.stroke-width: 3
  }

  output_l: "ε̂₃\n预测轻微噪声" {
    style.stroke: "#2563eb"
  }

  input_l -> net_l -> output_l
}
