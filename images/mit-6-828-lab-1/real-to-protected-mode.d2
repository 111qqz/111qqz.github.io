grid-columns: 2

stage1: 实模式准备 {
  grid-columns: 1
  entry: "BIOS 把 boot sector 加载到 0x7c00\n以实模式跳入：CS = 0x0000, IP = 0x7c00"
  setup: "cli / cld\nDS = ES = SS = 0"
  entry -> setup
}

stage2: 切换准备 {
  grid-columns: 1
  a20: "打开 A20 地址线\n先向端口 0x64 写 0xd1，再向端口 0x60 写 0xdf"
  gdt: "lgdt gdtdesc\n把 bootstrap GDT 的地址与大小装入 GDTR"
  a20 -> gdt
}

stage3: 进入保护模式 {
  grid-columns: 1
  pe: "CR0.PE 置 1\n开启保护模式" {
    style.bold: true
    style.stroke: "#2563eb"
  }
  flush: "ljmp \$0x8, \$protcseg\n刷新 CS，切换到 32-bit 代码段"
  dataseg: "DS / ES / FS / GS / SS = 0x10\n载入保护模式数据段"
  pe -> flush -> dataseg
}

stage1 -> stage2 -> stage3
stage3 -> bootmain: "call bootmain\n开始执行 C 代码"
