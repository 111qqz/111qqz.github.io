grid-columns: 2

router_view: "Router 视角：逻辑均衡" {
  style.stroke: "#16a34a"
  style.bold: true

  experts_ok: "E0–E7 各 128 Tokens\n(完美均匀分配)" {
    style.stroke: "#16a34a"
  }

  note_r: "看似完美均衡\n每个 Expert 分到\n相同数量 Token" {
    style.stroke-dash: 4
  }
}

gpu_view: "GPU 视角：物理不均衡" {
  style.stroke: "#dc2626"
  style.bold: true

  grid-columns: 2

  g0: "GPU 0\n(E0, E1)\n总 256 T\n跨卡 50 T"
  g1: "GPU 1\n(E2, E3)\n总 256 T\n跨卡 180 T" {
    style.stroke: "#dc2626"
  }
  g2: "GPU 2\n(E4, E5)\n总 256 T\n跨卡 100 T"
  g3: "GPU 3\n(E6, E7)\n总 256 T\n跨卡 200 T" {
    style.stroke: "#dc2626"
    style.bold: true
  }

  note_g: "Token 来源分布不均\nAll-to-All 通信量\n各 GPU 不对称" {
    style.stroke-dash: 4
  }
}
