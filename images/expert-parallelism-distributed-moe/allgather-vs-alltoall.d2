grid-columns: 2

allgather: "AllGather" {
  style.stroke: "#dc2626"
  style.bold: true

  ag_desc: "每张 GPU 广播\n全部本地 Token\n给所有人" {
    style.stroke-dash: 4
  }

  grid-columns: 2
  ag_g0: "GPU 0 发出:\nA, B\n→ GPU 1,2,3"
  ag_g1: "GPU 1 发出:\nC, D\n→ GPU 0,2,3"
  ag_g2: "GPU 2 发出:\nE, F\n→ GPU 0,1,3"
  ag_g3: "GPU 3 发出:\nG, H\n→ GPU 0,1,2"

  ag_total: "跨 GPU 传输:\n24 份 × 8 KiB\n= 192 KiB" {
    style.stroke: "#dc2626"
    style.bold: true
  }
}

alltoall: "All-to-All" {
  style.stroke: "#2563eb"
  style.bold: true

  a2a_desc: "只发送需要去\n其他 GPU 的 Token" {
    style.stroke-dash: 4
  }

  grid-columns: 2
  a2a_g0: "GPU 0:\nA → GPU 3"
  a2a_g1: "GPU 1:\nC → GPU 2\nD → GPU 3"
  a2a_g2: "GPU 2:\nE → GPU 1"
  a2a_g3: "GPU 3:\nG → GPU 0\nH → GPU 1"

  a2a_total: "跨 GPU 传输:\n6 份 × 8 KiB\n= 48 KiB" {
    style.stroke: "#2563eb"
    style.bold: true
  }
}
