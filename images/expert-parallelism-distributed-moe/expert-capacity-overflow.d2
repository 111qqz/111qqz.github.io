direction: right

routing: "路由结果" {
  style.stroke: "#2563eb"
  style.bold: true

  total_tokens: "1024 Tokens\nTop-1 Routing"
  e6_load: "E6 收到 819 Tokens\n(其他 Expert 共 205)"
}

capacity_check: "Capacity 检查" {
  style.stroke: "#f59e0b"
  style.bold: true

  cf125: "CF = 1.25\nCapacity = 160\nOverflow = 659" {
    style.stroke: "#dc2626"
  }
  cf200: "CF = 2.0\nCapacity = 256\nOverflow = 563" {
    style.stroke: "#f59e0b"
  }
}

result_box: "结论" {
  style.stroke: "#dc2626"
  style.bold: true

  dropped: "增大 CF 减少了 Overflow\n但 819 Tokens 仍全部\n指向 E6 — 负载\n不均衡没有改变"
}

routing -> capacity_check
capacity_check -> result_box
