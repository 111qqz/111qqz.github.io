direction: right

grid-columns: 2

step_by_step: "逐步加噪" {
  style.stroke: "#2563eb"
  style.bold: true

  direction: down

  s0: "x₀\n(原始图片)"
  s1: "x₁" {
    style.stroke: "#f59e0b"
  }
  s2: "x₂" {
    style.stroke: "#f59e0b"
  }
  dots: "..." {
    style.stroke-dash: 4
  }
  st: "x_t\n(带噪图片)" {
    style.stroke: "#dc2626"
    style.bold: true
  }

  s0 -> s1: "+ε₁"
  s1 -> s2: "+ε₂"
  s2 -> dots: "+ε₃"
  dots -> st: "+ε_t"
}

direct_sample: "直接采样" {
  style.stroke: "#16a34a"
  style.bold: true

  direction: down

  d0: "x₀\n(原始图片)"
  spacer1: "" {
    style.opacity: 0
  }
  spacer2: "" {
    style.opacity: 0
  }
  spacer3: "" {
    style.opacity: 0
  }
  dt: "x_t\n(带噪图片)" {
    style.stroke: "#dc2626"
    style.bold: true
  }

  d0 -> dt: "√ᾱ_t · x₀ + √(1-ᾱ_t) · ε" {
    style.stroke: "#16a34a"
    style.bold: true
    style.stroke-width: 3
  }
}
