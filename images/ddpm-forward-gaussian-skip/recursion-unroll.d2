grid-columns: 2

step1: "① 代入展开\n\nx₂ = √α₂ · x₁ + √(1-α₂) · ε₂\n\n把 x₁ = √α₁·x₀ + √(1-α₁)·ε₁\n代入上式" {
  style.stroke: "#2563eb"
  style.bold: true
}

step2: "② 分离信号与噪声\n\n信号: √(α₁α₂) · x₀\n噪声: √(α₂(1-α₁))·ε₁ + √(1-α₂)·ε₂\n\nε₁, ε₂ 独立同分布 ~ N(0, I)" {
  style.stroke: "#f59e0b"
  style.bold: true
}

step3: "③ 计算噪声方差\n\nα₂(1-α₁) + (1-α₂)\n= α₂ - α₁α₂ + 1 - α₂\n= 1 - α₁α₂" {
  style.stroke: "#16a34a"
  style.bold: true
}

step4: "④ 高斯封闭性合并\n\n两个噪声 =d 一个噪声:\n√(1-α₁α₂) · ε\n\nx₂ =d √(α₁α₂)·x₀ + √(1-α₁α₂)·ε" {
  style.stroke: "#dc2626"
  style.bold: true
  style.stroke-width: 3
}

step1 -> step2
step2 -> step3
step3 -> step4
