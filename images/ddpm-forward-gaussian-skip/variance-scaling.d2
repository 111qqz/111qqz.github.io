direction: right

grid-columns: 3

original: "X ~ N(0, 1)\n标准差 σ = 1\n方差 σ² = 1" {
  style.stroke: "#2563eb"
  style.bold: true
}

arrow_box: "所有值 × 3\n偏差 × 3\n方差 × 3² = × 9" {
  style.stroke: "#f59e0b"
  style.bold: true
}

scaled: "3X ~ N(0, 9)\n标准差 σ = 3\n方差 σ² = 9" {
  style.stroke: "#dc2626"
  style.bold: true
}

rule: "Var(aX) = a² · Var(X)" {
  style.stroke-dash: 4
  style.font-size: 16
}

original -> arrow_box
arrow_box -> scaled
