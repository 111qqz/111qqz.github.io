direction: right

tensor: "输入 X: (B, C, H, W)" {
  style.stroke: "#2563eb"
  style.bold: true

  grid-columns: 2

  b0: "Sample b=0" {
    style.stroke: "#2563eb"

    grid-columns: 3

    c0_b0: "c₀\n[H×W]" {
      style.stroke: "#f59e0b"
      style.stroke-width: 3
      style.bold: true
    }
    c1_b0: "c₁\n[H×W]" {
      style.stroke-dash: 4
    }
    c2_b0: "c₂\n[H×W]" {
      style.stroke-dash: 4
    }
  }

  b1: "Sample b=1" {
    style.stroke: "#2563eb"

    grid-columns: 3

    c0_b1: "c₀\n[H×W]" {
      style.stroke: "#f59e0b"
      style.stroke-width: 3
      style.bold: true
    }
    c1_b1: "c₁\n[H×W]" {
      style.stroke-dash: 4
    }
    c2_b1: "c₂\n[H×W]" {
      style.stroke-dash: 4
    }
  }
}

stats: "Channel c₀ 的统计量\nμ, σ² 由 B×H×W 个\n高亮元素共同计算\n\n不同 Channel 各自独立" {
  style.stroke: "#f59e0b"
  style.bold: true
  style.stroke-width: 2
}

tensor.b0.c0_b0 -> stats: {style.stroke: "#f59e0b"; style.stroke-width: 2}
tensor.b1.c0_b1 -> stats: {style.stroke: "#f59e0b"; style.stroke-width: 2}
