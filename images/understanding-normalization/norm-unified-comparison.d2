grid-columns: 2

bn_box: "BatchNorm" {
  style.stroke: "#f59e0b"
  style.bold: true
  style.stroke-width: 2

  desc_bn: "固定 Channel\n统计 B, H, W" {
    style.stroke: "#f59e0b"
    style.bold: true
  }

  grid-columns: 3

  b0c0_bn: "b0 c₀\n[H×W]" {
    style.stroke: "#f59e0b"
    style.stroke-width: 3
    style.bold: true
  }
  b0c1_bn: "b0 c₁\n[H×W]" {
    style.stroke-dash: 4
  }
  b0c2_bn: "b0 c₂\n[H×W]" {
    style.stroke-dash: 4
  }
  b1c0_bn: "b1 c₀\n[H×W]" {
    style.stroke: "#f59e0b"
    style.stroke-width: 3
    style.bold: true
  }
  b1c1_bn: "b1 c₁\n[H×W]" {
    style.stroke-dash: 4
  }
  b1c2_bn: "b1 c₂\n[H×W]" {
    style.stroke-dash: 4
  }
}

