gn_box: "GroupNorm (G=2, C=6)：每组 3 个 Channel" {
  style.stroke: "#2563eb"
  style.bold: true
  style.stroke-width: 2

  grid-columns: 2

  group0: "Group 0" {
    style.stroke: "#f59e0b"
    style.stroke-width: 2
    style.bold: true

    ch0: "c₀ [H×W]"
    ch1: "c₁ [H×W]"
    ch2: "c₂ [H×W]"

    stat0: "μ₀, σ²₀ 由 3×H×W 元素计算" {
      style.stroke: "#f59e0b"
      style.bold: true
    }
  }

  group1: "Group 1" {
    style.stroke: "#16a34a"
    style.stroke-width: 2
    style.bold: true

    ch3: "c₃ [H×W]"
    ch4: "c₄ [H×W]"
    ch5: "c₅ [H×W]"

    stat1: "μ₁, σ²₁ 由 3×H×W 元素计算" {
      style.stroke: "#16a34a"
      style.bold: true
    }
  }
}

in_box: "InstanceNorm = GroupNorm (G=C=6)：每个 Channel 独立成组" {
  style.stroke: "#dc2626"
  style.bold: true
  style.stroke-width: 2

  grid-columns: 3

  g0: "c₀ [H×W]\nμ₀, σ²₀" {
    style.stroke: "#f59e0b"
    style.bold: true
  }
  g1: "c₁ [H×W]\nμ₁, σ²₁" {
    style.stroke: "#16a34a"
    style.bold: true
  }
  g2: "c₂ [H×W]\nμ₂, σ²₂" {
    style.stroke: "#2563eb"
    style.bold: true
  }
  g3: "c₃ [H×W]\nμ₃, σ²₃" {
    style.stroke: "#f59e0b"
    style.bold: true
  }
  g4: "c₄ [H×W]\nμ₄, σ²₄" {
    style.stroke: "#16a34a"
    style.bold: true
  }
  g5: "c₅ [H×W]\nμ₅, σ²₅" {
    style.stroke: "#2563eb"
    style.bold: true
  }
}

gn_box -> in_box: "G 增大到 C 时" {
  style.stroke: "#dc2626"
  style.bold: true
}
