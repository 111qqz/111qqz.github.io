trace: "Trace: 财报分析 Agent 执行过程" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
  style.bold: true

  grid-columns: 3

  planning: "Span 1: Planning\n分解用户请求\n确定执行步骤" {
    style.stroke: "#16a34a"
    style.stroke-width: 2
  }

  search: "Span 2: Search\n查找目标财报文档\n返回 PDF 链接" {
    style.stroke: "#16a34a"
    style.stroke-width: 2
  }

  extract: "Span 3: Extract\n提取营收数据\n输出: 120.5 万元" {
    style.stroke: "#dc2626"
    style.stroke-width: 3
    style.bold: true
  }

  generate: "Span 4: Generate\n生成分析摘要\n引用错误数字" {
    style.stroke: "#f59e0b"
    style.stroke-width: 2
  }

  write: "Span 5: Write\n写入报告系统\n错误数据落库" {
    style.stroke: "#f59e0b"
    style.stroke-width: 2
  }

  planning -> search
  search -> extract
  extract -> generate
  generate -> write
}

error_note: "错误根因定位\n原始财报: 营收 120.5 亿元\nExtract 输出: 120.5 万元\n单位在提取环节被错误转换" {
  style.stroke: "#dc2626"
  style.stroke-width: 2
  style.bold: true
  style.stroke-dash: 4
}

trace.extract -> error_note: "Trace 定位到此处" {
  style.stroke: "#dc2626"
  style.stroke-dash: 4
}
