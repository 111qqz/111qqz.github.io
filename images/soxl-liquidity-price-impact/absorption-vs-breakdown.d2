grid-columns: 2

absorption: "情景 A：买方吸收卖盘" {
  style.stroke: "#16a34a"
  a1: "① 初始状态\nBid \$100：80K 买单挂单" {
    style.stroke: "#2563eb"
  }
  a2: "② 卖盘持续涌入\n挂单消耗至 20K" {
    style.stroke: "#f59e0b"
  }
  a3: "③ 买方不断补单\n挂单恢复至 70K" {
    style.stroke: "#2563eb"
  }
  a4: "④ 结果：大量成交\n价格维持 \$100 附近\nDelta 接近平衡" {
    style.stroke: "#16a34a"
    style.bold: true
  }
  a1 -> a2 -> a3 -> a4
}

breakdown: "情景 B：买盘被击穿" {
  style.stroke: "#dc2626"
  b1: "① 初始状态\nBid \$100：80K 买单挂单" {
    style.stroke: "#2563eb"
  }
  b2: "② 卖盘持续涌入\n挂单消耗殆尽" {
    style.stroke: "#f59e0b"
  }
  b3: "③ 无新挂单补充\n订单簿出现真空" {
    style.stroke: "#dc2626"
  }
  b4: "④ 结果：价格跌穿 \$100\n向下寻找新的买家\nDelta 同样接近平衡" {
    style.stroke: "#dc2626"
    style.bold: true
  }
  b1 -> b2 -> b3 -> b4
}
