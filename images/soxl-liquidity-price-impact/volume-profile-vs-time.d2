grid-columns: 2

time_vol: "标准成交量柱状图" {
  style.stroke: "#2563eb"
  axes: "X 轴 = 时间\nY 轴 = 成交量（股数）" {
    style.stroke: "#6b7280"
  }
  question: "回答：某时间段\n成交了多少股" {
    style.stroke: "#2563eb"
  }
  example: "09:30–10:06\n累计 1076 万股\n（时间段粒度）" {
    style.stroke: "#2563eb"
  }
  limit: "看不到哪个价位\n成交最集中" {
    style.stroke: "#f59e0b"
  }
  axes -> question -> example -> limit
}

vol_profile: "Volume Profile（价格维度）" {
  style.stroke: "#16a34a"
  axes2: "Y 轴 = 价格\nX 轴 = 成交量（越长越多）" {
    style.stroke: "#6b7280"
  }
  question2: "回答：某价格区间\n成交了多少股" {
    style.stroke: "#16a34a"
  }
  example2: "\$100 价位：255K 股\n← POC（成交最密集价位）" {
    style.stroke: "#16a34a"
    style.bold: true
  }
  limit2: "不含时间信息\n只聚合价格与成交量" {
    style.stroke: "#f59e0b"
  }
  axes2 -> question2 -> example2 -> limit2
}
