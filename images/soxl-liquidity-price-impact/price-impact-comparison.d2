grid-columns: 2

thick_book: "买方流动性充足（盘口厚）" {
  style.stroke: "#16a34a"
  initial: "卖出前盘口\nBid \$100.00 : 30K 股\nBid \$99.98  : 40K 股\nBid \$99.96  : 50K 股"
  action: "卖出 10 万股\n市价单"
  result: "成交价区间：\n\$100.00 → \$99.96\n价格移动 4 分" {
    style.stroke: "#16a34a"
    style.bold: true
  }
  initial -> action -> result
}

thin_book: "买方流动性稀薄（盘口薄）" {
  style.stroke: "#dc2626"
  initial2: "卖出前盘口\nBid \$100.00 :  5K 股\nBid \$99.80  :  3K 股\nBid \$99.50  :  2K 股"
  action2: "卖出 10 万股\n市价单"
  result2: "成交价区间：\n\$100.00 → 远低于 \$99\n价格移动 100 分+" {
    style.stroke: "#dc2626"
    style.bold: true
  }
  initial2 -> action2 -> result2
}
