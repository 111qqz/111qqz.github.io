grid-columns: 2

active_buy: "主动买入（Taker）" {
  buyer: "买方主动下单\n不等待挂单成交" {
    style.stroke: "#2563eb"
    style.bold: true
  }
  ask_consumed: "消耗卖方挂单（Ask）\nAsk \$100.02：100 股" {
    style.stroke: "#dc2626"
  }
  trade_result: "成交价 = Ask\n卖方是 Maker\n买方是 Taker" {
    style.stroke: "#16a34a"
  }
  buyer -> ask_consumed: "吃单"
  ask_consumed -> trade_result: "撮合"
}

active_sell: "主动卖出（Taker）" {
  seller: "卖方主动下单\n不等待挂单成交" {
    style.stroke: "#dc2626"
    style.bold: true
  }
  bid_consumed: "消耗买方挂单（Bid）\nBid \$100.00：80 股" {
    style.stroke: "#2563eb"
  }
  trade_result2: "成交价 = Bid\n买方是 Maker\n卖方是 Taker" {
    style.stroke: "#16a34a"
  }
  seller -> bid_consumed: "吃单"
  bid_consumed -> trade_result2: "撮合"
}
