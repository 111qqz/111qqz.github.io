grid-columns: 2

stage_observe: "观察阶段" {
  style.stroke: "#2563eb"
  a1: "① 发现成交统计异常\nDelta 平衡但价格有明显变化" {
    style.stroke: "#2563eb"
    style.bold: true
  }
  a2: "② 观察价格响应\n价位是否跌穿？维持多久？" {
    style.stroke: "#2563eb"
  }
  a1 -> a2
}

stage_decide: "分析与决策阶段" {
  style.stroke: "#16a34a"
  b1: "③ 提出流动性假设\n买方吸收 / 击穿 / 真空？" {
    style.stroke: "#f59e0b"
  }
  b2: "④ 结合价格结构验证\n订单簿 + K 线 + 时间序列" {
    style.stroke: "#f59e0b"
  }
  b3: "⑤ 制定观察或交易计划\n先验证，再决策" {
    style.stroke: "#16a34a"
    style.bold: true
  }
  b1 -> b2 -> b3
}

stage_observe -> stage_decide
