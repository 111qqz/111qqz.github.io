direction: down

LP: "低精度 dtype" {
  style.bold: true
  style.stroke-width: 3
  style.stroke: "#2563eb"
}

S: "Storage ↓" { style.stroke: "#16a34a" }
BW: "Memory\nBandwidth ↓" { style.stroke: "#16a34a" }
CF: "Cache\nFootprint ↓" { style.stroke: "#16a34a" }
CM: "Communication ↓" { style.stroke: "#16a34a" }
TP: "Tensor Core\nThroughput ↑" { style.stroke: "#16a34a" }

LP -> S
LP -> BW
LP -> CF
LP -> CM
LP -> TP
