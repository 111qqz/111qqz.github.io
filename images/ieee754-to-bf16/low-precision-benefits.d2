direction: down

LP: "低精度 dtype" {
  style.bold: true
  style.stroke-width: 3
  style.stroke: blue
}

S: "Storage ↓" { style.stroke: green }
BW: "Memory Bandwidth ↓" { style.stroke: green }
CF: "Cache Footprint ↓" { style.stroke: green }
CM: "Communication ↓" { style.stroke: green }
TP: "Tensor Core Throughput ↑" { style.stroke: green }

LP -> S
LP -> BW
LP -> CF
LP -> CM
LP -> TP
