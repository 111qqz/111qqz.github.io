direction: down

FMT: "Floating-point Format" {
  style.bold: true
  style.stroke-width: 3
  style.stroke: blue
}

EXP: "Exponent bits"
FRAC: "Fraction bits"

DR: "Dynamic Range\noverflow / underflow"
PREC: "Precision\nrounding error"

SYS: "System Cost"
STOR: "Storage"
BW2: "Bandwidth"
COMP: "Compute Throughput"

ARITH: "Arithmetic Details"
MULT: "Multiply Precision"
ACC: "Accumulator Precision"

FMT -> EXP
FMT -> FRAC

EXP -> DR
FRAC -> PREC

FMT -> SYS
SYS -> STOR
SYS -> BW2
SYS -> COMP

FMT -> ARITH
ARITH -> MULT
ARITH -> ACC
