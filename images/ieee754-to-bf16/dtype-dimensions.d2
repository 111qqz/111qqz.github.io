direction: right

FMT: "Floating-point Format" {
  style.bold: true
  style.stroke-width: 3
  style.stroke: "#2563eb"
}

numeric: 数值维度 {
  direction: right
  EXP: "Exponent bits"
  FRAC: "Fraction bits"
  DR: "Dynamic Range\noverflow / underflow"
  PREC: "Precision\nrounding error"
  EXP -> DR
  FRAC -> PREC
}

sys: 系统成本 {
  direction: right
  SYS: "System Cost"
  STOR: "Storage"
  BW2: "Bandwidth"
  COMP: "Compute Throughput"
  SYS -> STOR
  SYS -> BW2
  SYS -> COMP
}

arith: 算术细节 {
  direction: right
  ARITH: "Arithmetic Details"
  MULT: "Multiply Precision"
  ACC: "Accumulator Precision"
  ARITH -> MULT
  ARITH -> ACC
}

FMT -> numeric
FMT -> sys
FMT -> arith
