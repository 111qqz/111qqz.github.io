direction: right

user: "用户行为\n填写 request" 
scheduler: "Quota 检查\nScheduler"
job: "训练任务\n运行"
usage: "实际资源使用\n（周期性采样）" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
}
score: "Usage Score\nUser Reputation" {
  style.stroke: "#f59e0b"
  style.bold: true
}
quota: "下一轮\nQuota 系数" {
  style.stroke: "#dc2626"
  style.bold: true
}

user -> scheduler: "Resource Request"
scheduler -> job: "分配资源"
job -> usage: "采样"
usage -> score: "按任务聚合"
score -> quota: "周期性刷新"
quota -> user: "改变下一轮策略" {
  style.stroke-dash: 4
}
