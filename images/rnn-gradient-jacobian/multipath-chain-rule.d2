grid-columns: 2

single: "单路径：沿路径相乘" {
  direction: down
  x_node: x {
    shape: circle
  }
  y_node: y {
    shape: circle
  }
  loss_node: L {
    shape: circle
    style.bold: true
  }
  x_node -> y_node: "∂y/∂x"
  y_node -> loss_node: "∂L/∂y"
}

multi: "多路径：沿路径乘，跨路径加\n（贡献可正可负）" {
  direction: down
  x_node: x {
    shape: circle
  }
  y0_node: "y₀" {
    shape: circle
  }
  y1_node: "y₁" {
    shape: circle
  }
  loss_node: L {
    shape: circle
    style.bold: true
  }
  x_node -> y0_node: "∂y₀/∂x"
  x_node -> y1_node: "∂y₁/∂x"
  y0_node -> loss_node: "∂L/∂y₀"
  y1_node -> loss_node: "∂L/∂y₁"
}
