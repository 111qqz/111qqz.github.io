direction: down

h_prev: "h_{t-1}" { shape: cylinder; style.stroke: "#16a34a" }
x: "x_t" { shape: parallelogram; style.stroke: "#2563eb" }

r: "r_t (Reset)" { shape: oval }
z: "z_t (Update)" { shape: oval }

h_reset: "r_t ⊙ h_{t-1}"
h_tilde: "h̃_t (Candidate)" { shape: oval }

h_curr: "h_t" { shape: cylinder; style.stroke: "#16a34a" }

h_prev -> r
x -> r
h_prev -> z
x -> z

r -> h_reset
h_prev -> h_reset
h_reset -> h_tilde
x -> h_tilde

h_tilde -> h_curr: "⊙ z_t"
h_prev -> h_curr: "⊙ (1-z_t)"
