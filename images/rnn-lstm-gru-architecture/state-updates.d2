direction: right

vanilla: Vanilla RNN {
  shape: package
  style: {
    stroke: "#dc2626"
    stroke-width: 2
  }
  
  h_prev: "h_{t-1}" { shape: cylinder; style.stroke: "#16a34a" }
  x: "x_t" { shape: parallelogram; style.stroke: "#2563eb" }
  h_curr: "h_t" { shape: cylinder; style.stroke: "#16a34a" }
  
  concat: Concat & Linear
  act: tanh { shape: oval }
  
  h_prev -> concat
  x -> concat
  concat -> act
  act -> h_curr
}

lstm: LSTM (Content vs Control) {
  shape: package
  style: {
    stroke: "#2563eb"
    stroke-width: 2
  }
  
  c_prev: "c_{t-1}" { shape: cylinder; style.stroke: "#16a34a" }
  h_prev: "h_{t-1}" { shape: cylinder; style.stroke: "#16a34a" }
  x: "x_t" { shape: parallelogram; style.stroke: "#2563eb" }
  
  concat: Concat & Linear
  
  f: "f_t (Forget)" { shape: oval }
  i: "i_t (Input)" { shape: oval }
  c_tilde: "\tilde{c}_t (Content)" { shape: oval }
  o: "o_t (Output)" { shape: oval }
  
  c_curr: "c_t" { shape: cylinder; style.stroke: "#16a34a" }
  h_curr: "h_t" { shape: cylinder; style.stroke: "#16a34a" }
  
  h_prev -> concat
  x -> concat
  
  concat -> f
  concat -> i
  concat -> c_tilde
  concat -> o
  
  c_prev -> c_curr: "\odot f_t"
  c_tilde -> c_curr: "\odot i_t"
  c_curr -> h_curr: "\tanh \odot o_t"
}

gru: GRU (Interpolation) {
  shape: package
  style: {
    stroke: "#f59e0b"
    stroke-width: 2
  }
  
  h_prev: "h_{t-1}" { shape: cylinder; style.stroke: "#16a34a" }
  x: "x_t" { shape: parallelogram; style.stroke: "#2563eb" }
  
  r: "r_t (Reset)" { shape: oval }
  z: "z_t (Update)" { shape: oval }
  
  h_reset: "r_t \odot h_{t-1}"
  h_tilde: "\tilde{h}_t (Content)" { shape: oval }
  
  h_curr: "h_t" { shape: cylinder; style.stroke: "#16a34a" }
  
  h_prev -> r
  x -> r
  h_prev -> z
  x -> z
  
  r -> h_reset
  h_prev -> h_reset
  h_reset -> h_tilde
  x -> h_tilde
  
  h_tilde -> h_curr: "\odot z_t"
  h_prev -> h_curr: "\odot (1-z_t)"
}

vanilla -> lstm: "Evolution" { style.stroke-dash: 4 }
lstm -> gru: "Evolution" { style.stroke-dash: 4 }
