direction: right

a: "A"
b: "B"
c: "C"

h1: "h₁\n第 1 个被计算\n只看得到 A" {
  style.stroke: "#2563eb"
}
h2: "h₂\n第 2 个被计算\n看得到 A、B" {
  style.stroke: "#2563eb"
}
h3: "h₃\n第 3 个被计算\n看得到 A、B、C" {
  style.stroke: "#2563eb"
}

a -> h1
b -> h2
c -> h3

h1 -> h2: "recurrent path" {
  style.stroke: "#dc2626"
  style.bold: true
}
h2 -> h3 {
  style.stroke: "#dc2626"
  style.bold: true
}
