direction: down

step1: {
  direction: right
  style.stroke: transparent
  a: "A"
  h1: "h₁\n第 1 个被计算\n只看得到 A" { style.stroke: "#2563eb" }
  a -> h1
}

step2: {
  direction: right
  style.stroke: transparent
  b: "B"
  h2: "h₂\n第 2 个被计算\n看得到 A、B" { style.stroke: "#2563eb" }
  b -> h2
}

step3: {
  direction: right
  style.stroke: transparent
  c: "C"
  h3: "h₃\n第 3 个被计算\n看得到 A、B、C" { style.stroke: "#2563eb" }
  c -> h3
}

step1.h1 -> step2.h2: "recurrent path" {
  style.stroke: "#dc2626"
  style.bold: true
}
step2.h2 -> step3.h3 {
  style.stroke: "#dc2626"
  style.bold: true
}
