direction: right

a: "A" {
  style.bold: true
  style.stroke-width: 3
}
b: "B" {
  style.bold: true
  style.stroke-width: 3
}
c: "C" {
  style.bold: true
  style.stroke-width: 3
}

a <-> b: "按内容交互" {
  style.stroke: "#2563eb"
}
b <-> c {
  style.stroke: "#2563eb"
}
a <-> c {
  style.stroke: "#2563eb"
}
