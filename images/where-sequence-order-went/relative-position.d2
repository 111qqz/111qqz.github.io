grid-columns: 2

a: "A"
b: "B"
c: "C\n（读取方）" {
  style.stroke: "#2563eb"
  style.bold: true
  style.stroke-width: 3
}
d: "D"

a -- b
b -- c
c -- d

c -> a: "前面 2 格" {
  style.stroke: "#f59e0b"
  style.bold: true
}
c -> b: "前面 1 格" {
  style.stroke: "#f59e0b"
}
c -> d: "后面 1 格" {
  style.stroke: "#f59e0b"
}
