direction: down

pe: "PE = P / E" {
  style.stroke: "#7c3aed"
  style.bold: true
}

price: "P：今天的市场价格\n内容却是对未来的预期\n增长 / 盈利持续性 / 风险 / 利率与要求回报率" {
  style.stroke: "#2563eb"
  style.bold: true
}

earnings: "E：某个会计窗口的利润\n上一年度（静态 PE）\n最近十二个月（TTM PE）\n未来预测（Forward PE）" {
  style.stroke: "#16a34a"
  style.bold: true
}

price -> pe: "分子"
earnings -> pe: "分母"
