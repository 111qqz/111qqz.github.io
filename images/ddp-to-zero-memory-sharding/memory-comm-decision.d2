direction: down

comm_section: "每卡理论发送数据量 (理想 Ring)" {
  style.stroke: "#2563eb"
  style.bold: true
  grid-columns: 3

  ddp_comm: "DDP\n21 GB" {
    style.stroke: "#dc2626"
    style.bold: true
  }
  z2_comm: "ZeRO-2\n21 GB" {
    style.stroke: "#f59e0b"
    style.bold: true
  }
  z3_comm: "ZeRO-3\n31.5 GB" {
    style.stroke: "#16a34a"
    style.bold: true
  }
}

exp_section: "假设性工程实验 (4 × 80 GiB GPU)" {
  style.stroke: "#f59e0b"
  style.bold: true
  grid-columns: 2

  z2_exp: "ZeRO-2\n峰值 58 GiB\n1000 samples/s" {
    style.stroke: "#16a34a"
    style.bold: true
  }
  z3_exp: "ZeRO-3\n峰值 45 GiB\n850 samples/s" {
    style.stroke: "#dc2626"
    style.bold: true
  }
}

comm_section -> exp_section: "通信量接近 ≠ 耗时接近"

decision: "选择标准:\n显存能否放下 + 实际吞吐量\n而不是 Stage 越高越好" {
  style.stroke-dash: 4
  style.bold: true
}

exp_section -> decision
