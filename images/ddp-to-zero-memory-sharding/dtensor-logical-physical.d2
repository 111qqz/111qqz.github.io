direction: right

logical: "W\nGlobal Shape: (8, 4)" {
  style.stroke: "#2563eb"
  style.stroke-width: 3
  style.bold: true

  r01: "Row 0–1" {
    style.stroke: "#2563eb"
  }
  r23: "Row 2–3" {
    style.stroke: "#16a34a"
  }
  r45: "Row 4–5" {
    style.stroke: "#f59e0b"
  }
  r67: "Row 6–7" {
    style.stroke: "#dc2626"
  }
}

logical -> physical: "Shard(0)\n沿第 0 维切分"

physical: "物理分片" {
  grid-columns: 2

  gpu0: "GPU 0\nLocal: (2, 4)\nRow 0–1" {
    style.stroke: "#2563eb"
    style.stroke-width: 2
    style.bold: true
  }
  gpu1: "GPU 1\nLocal: (2, 4)\nRow 2–3" {
    style.stroke: "#16a34a"
    style.stroke-width: 2
    style.bold: true
  }
  gpu2: "GPU 2\nLocal: (2, 4)\nRow 4–5" {
    style.stroke: "#f59e0b"
    style.stroke-width: 2
    style.bold: true
  }
  gpu3: "GPU 3\nLocal: (2, 4)\nRow 6–7" {
    style.stroke: "#dc2626"
    style.stroke-width: 2
    style.bold: true
  }
}
