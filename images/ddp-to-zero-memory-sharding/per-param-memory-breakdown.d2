direction: down

params: "Parameters (BF16)  2 bytes" {
  style.stroke: "#2563eb"
  style.bold: true
}

grads: "Gradients (BF16)  2 bytes" {
  style.stroke: "#16a34a"
  style.bold: true
}

os_group: "Optimizer States  12 bytes" {
  style.stroke: "#dc2626"
  style.bold: true
  style.stroke-width: 3

  mw: "FP32 Master Weights  4 bytes" {
    style.stroke: "#dc2626"
  }
  m_moment: "Adam m (first moment)  4 bytes" {
    style.stroke: "#dc2626"
  }
  v_moment: "Adam v (second moment)  4 bytes" {
    style.stroke: "#dc2626"
  }
}

summary: "合计 16 bytes/param\nOptimizer States 占 75%" {
  style.stroke: "#f59e0b"
  style.bold: true
  style.stroke-dash: 4
}

params -> grads
grads -> os_group
os_group -> summary
