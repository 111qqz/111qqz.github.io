grid-columns: 2

pipeline_side: "Pipeline Parallelism" {
  style.stroke: "#f59e0b"
  style.bold: true
  grid-columns: 2

  pp_g0: "GPU 0\nLayer 0\n完整权重" {
    style.stroke: "#2563eb"
    style.bold: true
  }
  pp_g1: "GPU 1\nLayer 1\n完整权重" {
    style.stroke: "#2563eb"
    style.bold: true
  }
  pp_g2: "GPU 2\nLayer 2\n完整权重" {
    style.stroke: "#2563eb"
    style.bold: true
  }
  pp_g3: "GPU 3\nLayer 3\n完整权重" {
    style.stroke: "#2563eb"
    style.bold: true
  }
  pp_note: "按 Layer 划分\n计算和存储" {
    style.stroke-dash: 4
  }
}

zero3_side: "ZeRO-3" {
  style.stroke: "#16a34a"
  style.bold: true
  grid-columns: 2

  z3_g0: "GPU 0\n[w₀, w₁]" {
    style.stroke: "#dc2626"
    style.bold: true
  }
  z3_g1: "GPU 1\n[w₂, w₃]" {
    style.stroke: "#dc2626"
    style.bold: true
  }
  z3_g2: "GPU 2\n[w₄, w₅]" {
    style.stroke: "#dc2626"
    style.bold: true
  }
  z3_g3: "GPU 3\n[w₆, w₇]" {
    style.stroke: "#dc2626"
    style.bold: true
  }
  z3_note: "同一 Layer 参数跨 GPU\n每 GPU 仍做完整计算" {
    style.stroke-dash: 4
  }
}
