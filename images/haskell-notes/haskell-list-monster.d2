direction: down

list_box: "Haskell 列表结构: [5, 4, 3, 2, 1]" {
  style.stroke: "#6366f1"
  style.bold: true

  grid-columns: 5
  grid-gap: 15

  e1: "5" { style.stroke: "#2563eb"; style.bold: true }
  e2: "4" { style.stroke: "#0891b2" }
  e3: "3" { style.stroke: "#0891b2" }
  e4: "2" { style.stroke: "#0891b2" }
  e5: "1" { style.stroke: "#f59e0b"; style.bold: true }
}

head_tail: "前端分割操作 (Head 与 Tail)" {
  style.stroke: "#2563eb"
  direction: right
  op_head: "head [5,4,3,2,1] => 5\n获取列表首个元素" {
    shape: rectangle
    style.stroke: "#2563eb"
    style.bold: true
  }
  op_tail: "tail [5,4,3,2,1] => [4,3,2,1]\n切除首元素后剩余的列表" {
    shape: rectangle
    style.stroke: "#0891b2"
    style.bold: true
  }
}

init_last: "末端分割操作 (Init 与 Last)" {
  style.stroke: "#f59e0b"
  direction: right
  op_init: "init [5,4,3,2,1] => [5,4,3,2]\n切除末尾元素后前部的列表" {
    shape: rectangle
    style.stroke: "#0891b2"
    style.bold: true
  }
  op_last: "last [5,4,3,2,1] => 1\n获取列表最后一个元素" {
    shape: rectangle
    style.stroke: "#f59e0b"
    style.bold: true
  }
}

list_box -> head_tail
list_box -> init_last
