grid-columns: 2

full_ft: "Full Fine-Tuning" {
  style.stroke: "#dc2626"
  style.bold: true
  style.stroke-width: 2

  w0: "W₀\n(4096 × 4096)\n可训练" {
    style.stroke: "#dc2626"
    style.bold: true
    style.stroke-width: 2
  }

  delta_w: "ΔW\n(4096 × 4096)\n~1678 万参数" {
    style.stroke: "#dc2626"
    style.bold: true
    style.stroke-width: 2
  }

  w0 -> delta_w: "全部参数\n都需要梯度\n和 Optimizer States" {
    style.stroke: "#dc2626"
    style.stroke-width: 2
  }
}

lora: "LoRA" {
  style.stroke: "#2563eb"
  style.bold: true
  style.stroke-width: 2

  w0_frozen: "W₀\n(4096 × 4096)\n冻结，不训练" {
    style.stroke-dash: 4
    style.stroke-width: 2
  }

  mat_b: "B\n(4096 × 16)" {
    style.stroke: "#2563eb"
    style.bold: true
    style.stroke-width: 3
  }

  mat_a: "A\n(16 × 4096)" {
    style.stroke: "#16a34a"
    style.bold: true
    style.stroke-width: 3
  }

  mat_b -> mat_a: "ΔW = BA\n只需 ~13 万参数\n(1/128)" {
    style.stroke: "#f59e0b"
    style.stroke-width: 2
    style.bold: true
  }
}
