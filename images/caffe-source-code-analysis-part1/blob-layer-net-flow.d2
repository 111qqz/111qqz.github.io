direction: down

net: Net（Layer 组成的 DAG） {
  direction: down

  b1: Blob {
    data: data（前向数据）
    diff: diff（反向梯度）
  }
  l1: Layer
  b2: Blob {
    data: data（前向数据）
    diff: diff（反向梯度）
  }
  l2: Layer
  b3: Blob {
    data: data（前向数据）
    diff: diff（反向梯度）
  }

  b1 -> l1: bottom
  l1 -> b2: top
  b2 -> l2: bottom
  l2 -> b3: top

  b1.style.stroke: "#16a34a"
  b2.style.stroke: "#16a34a"
  b3.style.stroke: "#16a34a"
  l1.style.stroke: "#2563eb"
  l2.style.stroke: "#2563eb"
  l1.style.bold: true
  l2.style.bold: true
}
