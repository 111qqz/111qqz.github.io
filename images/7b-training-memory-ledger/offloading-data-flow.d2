direction: right

gpu: "GPU HBM ≈ 30.5 GB" {
  style.stroke: "#2563eb"
  style.bold: true
  style.stroke-width: 3

  grid-columns: 2

  p: "BF16 Params\n14 GB"
  g: "BF16 Grads\n14 GB"
  act: "Ckpt Activations\n0.5 GB"
  overhead_item: "Overhead\n~2 GB"
}

cpu_mem: "CPU RAM 84 GB" {
  style.stroke: "#f59e0b"
  style.bold: true
  style.stroke-width: 3

  mw: "FP32 Master Weights\n28 GB"
  am: "FP32 Adam m\n28 GB"
  av: "FP32 Adam v\n28 GB"
}

nvme: "NVMe SSD\nTB 级容量" {
  style.stroke: "#16a34a"
  style.bold: true

  data: "更大规模\n数据/状态"
}

gpu <-> cpu_mem: "PCIe 4.0\n~32 GB/s" {
  style.stroke-dash: 4
}
cpu_mem <-> nvme: "NVMe\n~3-7 GB/s" {
  style.stroke-dash: 4
}
