direction: down

state_input: "State s_t\n(Agent position, grid layout)" {
  style.stroke: "#2563eb"
  style.bold: true
  style.stroke-width: 3
}

nn: "Neural Network (Policy pi_theta)" {
  style.stroke: "#f59e0b"
  style.bold: true
  style.stroke-width: 3
}

probs: "Action Probabilities" {
  style.stroke: "#16a34a"
  style.bold: true

  grid-columns: 4

  up_node: "Up\n0.1" { style.stroke: "#94a3b8" }
  down_node: "Down\n0.2" { style.stroke: "#94a3b8" }
  left_node: "Left\n0.1" { style.stroke: "#94a3b8" }
  right_node: "Right\n0.6" {
    style.stroke: "#16a34a"
    style.stroke-width: 3
    style.bold: true
  }
}

state_input -> nn: "encode"
nn -> probs: "softmax"
