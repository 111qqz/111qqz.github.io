path_a: "Path A: shortcut near trap" {
  style.stroke: "#dc2626"
  style.bold: true

  grid-columns: 5

  s1a: "Step 1\nr = -1" { style.stroke: "#94a3b8" }
  s2a: "Step 2\nr = -1" { style.stroke: "#94a3b8" }
  s3a: "Step 3\nr = -1" { style.stroke: "#94a3b8" }
  s4a: "Step 4 (trap)\nr = -10" {
    style.stroke: "#dc2626"
    style.bold: true
    style.stroke-width: 3
  }
  result_a: "G = -13" {
    style.stroke: "#dc2626"
    style.bold: true
    style.stroke-width: 3
  }

  s1a -> s2a -> s3a -> s4a -> result_a
}

path_b: "Path B: detour around trap" {
  style.stroke: "#16a34a"
  style.bold: true

  grid-columns: 5

  s1b: "Step 1~3\n(r = -1 each)" { style.stroke: "#94a3b8" }
  s4b: "Step 4~6\n(r = -1 each)" { style.stroke: "#94a3b8" }
  s7b: "Step 7 (goal)\nr = +10" {
    style.stroke: "#16a34a"
    style.bold: true
    style.stroke-width: 3
  }
  result_b: "G = +4" {
    style.stroke: "#16a34a"
    style.bold: true
    style.stroke-width: 3
  }

  s1b -> s4b -> s7b -> result_b
}

path_a -> path_b: "same starting position" {
  style.stroke-dash: 4
}
