grid-columns: 2

sl: "Supervised Learning" {
  style.stroke: "#2563eb"
  style.bold: true

  input: "Input x" {
    style.bold: true
  }
  model: "Model f_theta" {
    style.stroke: "#2563eb"
    style.stroke-width: 3
  }
  pred: "Prediction y-hat"
  target_label: "External Label y" {
    style.stroke: "#16a34a"
    style.bold: true
  }
  loss: "Loss L(y-hat, y)\n-> Gradient\n-> Update theta" {
    style.stroke: "#dc2626"
    style.bold: true
  }

  input -> model -> pred
  target_label -> loss
  pred -> loss
}

rl: "Reinforcement Learning" {
  style.stroke: "#f59e0b"
  style.bold: true

  state: "State s_t" {
    style.bold: true
  }
  agent: "Agent (Policy)" {
    style.stroke: "#f59e0b"
    style.stroke-width: 3
    style.bold: true
  }
  action: "Action a_t"
  env: "Environment" {
    style.stroke: "#16a34a"
    style.stroke-width: 3
  }
  reward: "Reward r_{t+1}" {
    style.stroke: "#dc2626"
    style.bold: true
  }
  next_state: "Next State s_{t+1}"

  state -> agent -> action -> env
  env -> reward
  env -> next_state
  next_state -> state: "next step" {
    style.stroke-dash: 4
  }
}
