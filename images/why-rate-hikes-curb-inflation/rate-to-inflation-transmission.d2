direction: right

fed: "美联储加息\n政策利率 ↑" {
  style.stroke: "#2563eb"
  style.bold: true
  style.stroke-width: 3
}

household: "居民端" {
  style.stroke: "#f59e0b"
  style.stroke-width: 2

  mortgage: "房贷利率 ↑\n→ 购房成本大增\n→ 部分家庭推迟买房"
  saving: "存款利率 ↑\n→ 储蓄吸引力增加\n→ 推迟部分消费"
}

biz: "企业端" {
  style.stroke: "#f59e0b"
  style.stroke-width: 2

  cost: "贷款、发债成本 ↑\n→ 扩张计划放缓\n→ 招聘减少"
}

demand_down: "总需求\n减弱" {
  style.bold: true
  style.stroke: "#dc2626"
  style.stroke-width: 3
}

inflation_ease: "涨价压力\n下降" {
  style.bold: true
  style.stroke: "#16a34a"
  style.stroke-width: 3
}

fed -> household
fed -> biz
household.mortgage -> demand_down
household.saving -> demand_down
biz.cost -> demand_down
demand_down -> inflation_ease
