fed_center: "美联储" {
  style.stroke: "#2563eb"
  style.bold: true
  style.stroke-width: 3
}

price_stable: "物价稳定\n长期通胀目标 ≈ 2%（PCE）" {
  style.stroke: "#16a34a"
  style.bold: true
  style.stroke-width: 2
}

employment: "充分就业\n劳动力市场健康运转" {
  style.stroke: "#f59e0b"
  style.bold: true
  style.stroke-width: 2
}

overshoot: "加息过猛\n→ 需求崩塌\n→ 企业裁员、经济衰退" {
  style.stroke: "#dc2626"
  style.stroke-width: 2
}

undershoot: "宽松过度\n→ 需求过热\n→ 通胀失控" {
  style.stroke: "#dc2626"
  style.stroke-width: 2
}

fed_center -> price_stable: "加息抑制通胀" {
  style.stroke: "#16a34a"
}
fed_center -> employment: "降息支持就业" {
  style.stroke: "#f59e0b"
}
price_stable -> overshoot: "但如果走过头" {
  style.stroke: "#dc2626"
  style.stroke-dash: 4
}
employment -> undershoot: "但如果走过头" {
  style.stroke: "#dc2626"
  style.stroke-dash: 4
}
