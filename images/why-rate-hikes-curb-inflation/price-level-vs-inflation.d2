grid-columns: 2

price_path: "价格指数（持续上升）" {
  style.stroke: "#dc2626"
  style.bold: true
  style.stroke-width: 2

  p0: "基期：100" {
    style.stroke: "#2563eb"
    style.bold: true
  }
  p1: "第 1 年：110" {
    style.stroke: "#dc2626"
  }
  p2: "第 2 年：115.5" {
    style.stroke: "#dc2626"
  }
  p3: "第 3 年：118.4" {
    style.stroke: "#dc2626"
  }

  p0 -> p1: "+10"
  p1 -> p2: "+5.5"
  p2 -> p3: "+2.9"
}

inflation_path: "通胀率（逐年下降）" {
  style.stroke: "#16a34a"
  style.bold: true
  style.stroke-width: 2

  i1: "第 1 年：10%" {
    style.stroke: "#dc2626"
    style.bold: true
    style.stroke-width: 2
  }
  i2: "第 2 年：5%" {
    style.stroke: "#f59e0b"
    style.bold: true
  }
  i3: "第 3 年：2.5%" {
    style.stroke: "#16a34a"
    style.bold: true
  }

  i1 -> i2: "放缓" {
    style.stroke: "#f59e0b"
  }
  i2 -> i3: "继续放缓" {
    style.stroke: "#16a34a"
  }
}
