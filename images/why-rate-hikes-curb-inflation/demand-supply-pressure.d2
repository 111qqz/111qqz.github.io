grid-columns: 2

hot: "需求旺盛时" {
  style.stroke: "#dc2626"
  style.bold: true
  style.stroke-width: 2

  supply_a: "供给能力\n（短期不变）" {
    style.stroke: "#2563eb"
  }
  demand_a: "需求强劲\n消费者抢购、企业扩张" {
    style.stroke: "#dc2626"
    style.bold: true
  }
  pressure_a: "涨价压力大\n卖家有定价权" {
    style.stroke: "#dc2626"
    style.stroke-width: 3
    style.bold: true
  }

  supply_a -> pressure_a: "产能接近上限"
  demand_a -> pressure_a: "买家多于卖家"
}

cool: "需求收缩后" {
  style.stroke: "#16a34a"
  style.bold: true
  style.stroke-width: 2

  supply_b: "供给能力\n（短期不变）" {
    style.stroke: "#2563eb"
  }
  demand_b: "需求减弱\n消费推迟、投资放缓" {
    style.stroke: "#16a34a"
    style.bold: true
  }
  pressure_b: "涨价压力减轻\n卖家被迫让利" {
    style.stroke: "#16a34a"
    style.stroke-width: 3
    style.bold: true
  }

  supply_b -> pressure_b: "产能有富余"
  demand_b -> pressure_b: "买家观望"
}
