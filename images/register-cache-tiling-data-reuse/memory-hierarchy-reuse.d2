grid-rows: 2
grid-columns: 2

dram: "DRAM\nGB 级, ~100 ns" {
  style.stroke: "#dc2626"
  style.bold: true
}
cache: "Cache (L3 / L2 / L1)\n数十 MB → 48 KB\n30 → 4 ns" {
  style.stroke: "#f59e0b"
  style.bold: true
}
reg: "Registers\n~1 KB, < 1 ns" {
  style.stroke: "#2563eb"
  style.bold: true
}
compute: "Compute (ALU / FMA)" {
  style.stroke: "#2563eb"
  style.bold: true
  style.stroke-width: 3
}

dram -> cache: "Cache Tiling" {
  style.stroke: "#f59e0b"
  style.stroke-dash: 4
}
cache -> reg: "Register Tiling" {
  style.stroke: "#2563eb"
  style.stroke-dash: 4
}
reg -> compute
