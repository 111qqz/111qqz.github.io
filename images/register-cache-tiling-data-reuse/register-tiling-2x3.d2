load_a: "加载 A 元素 (2 个)" {
  style.stroke: "#2563eb"
  a0: "a0 = A[i][k]"
  a1: "a1 = A[i+1][k]"
}

load_b: "加载 B 元素 (3 个)" {
  style.stroke: "#16a34a"
  b0: "b0 = B[k][j]"
  b1: "b1 = B[k][j+1]"
  b2: "b2 = B[k][j+2]"
}

tile: "2×3 Output Tile\n(6 个寄存器累加器)" {
  style.stroke: "#f59e0b"
  style.bold: true
  grid-columns: 3
  c00: "c00 += a0 × b0"
  c01: "c01 += a0 × b1"
  c02: "c02 += a0 × b2"
  c10: "c10 += a1 × b0"
  c11: "c11 += a1 × b1"
  c12: "c12 += a1 × b2"
}

load_a -> tile: "每个 a 复用 3 次" {
  style.stroke: "#2563eb"
}
load_b -> tile: "每个 b 复用 2 次" {
  style.stroke: "#16a34a"
}
