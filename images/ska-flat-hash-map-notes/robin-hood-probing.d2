direction: down

insert: "插入 C：home(C) = slot i\nC 的 PSL = 0"

probe_i: "slot i 已被 A 占据\nA 的 PSL = 0，C 的 PSL = 0\nPSL 相等，不交换，继续探测"

probe_i1: "slot i+1 已被 B 占据\nB 的 PSL = 0 小于 C 的 PSL = 1\n交换：C 落位，B 被换出"

c_placed: "C 落在 slot i+1\n插入完成"

displaced: "B 带着 PSL = 1 继续向后探测\n直到遇到空槽或达到 max_lookups"

empty: "B 落到后面的空槽"

insert -> probe_i
probe_i -> probe_i1
probe_i1 -> c_placed
probe_i1 -> displaced
displaced -> empty

insert.style.stroke: "#2563eb"
probe_i1.style.stroke: "#f59e0b"
probe_i1.style.bold: true
empty.style.stroke: "#16a34a"
