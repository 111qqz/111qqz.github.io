direction: down

train: "pytorch 等训练框架\n训练得到的 model" {
  style.stroke: "#2563eb"
}

convert: "模型转换"

caffe: "caffe model\n业界中间表示" {
  style.bold: true
  style.stroke-width: 3
  style.stroke: "#2563eb"
}

hardware: "目标硬件平台" {
  style.stroke-dash: 4

  nvidia: "NVIDIA 系列显卡"
  hisilicon: "华为海思系列设备"
  others: "其他硬件平台"
}

train -> convert
convert -> caffe
caffe -> hardware.nvidia
caffe -> hardware.hisilicon
caffe -> hardware.others
