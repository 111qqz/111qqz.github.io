direction: down

x1: "x₁"
x2: "x₂"
x3: "x₃"
h1: "h₁"
h2: "h₂"
h3: "h₃"
p1: "predict x₂"
p2: "predict x₃"
p3: "predict x₄"
L1: "loss₁" { style.stroke: red }
L2: "loss₂" { style.stroke: red }
L3: "loss₃" { style.stroke: red }

x1 -> h1
x2 -> h2
x3 -> h3
h1 -> h2
h2 -> h3
h1 -> p1
h2 -> p2
h3 -> p3

p1 -> L1 { style.stroke-dash: 4 }
p2 -> L2 { style.stroke-dash: 4 }
p3 -> L3 { style.stroke-dash: 4 }
