direction: down

title_area: "Latent Space 中的两个力" {
  style.stroke: "#6b7280"
  style.bold: true

  grid-columns: 2

  recon_side: "Reconstruction 目标" {
    style.stroke: "#2563eb"
    style.bold: true

    desc: "希望不同输入的\nq(z|x) 彼此可区分\n→ 保留输入信息" {
      style.stroke: "#2563eb"
      style.stroke-dash: 4
    }

    effect: "把概率云拉开\n各自占据不同区域" {
      style.stroke: "#2563eb"
    }
  }

  kl_side: "KL Regularization" {
    style.stroke: "#dc2626"
    style.bold: true

    desc: "希望每个 q(z|x)\n不要严重偏离 p(z)=N(0,I)\n→ 维持全局规则性" {
      style.stroke: "#dc2626"
      style.stroke-dash: 4
    }

    effect: "把概率云往 prior\n覆盖区域拉拢" {
      style.stroke: "#dc2626"
    }
  }
}

result: "最终平衡：\n既能区分不同输入\n又可以从已知 prior 中采样" {
  style.stroke: "#16a34a"
  style.bold: true
  style.stroke-width: 3
}

title_area -> result: "折中"
