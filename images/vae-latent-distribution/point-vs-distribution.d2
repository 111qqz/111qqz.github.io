grid-columns: 2

ae_side: "普通 Autoencoder" {
  style.stroke: "#2563eb"
  style.bold: true

  desc_top: "每个输入 → 一个确定点" {
    style.stroke: "#6b7280"
    style.stroke-dash: 4
  }

  p1: "● z₁" {
    shape: circle
    style.stroke: "#2563eb"
    style.bold: true
  }
  p2: "● z₂" {
    shape: circle
    style.stroke: "#16a34a"
    style.bold: true
  }
  p3: "● z₃" {
    shape: circle
    style.stroke: "#dc2626"
    style.bold: true
  }

  desc_top -> p1: "x₁" {style.stroke-dash: 4}
  desc_top -> p2: "x₂" {style.stroke-dash: 4}
  desc_top -> p3: "x₃" {style.stroke-dash: 4}

  problem: "随机采样 → 可能\n落到未知区域" {
    style.stroke: "#f59e0b"
    style.stroke-dash: 4
  }

  p1 -> problem: {style.stroke-dash: 4; style.opacity: 0.3}
}

vae_side: "VAE" {
  style.stroke: "#16a34a"
  style.bold: true

  desc_top: "每个输入 → 一团概率云" {
    style.stroke: "#6b7280"
    style.stroke-dash: 4
  }

  c1: "☁ q(z|x₁)" {
    shape: cloud
    style.stroke: "#2563eb"
    style.bold: true
  }
  c2: "☁ q(z|x₂)" {
    shape: cloud
    style.stroke: "#16a34a"
    style.bold: true
  }
  c3: "☁ q(z|x₃)" {
    shape: cloud
    style.stroke: "#dc2626"
    style.bold: true
  }

  desc_top -> c1: "x₁" {style.stroke-dash: 4}
  desc_top -> c2: "x₂" {style.stroke-dash: 4}
  desc_top -> c3: "x₃" {style.stroke-dash: 4}

  advantage: "KL 约束 → 聚拢在\nprior N(0,I) 附近" {
    style.stroke: "#16a34a"
    style.stroke-dash: 4
  }

  c1 -> advantage: {style.stroke-dash: 4; style.opacity: 0.3}
}
