grid-columns: 2
**.style.font-size: 24
front: "前方 A 撤单" {
  style.bold: true
  style.stroke: "#16a34a"
  initial: "A B C 我 D E\n各 1 BTC，共 6 BTC"
  cancel: "撤 A：B C 我 D E\n总量 5 BTC\n我前方 2 BTC"
  result: "卖出 3 BTC\n吃掉 B C 我\n我成交 1 BTC\n剩余 D E"
  initial -> cancel: "撤销 A"
  cancel -> result: "同价卖出 3 BTC"
}
rear: "后方 E 撤单" {
  style.bold: true
  style.stroke: "#f59e0b"
  initial: "A B C 我 D E\n各 1 BTC，共 6 BTC"
  cancel: "撤 E：A B C 我 D\n总量 5 BTC\n我前方 3 BTC"
  result: "卖出 3 BTC\n吃掉 A B C\n我成交 0 BTC\n剩余 我 D"
  initial -> cancel: "撤销 E"
  cancel -> result: "同价卖出 3 BTC"
}
