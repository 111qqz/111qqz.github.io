grid-columns: 2
**.style.font-size: 24
taker: "Taker 买入" {
  style.bold: true
  style.stroke: "#2563eb"
  order: "主动买入\nAsk 深度足够"
  ask: "Ask 100,010\n与卖方挂单撮合"
  execution: "买入成交\n100,010"
  order -> ask: "订单抵达"
  ask -> execution: "撮合"
}
maker: "Maker 买入" {
  style.bold: true
  style.stroke: "#16a34a"
  sell: "主动卖出\n先消耗前方队列"
  bid: "轮到我的买单\n100,000 成交"
  book: "Bid 100,000\nAsk 100,010\nMid 100,005\nBid 仍有余量"
  sell -> bid: "卖量足以轮到我"
  bid -> book: "成交后的盘口"
}
