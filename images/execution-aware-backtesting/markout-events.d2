grid-columns: 2
**.style.font-size: 24
trade: "成交与持仓事件" {
  style.bold: true
  style.stroke: "#2563eb"
  execution: "成交时刻 tf\n买入 1 BTC\n成交价 100,000"
  hold: "tf + 10s\n仍持有 1 BTC\n未执行平仓"
  execution -> hold: "持仓延续"
}
quote: "盘口参考价格" {
  style.bold: true
  style.stroke: "#16a34a"
  now: "成交时刻 tf\nMid 100,005\n较成交价 +5 USDT"
  later: "tf + 10s\nMid 100,002\n较成交价 +2 USDT"
  now -> later: "Mid 变化 −3 USDT"
}
