grid-columns: 2

det: "确定性 DP" {
  s_det: "State s" {
    style.bold: true
    style.stroke: "#2563eb"
    style.stroke-width: 2
  }
  a_det: "Action a"
  s_next_det: "State f(s,a)\n唯一确定" {
    style.stroke: "#16a34a"
    style.stroke-width: 2
  }
  val_det: "dp(s) = r + dp(f(s,a))" {
    style.bold: true
  }

  s_det -> a_det: "选择"
  a_det -> s_next_det: "确定转移"
  s_next_det -> val_det
}

prob: "概率 DP（Bellman Equation）" {
  s_prob: "State s" {
    style.bold: true
    style.stroke: "#2563eb"
    style.stroke-width: 2
  }
  a_prob: "Action a"
  s1: "State s'₁" {
    style.stroke: "#16a34a"
  }
  s2: "State s'₂" {
    style.stroke: "#16a34a"
  }
  s3: "State s'₃" {
    style.stroke: "#16a34a"
  }
  val_prob: "V(s) = E[R + γV(S')]" {
    style.bold: true
  }

  s_prob -> a_prob: "选择"
  a_prob -> s1: "P₁" {
    style.stroke: "#f59e0b"
  }
  a_prob -> s2: "P₂" {
    style.stroke: "#f59e0b"
  }
  a_prob -> s3: "P₃" {
    style.stroke: "#f59e0b"
  }
  s1 -> val_prob
  s2 -> val_prob
  s3 -> val_prob
}
