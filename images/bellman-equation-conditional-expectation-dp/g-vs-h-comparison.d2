direction: down

g_side: "G：实际 Return（组内有波动）" {
  grid-columns: 2
  b_grp: "B 组: 80, 120" {
    style.stroke: "#16a34a"
    style.stroke-width: 2
  }
  c_grp: "C 组: 0, 40" {
    style.stroke: "#f59e0b"
    style.stroke-width: 2
  }
}

transform: "条件期望：\n消除组内波动\n保留组内均值" {
  style.stroke: "#dc2626"
  style.stroke-width: 2
  style.bold: true
}

h_side: "H：条件期望（波动消失）" {
  grid-columns: 2
  b_grp: "B 组均值 = 100" {
    style.stroke: "#16a34a"
    style.stroke-width: 2
    style.bold: true
  }
  c_grp: "C 组均值 = 20" {
    style.stroke: "#f59e0b"
    style.stroke-width: 2
    style.bold: true
  }
}

g_side -> transform
transform -> h_side
