direction: down

s1: "起点：E_π[ R + γ G'  ∣  S_t = s ]" {
  style.bold: true
  style.stroke: "#2563eb"
  style.stroke-width: 3
}

s2: "E_π[ R ∣ S_t = s ]    +    γ · E_π[ G' ∣ S_t = s ]"

s3: "E_π[ R ∣ S_t = s ]    +    γ · E_π[ V(S') ∣ S_t = s ]"

s4: "Bellman Equation：E_π[ R + γ V(S')  ∣  S_t = s ]" {
  style.bold: true
  style.stroke: "#2563eb"
  style.stroke-width: 3
}

s1 -> s2: "① 线性拆开"
s2 -> s3: "②③ 全期望 + Markov" {
  style.stroke: "#dc2626"
  style.stroke-width: 2
}
s3 -> s4: "④ 线性合并"
