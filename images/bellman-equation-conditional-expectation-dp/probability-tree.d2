direction: right

state_a: "State A\n（当前）" {
  style.bold: true
  style.stroke: "#2563eb"
  style.stroke-width: 3
}

state_b: "State B" {
  style.stroke: "#16a34a"
  style.stroke-width: 2
}

state_c: "State C" {
  style.stroke: "#f59e0b"
  style.stroke-width: 2
}

ret_b1: "Return = 80\n联合概率 35%"
ret_b2: "Return = 120\n联合概率 35%"
ret_c1: "Return = 0\n联合概率 15%"
ret_c2: "Return = 40\n联合概率 15%"

state_a -> state_b: "70%" {
  style.stroke: "#16a34a"
  style.stroke-width: 2
}
state_a -> state_c: "30%" {
  style.stroke: "#f59e0b"
  style.stroke-width: 2
}

state_b -> ret_b1: "条件概率 50%"
state_b -> ret_b2: "条件概率 50%"

state_c -> ret_c1: "条件概率 50%"
state_c -> ret_c2: "条件概率 50%"
