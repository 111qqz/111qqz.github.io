direction: down

bbox: "KD-Tree 空间包围盒 (Bounding Box)" {
  style.stroke: "#2563eb"
  style.bold: true

  grid-columns: 2
  grid-gap: 20

  node_p: "当前子树点集包围盒范围\n• X 轴区间: [min_x, max_x]\n• Y 轴区间: [min_y, max_y]\n代表该子树下所有点组成的空间" {
    shape: rectangle
    style.stroke: "#0891b2"
    style.bold: true
  }

  query_q: "查询点 Q(x, y) 曼哈顿下界估计\n估价函数 dist_min(Q, Box)：\nmax(0, min_x - x, x - max_x) +\nmax(0, min_y - y, y - max_y)" {
    shape: rectangle
    style.stroke: "#f59e0b"
    style.bold: true
  }
}

pruning: "启发式剪枝判定 (Branch-and-Bound Pruning)" {
  style.stroke: "#16a34a"
  style.bold: true

  check: "若 dist_min(Q, Box) >= 当前最优曼哈顿距离 ans\n说明该子树内的任意点都不可能优于当前解，直接剪枝返回！" {
    shape: rectangle
    style.stroke: "#16a34a"
    style.bold: true
  }
}

bbox -> pruning: "曼哈顿空间估价函数剪枝"
