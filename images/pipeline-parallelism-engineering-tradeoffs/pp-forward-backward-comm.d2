direction: right

gpu0: "GPU 0\nStage 0: y=W₀x" {
  style.stroke: "#3b82f6"
  style.bold: true
}

gpu1: "GPU 1\nStage 1: z=W₁h" {
  style.stroke: "#ef4444"
  style.bold: true
}

gpu0 -> gpu1: "Forward: h (Activation)" {
  style.stroke: "#3b82f6"
  style.stroke-width: 3
}

gpu1 -> gpu0: "Backward: ∂L/∂h\n(Input Gradient)" {
  style.stroke: "#dc2626"
  style.stroke-width: 3
  style.stroke-dash: 4
}

note_0: "GPU 0 本地计算:\n∂L/∂W₀ = (∂L/∂h) xᵀ\n(Weight Gradient 不传)" {
  style.stroke: "#6b7280"
  style.stroke-dash: 4
}

note_1: "GPU 1 本地计算:\n∂L/∂W₁ = (∂L/∂z) hᵀ\n(Weight Gradient 不传)" {
  style.stroke: "#6b7280"
  style.stroke-dash: 4
}
