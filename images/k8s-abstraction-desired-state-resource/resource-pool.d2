direction: down

Nodes: {
  node 1: { shape: square }
  node 2: { shape: square }
  node 3: { shape: square }
  style: { stroke: "#aaaaaa" }
}

Resource Pool: {
  shape: cylinder
  label: "Cluster Resource Pool\n(CPU, Memory, GPU)"
  style: {
    stroke: "#4a90e2"
    bold: true
  }
}

Workload: {
  shape: package
  label: "Workload Requirement\n(e.g., CPU=8, Mem=32G)"
  style: {
    stroke: "#f5a623"
    bold: true
  }
}

Scheduler: {
  shape: step
  style: {
    stroke: "#50e3c2"
    bold: true
  }
}

Placement: {
  shape: hexagon
  label: "Placement Decision"
  style: {
    stroke: "#bd10e0"
    bold: true
  }
}

Nodes -> Resource Pool: abstract into
Workload -> Scheduler: submits requirement
Resource Pool -> Scheduler: available resources
Scheduler -> Placement: outputs
