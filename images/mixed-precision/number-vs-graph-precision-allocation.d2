direction: right

num: "Number-Level\n（上一篇）" {
  style.stroke: blue
  style.bold: true
}

arrow: "相同的\ntrade-off 思想" {
  style.stroke-dash: 4
}

graph: "Graph-Level\n（本篇）" {
  style.stroke: green
  style.bold: true
}

num -> arrow -> graph

detail_n: "bit budget\n→ Exponent ↔ Fraction\n→ Range ↔ Precision" {
  style.stroke: blue
}

detail_g: "高精度 budget\n→ Layer A ↔ B ↔ C\n→ Accuracy ↔ Efficiency" {
  style.stroke: green
}

num -> detail_n
graph -> detail_g
