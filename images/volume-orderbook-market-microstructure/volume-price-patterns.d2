grid-columns: 2

up_vol_up: {
  style.stroke: "#dc2626"
  style.bold: true
  label: "放量上涨\n价格 ↑  成交量 ↑\n\n可能 A:\n主动买盘强势\n吃掉卖方挂单推高价格\n\n可能 B:\n高位剧烈换手\n分歧加剧\n不一定单边看多"
}

up_vol_down: {
  style.stroke: "#f59e0b"
  label: "缩量上涨\n价格 ↑  成交量 ↓\n\n可能 A:\n持有者惜售\n卖方挂单稀少\n少量买入即推价\n\n可能 B:\n交易清淡\n流动性不足\n缺乏成交量支撑"
}

down_vol_up: {
  style.stroke: "#dc2626"
  style.bold: true
  label: "放量下跌\n价格 ↓  成交量 ↑\n\n可能 A:\n大量持有者集中抛售\n卖方主动压低价格\n\n可能 B:\n恐慌出清但有承接\n低位出现大量买盘"
}

down_vol_down: {
  style.stroke: "#f59e0b"
  label: "缩量下跌\n价格 ↓  成交量 ↓\n\n可能 A:\n卖压不大\n价格温和回落\n\n可能 B:\n买盘稀薄\n少量卖出即砸价\n盘口脆弱"
}
