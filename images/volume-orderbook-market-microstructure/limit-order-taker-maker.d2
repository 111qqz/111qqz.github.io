grid-columns: 2

taker_phase: {
  style.stroke: "#dc2626"
  style.bold: true
  label: "阶段一: Taker\n（消耗流动性）\n\n限价买单到达:\n1000 股 @ 10.03\n\n当前卖盘:\nAsk 1: 10.01 × 100\nAsk 2: 10.02 × 200\nAsk 3: 10.05 × 500\n\n撮合:\n100 股 @ 10.01 成交\n200 股 @ 10.02 成交\n10.03 < 10.05，停止\n\n本阶段消耗: 300 股"
}

maker_phase: {
  style.stroke: "#2563eb"
  style.bold: true
  label: "阶段二: Maker\n（提供流动性）\n\n剩余 700 股无法匹配\n以 10.03 挂入买盘\n\n新盘口:\nAsk 1: 10.05 × 500\n─────────────────\nBid 1: 10.03 × 700 (新)\nBid 2:  9.99 × 原挂单\n\n本阶段提供: 700 股"
}
