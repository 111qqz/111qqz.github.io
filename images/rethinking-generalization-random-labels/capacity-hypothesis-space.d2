direction: down

capacity: "Model Capacity（模型容量）" {
  style.stroke: "#2563eb"
  style.stroke-width: 3
  style.bold: true
}

hypothesis: "Hypothesis Space（假设空间）" {
  style.stroke: "#2563eb"
  style.stroke-width: 2

  grid-columns: 2

  good: "能拟合训练集\n且泛化较好的函数" {
    style.stroke: "#16a34a"
    style.stroke-width: 2
    style.bold: true
  }
  bad: "能拟合训练集\n但泛化较差的函数" {
    style.stroke: "#dc2626"
    style.stroke-width: 2
    style.stroke-dash: 4
  }
}

bottom_row: "" {
  label: ""
  grid-columns: 2

  factors: "Data + Architecture\n+ Optimization" {
    style.stroke: "#f59e0b"
    style.stroke-width: 2
    style.bold: true
  }

  result: "训练最终得到的函数\n→ Generalization" {
    style.stroke: "#16a34a"
    style.stroke-width: 3
    style.bold: true
    style.double-border: true
  }
}

capacity -> hypothesis: "决定了假设空间有多大" {
  style.stroke: "#2563eb"
}
hypothesis -> bottom_row.result: "从中选出" {
  style.stroke: "#888888"
  style.stroke-dash: 4
}
bottom_row.factors -> bottom_row.result: "共同影响\n选出哪个" {
  style.stroke: "#f59e0b"
  style.stroke-width: 2
}
