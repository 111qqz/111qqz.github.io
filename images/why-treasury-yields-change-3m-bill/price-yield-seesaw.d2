direction: down

formula_box: "定价机制: 零息折现公式 P = F / (1 + r × T)\n到期面值 F = 10,000 美元固定 | 剩余期限 T = 0.25 年" {
  style.stroke: "#64748b"
  style.stroke-dash: 2
}

cases: "" {
  grid-columns: 3

  low_r: "市场要求收益率降至 3.0%\n(降息预期升温 / 资金抢购)" {
    style.stroke: "#16a34a"
    style.bold: true
    p1: "买方出价竞争\n买入价格 P = 9,926 美元\n债券价格上升 ↑"
  }

  mid_r: "基准市场收益率 4.0%\n(初始均衡状态)" {
    style.stroke: "#2563eb"
    p2: "均衡买入成本\n买入价格 P = 9,901 美元\n基准价格水平"
  }

  high_r: "市场要求收益率升至 5.0%\n(加息紧缩 / 抛售压力)" {
    style.stroke: "#dc2626"
    style.bold: true
    p3: "买方压价收购\n买入价格 P = 9,877 美元\n债券价格下跌 ↓"
  }
}

formula_box -> cases: "收益率要求变化直接决定出价"
