direction: down

grid-columns: 2

buyer_a: "原买家 (Day 0 / 一级或二级市场)" {
  style.stroke: "#2563eb"
  style.bold: true
  cost_a: "买入成本: 9,900 美元\n剩余期限: 91 天"
  return_a: "到期差价: 100 美元\n持有期回报: ~1.01%\n单利年化收益率: 4.04%"
  cost_a -> return_a: "持有锁定"
}

buyer_b: "新买家 (Day 1 / 二级市场接盘)" {
  style.stroke: "#16a34a"
  style.bold: true
  cost_b: "买入出价: 9,914 美元\n剩余期限: 90 天"
  return_b: "到期差价: 86 美元\n持有期回报: ~0.87%\n单利年化收益率: 3.50%"
  cost_b -> return_b: "持有锁定"
}

shared_bond: "同一张 3M 国库券凭据: 到期全额偿付 10,000 美元" {
  shape: rectangle
  style.stroke: "#64748b"
  style.stroke-dash: 3
  desc: "财政部兑付金额白纸黑字固定不变\n买入价格不同，转化为不同的到期回报速度"
}

buyer_a -> shared_bond: "到期兑付"
buyer_b -> shared_bond: "到期兑付"
