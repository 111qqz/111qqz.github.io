direction: right

stage1: "阶段一: 预期形成 (T - 30天)\n通胀走低 / 降息预期升温" {
  style.stroke: "#2563eb"
  style.bold: true
  action1: "资金提前布局抢购 3M 国债\n国债价格提前跳涨\n收益率提前从 4.0% 跌至 3.5%"
}

stage2: "阶段二: 决议公布 (T 日)\n美联储如期宣布降息 25bp" {
  style.stroke: "#16a34a"
  style.bold: true
  action2: "预期已充分计入 (Priced In)\n国债价格与收益率基本平稳\n利好落地不再出现二次暴涨"
}

stage3_branch: "分支: 预期落空\nCPI 意外爆表 / 宣布按兵不动" {
  style.stroke: "#dc2626"
  style.stroke-dash: 4
  action3: "市场降息预期被迫逆转\n资金抛售，短债价格补跌\n收益率报复性反弹"
}

stage1 -> stage2: "预期完全兑现"
stage1 -> stage3_branch: "若预期差暴雷"
