direction: down

stage1: 阶段 1：调度准入与超卖承诺 (Admission) {
  style: {
    stroke: "#2563eb"
    stroke-width: 2
  }

  k8s: 多个 K8s 训练 Job 同机运行
  alloc: 各任务申请大块虚拟内存 (NumPy 数组等)
  overcommit: vm.overcommit_memory=1\n(内核不做 Commit Accounting，直接放行) {
    style: {
      stroke: "#2563eb"
      bold: true
    }
  }

  k8s -> alloc
  alloc -> overcommit: 仅记录虚拟地址空间
}

stage2: 阶段 2：运行时真实内存兑现 (Runtime Demand) {
  style: {
    stroke: "#f59e0b"
    stroke-width: 2
  }

  touch: 训练数据加载，逐页 Touch 物理内存
  pressure: 整机 Aggregate Demand 持续爬升
  reclaim_zone: 突破 Watermark，陷入激进 Reclaim 泥潭 {
    style: {
      stroke: "#dc2626"
      bold: true
    }
  }

  touch -> pressure: 虚拟内存兑现为实际物理页
  pressure -> reclaim_zone: 节点物理内存告急
}

stage3: 阶段 3：集群集体假死 (Thrashing & Stall) {
  style: {
    stroke: "#dc2626"
    stroke-width: 2
  }

  dr_stall: Allocation Stall：分配线程被强行卡住
  io_stall: Page Cache 丢失：大量 I/O 穿透到底层存储
  progress_zero: Useful Progress 趋近于零 (CPU 算力全部空转)
  stuck: 现象：整台物理机上的所有 Job 表面存活但集体卡死 {
    style: {
      stroke: "#dc2626"
      stroke-width: 3
      bold: true
    }
  }

  dr_stall -> progress_zero
  io_stall -> progress_zero
  progress_zero -> stuck
}

stage4: 阶段 4：人工干预与秒级恢复 (Mitigation) {
  style: {
    stroke: "#16a34a"
    stroke-width: 2
  }

  kill_job: 手动 Kill 掉一个占用极大的训练 Job {
    shape: oval
    style.bold: true
  }
  free_mem: 瞬间释放数十乃至上百 GB 物理内存
  pressure_drop: 整机内存压力直接触底解除
  resume: 恢复：其余所有挂起的 Job 瞬间满血恢复运行！ {
    style: {
      stroke: "#16a34a"
      stroke-width: 3
      bold: true
    }
  }

  kill_job -> free_mem
  free_mem -> pressure_drop
  pressure_drop -> resume
}

oom_branch: 极端分支：OOM Killer 触发\n(注：实际排查中，往往还没到 OOM，\n系统就已长期陷入 Progress≈0 的停滞状态) {
  shape: rectangle
  style: {
    stroke: "#dc2626"
    stroke-dash: 4
  }
}

stage1 -> stage2: 训练持续进行
stage2.reclaim_zone -> stage3: 内存回收恶性循环
stage3.stuck -> stage4.kill_job: 排查发现后手动干涉
stage2.reclaim_zone -> oom_branch: 若持续耗尽至绝对极限 {
  style: {
    stroke: "#dc2626"
    stroke-dash: 4
  }
}
