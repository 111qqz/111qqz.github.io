grid-columns: 2

traditional: "C++11/14 概念模型" {
  style.stroke: "#2563eb"
  style.stroke-width: 2

  tmp: "临时对象\n(函数内构造)" {
    style.stroke: "#f59e0b"
  }
  ret: "函数返回对象\n(可能的中间副本)" {
    style.stroke: "#f59e0b"
  }
  dest: "调用方变量\n(最终目标)" {
    style.stroke: "#16a34a"
    style.bold: true
  }

  tmp -> ret: "Copy 或 Move\n（可被 RVO 省略）"
  ret -> dest: "Copy 或 Move\n（可被省略）"
}

cpp17model: "C++17 prvalue 语义" {
  style.stroke: "#dc2626"
  style.stroke-width: 2

  init: "prvalue 表达式\n(如 Widget{})" {
    style.stroke: "#dc2626"
    style.bold: true
  }
  target: "最终目标对象\n(直接在此位置构造)" {
    style.stroke: "#16a34a"
    style.bold: true
  }

  init -> target: "直接初始化\n无中间对象\n无 Copy/Move"
}
