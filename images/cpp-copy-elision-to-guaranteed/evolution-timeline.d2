direction: down

cpp98: "C++98/03  Copy Elision\n\n编译器可选优化（RVO / NRVO）\n可省略 Copy Constructor 调用\n但程序必须有合法的 Copy Constructor" {
  style.stroke: "#2563eb"
  style.bold: true
  style.stroke-width: 2
}

cpp11: "C++11/14  Move Semantics\n\nCopy Elision 仍然是可选优化\n新增 Move Constructor\n省略不了？至少可以移动" {
  style.stroke: "#16a34a"
  style.bold: true
  style.stroke-width: 2
}

cpp17: "C++17  Guaranteed Copy Elision\n\nprvalue 语义改变：直接初始化目标对象\n语言层面不需要中间 Copy/Move\n即使没有 Copy/Move Constructor 也合法" {
  style.stroke: "#dc2626"
  style.bold: true
  style.stroke-width: 2
}

cpp98 -> cpp11
cpp11 -> cpp17
