direction: down

source: "程序顺序\n① v = ptr\n② _store = v\n③ somefunc()\n④ v = _store" {
  style.bold: true
}

reorder: "编译器 / CPU 重排\n出于效率，指令实际执行顺序\n可能与源码顺序不同" {
  style.stroke: "#f59e0b"
}

barrier: "MemoryBarrier()\n屏障之前的读写先完成，\n屏障之后的读写才能开始" {
  style.stroke: "#dc2626"
  style.stroke-width: 3
  style.bold: true
}

source -> reorder: "无屏障" {
  style.stroke-dash: 4
}
source -> barrier: "在关键位置插入"
