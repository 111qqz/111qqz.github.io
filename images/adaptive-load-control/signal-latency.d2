direction: right

Traffic: "Incoming\nTraffic"
Burst: "Request\nBurst"
Surge: "Concurrency\nSurge"
Queue: "Queue\nAccumulation"
Memory: "Memory\nPressure"
Cliff: "Latency\nCliff" {
  style.stroke: "#dc2626"
  style.bold: true
}

Traffic -> Burst: "100ms"
Burst -> Surge: "200ms"
Surge -> Queue: "500ms"
Queue -> Memory: "1s"
Memory -> Cliff: "2s"
