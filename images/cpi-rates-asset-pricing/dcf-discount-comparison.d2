grid-columns: 2

low_rate: "折现率 r = 2%" {
  style.stroke: "#16a34a"
  style.bold: true

  near_low: "近期（第 1 年）10 元\n→ 现值 9.80 元"
  far_low: "远期（第 10 年）10 元\n→ 现值 8.20 元\n衰减 18%"
  total_low: "10 年总现值\n≈ 89.8 元" {
    style.bold: true
    style.stroke: "#16a34a"
    style.stroke-width: 3
  }
  near_low -> far_low -> total_low
}

high_rate: "折现率 r = 6%" {
  style.stroke: "#dc2626"
  style.bold: true

  near_high: "近期（第 1 年）10 元\n→ 现值 9.43 元"
  far_high: "远期（第 10 年）10 元\n→ 现值 5.58 元\n衰减 44%" {
    style.stroke: "#dc2626"
    style.stroke-width: 2
  }
  total_high: "10 年总现值\n≈ 73.6 元（下降 18%）" {
    style.bold: true
    style.stroke: "#dc2626"
    style.stroke-width: 3
  }
  near_high -> far_high -> total_high
}
