direction: down

inputs: "" {
  label: ""
  grid-columns: 2

  nominal: "名义收益率\n（国债收益率）" {
    style.stroke: "#2563eb"
    style.bold: true
  }

  inflation_exp: "通胀预期" {
    style.stroke: "#f59e0b"
    style.bold: true
  }
}

real_yield_node: "实际利率 = 名义收益率 - 通胀预期" {
  style.stroke: "#dc2626"
  style.bold: true
  style.stroke-width: 3
}

gold_price: "黄金价格\n实际利率 ↑ → 持有黄金的机会成本 ↑ → 金价承压 ↓" {
  style.bold: true
  style.stroke-width: 3
}

inputs.nominal -> real_yield_node: "加"
inputs.inflation_exp -> real_yield_node: "减"
real_yield_node -> gold_price
