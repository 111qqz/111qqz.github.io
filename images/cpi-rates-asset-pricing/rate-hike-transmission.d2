direction: right

fed: "美联储加息\n（利率上升）" {
  style.bold: true
  style.stroke: "#2563eb"
  style.stroke-width: 3
}

consumer: "消费者端\n房贷、车贷、信用卡利率 ↑\n→ 借贷成本增加\n→ 消费意愿收缩" {
  style.stroke: "#f59e0b"
}

business: "企业端\n融资、发债成本 ↑\n→ 扩张计划放缓\n→ 招聘减少" {
  style.stroke: "#f59e0b"
}

demand: "总需求\n下降" {
  style.bold: true
  style.stroke: "#dc2626"
  style.stroke-width: 3
}

inflation_down: "通胀压力\n缓解" {
  style.bold: true
  style.stroke: "#16a34a"
  style.stroke-width: 3
}

fed -> consumer
fed -> business
consumer -> demand
business -> demand
demand -> inflation_down
