direction: right

cpi: "CPI 数据\n超预期" {
  style.stroke: "#2563eb"
  style.bold: true
  style.stroke-width: 3
}

inflation_up: "通胀预期\n上修" {
  style.stroke: "#f59e0b"
  style.bold: true
}

fed_hawk: "美联储\n偏鹰派" {
  style.stroke: "#f59e0b"
  style.bold: true
}

yield_up: "国债收益率\n上升" {
  style.stroke: "#dc2626"
  style.bold: true
  style.stroke-width: 3
}

stocks: "股票\n折现率 ↑ → 估值 ↓" {
  style.stroke: "#dc2626"
}

gold_asset: "黄金\n实际利率 ↑ → 承压 ↓" {
  style.stroke: "#dc2626"
}

bond_asset: "债券\n被抛售 → 价格 ↓" {
  style.stroke: "#dc2626"
}

cpi -> inflation_up -> fed_hawk -> yield_up
yield_up -> stocks
yield_up -> gold_asset
yield_up -> bond_asset
