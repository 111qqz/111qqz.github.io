direction: down

price_axis: "Bid = 99,999 到 Ask = 100,000 的价格区间" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
  style.bold: true

  grid-columns: 2

  bid_node: "Bid\n99,999" {
    style.stroke: "#16a34a"
    style.stroke-width: 3
    style.bold: true
  }

  ask_node: "Ask\n100,000" {
    style.stroke: "#dc2626"
    style.stroke-width: 3
    style.bold: true
  }
}

positions: "两个参考价格的位置" {
  style.stroke: "#f59e0b"
  style.stroke-width: 2

  grid-columns: 2

  mid_node: "Mid = 99,999.5\n（不使用挂单量）" {
    style.stroke: "#2563eb"
    style.stroke-width: 2
  }

  wmid_node: "Weighted Mid = 99,999.9\n（OBI=+0.8，偏向 Ask）" {
    style.stroke: "#f59e0b"
    style.stroke-width: 3
    style.bold: true
  }
}

price_axis -> positions: "Pw = Mid + Spread/2 × OBI" {
  style.stroke: "#f59e0b"
  style.stroke-width: 2
}

legend: "OBI > 0 → Pw 偏向 Ask\nOBI = 0 → Pw = Mid\nOBI < 0 → Pw 偏向 Bid" {
  style.stroke: "#888"
  style.stroke-dash: 4
}

positions -> legend: "" {style.opacity: 0}
