direction: down

header: "BTC 永续合约 L1 盘口" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
  style.bold: true

  grid-columns: 2

  bid_side: "Buy Side (Bid)" {
    style.stroke: "#16a34a"
    style.stroke-width: 3
    style.bold: true

    info: "Best Bid = 99,999 USDT\nVolume = 100 BTC\n（买方挂单深厚）" {
      style.stroke: "#16a34a"
      style.stroke-width: 2
    }
  }

  ask_side: "Sell Side (Ask)" {
    style.stroke: "#dc2626"
    style.stroke-width: 3
    style.bold: true

    info: "Best Ask = 100,000 USDT\nVolume = 20 BTC\n（卖方挂单稀薄）" {
      style.stroke: "#dc2626"
      style.stroke-width: 2
    }
  }
}

result: "OBI = (100-20)/(100+20) = 0.667\n卖一更容易被消耗\n→ 下一次 Mid 变化更可能向上" {
  style.stroke: "#f59e0b"
  style.stroke-width: 3
  style.bold: true
}

header -> result: "Spread = 1 USDT  Mid = 99,999.5" {
  style.stroke: "#f59e0b"
  style.stroke-width: 2
}
