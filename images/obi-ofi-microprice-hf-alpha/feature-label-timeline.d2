direction: down

timeline: "时间轴" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
  style.bold: true

  grid-columns: 3

  feat_window: "Feature Window\n[t-1s, t]\n计算 OBI, OFI,\nSpread 等特征" {
    style.stroke: "#2563eb"
    style.stroke-width: 3
    style.bold: true
  }

  decision: "t: 预测时刻\n（Local Decision\nTime）" {
    style.stroke: "#f59e0b"
    style.stroke-width: 3
    style.bold: true
  }

  label_window: "Label Window\n[t, t+1s]\n预测目标:\nMid Return (bps)" {
    style.stroke: "#dc2626"
    style.stroke-width: 3
    style.bold: true
  }
}

latency: "Exchange Event（00.000s）\n→ Local Receive（00.015s）\n→ Decision（00.018s）\n特征可用时间 > 事件发生时间" {
  style.stroke: "#f59e0b"
  style.stroke-width: 2
  style.stroke-dash: 4
}

timeline -> latency: "延迟不可忽略" {
  style.stroke: "#f59e0b"
  style.stroke-width: 2
}
