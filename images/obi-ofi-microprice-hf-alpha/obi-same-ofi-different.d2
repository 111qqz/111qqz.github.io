grid-columns: 2

t0: "t0 时刻" {
  style.stroke: "#2563eb"
  style.stroke-width: 3
  style.bold: true

  bid0: "Bid Volume = 100 BTC" {
    style.stroke: "#16a34a"
    style.stroke-width: 2
  }
  ask0: "Ask Volume = 20 BTC" {
    style.stroke: "#dc2626"
    style.stroke-width: 2
  }
  obi0: "OBI = 0.667" {
    style.stroke: "#f59e0b"
    style.stroke-width: 2
    style.bold: true
  }
  bid0 -> obi0: "" {style.opacity: 0}
  ask0 -> obi0: "" {style.opacity: 0}
}

t1: "t1 时刻" {
  style.stroke: "#2563eb"
  style.stroke-width: 3
  style.bold: true

  bid1: "Bid Volume = 50 BTC" {
    style.stroke: "#16a34a"
    style.stroke-width: 2
  }
  ask1: "Ask Volume = 10 BTC" {
    style.stroke: "#dc2626"
    style.stroke-width: 2
  }
  obi1: "OBI = 0.667" {
    style.stroke: "#f59e0b"
    style.stroke-width: 2
    style.bold: true
  }
  bid1 -> obi1: "" {style.opacity: 0}
  ask1 -> obi1: "" {style.opacity: 0}
}

result: "OBI 不变，但 OFI = (-50) - (-10) = -40\n买方挂单流失速度远大于卖方" {
  style.stroke: "#dc2626"
  style.stroke-width: 3
  style.bold: true
}

t0 -> result: "" {style.opacity: 0}
t1 -> result: "" {style.opacity: 0}
