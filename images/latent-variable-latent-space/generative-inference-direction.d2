direction: right

gen: "Generative Direction\n（生成方向）" {
  direction: down
  z1: "latent z" {
    style.stroke: "#2563eb"
    style.bold: true
  }
  proc1: "生成过程\nz → x"
  x1: "observable x"
  z1 -> proc1 -> x1
}

inf: "Inference Direction\n（推断方向）" {
  direction: down
  x2: "observable x"
  proc2: "推断过程\nx → z"
  z2: "latent z" {
    style.stroke: "#2563eb"
    style.bold: true
  }
  x2 -> proc2 -> z2
}
