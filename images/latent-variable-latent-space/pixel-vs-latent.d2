direction: down

pixel: "Pixel Space — 每个维度 = 像素通道数值，精确记录图片最终长什么样" {
  style.stroke: "#dc2626"
  style.bold: true
}

pixel -> latent: "表示方式改变 (representation change)" {
  style.stroke: "#16a34a"
  style.bold: true
}

latent: "Latent Space — 每个维度 = 模型学到的抽象因素，尝试描述数据背后的结构" {
  style.stroke: "#2563eb"
  style.bold: true
}
