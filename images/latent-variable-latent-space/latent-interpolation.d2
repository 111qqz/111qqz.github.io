direction: down

interp: "Latent Space Interpolation" {
  label: ""
  direction: right
  zA: "z_A" {
    style.stroke: "#2563eb"
    style.bold: true
    style.stroke-width: 3
  }
  z1: "z(0.25)"
  z2: "z(0.5)"
  z3: "z(0.75)"
  zB: "z_B" {
    style.stroke: "#2563eb"
    style.bold: true
    style.stroke-width: 3
  }
  zA -> z1 -> z2 -> z3 -> zB
}

formula: "z(t) = (1-t)·z_A + t·z_B — 如果潜空间结构良好，中间状态也对应合理的数据" {
  style.stroke-dash: 5
}

interp -> formula
