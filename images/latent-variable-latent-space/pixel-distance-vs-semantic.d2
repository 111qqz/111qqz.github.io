direction: right

pixel_space: Pixel Space {
  direction: right
  faceA: "Face A\n(正面)" {
    style.stroke: "#2563eb"
    style.bold: true
  }
  gap: "像素距离很大\n大量 pixel 变化" {
    style.stroke: "#dc2626"
    style.stroke-dash: 5
  }
  faceB: "Face B\n(转头 5°)" {
    style.stroke: "#2563eb"
    style.bold: true
  }
  faceA -> gap -> faceB
}

latent_space: Latent Space {
  direction: right
  zA: "z_A" {
    style.stroke: "#16a34a"
    style.bold: true
  }
  close_dist: "潜空间距离很近\n语义几乎相同" {
    style.stroke: "#16a34a"
    style.stroke-dash: 5
  }
  zB: "z_B" {
    style.stroke: "#16a34a"
    style.bold: true
  }
  zA -> close_dist -> zB
}

comparison: pixel_space -> latent_space: "同一对象\n稍微旋转" {
  style.stroke-dash: 5
}
