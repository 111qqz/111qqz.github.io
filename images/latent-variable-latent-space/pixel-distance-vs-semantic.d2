direction: down

inputs: "输入样本对比" {
  direction: right
  img_a: "图像 x_A\n(正面人脸)" {
    style.stroke: "#2563eb"
    style.bold: true
  }
  img_b: "图像 x_B\n(右转 5° 人脸)" {
    style.stroke: "#2563eb"
    style.bold: true
  }
}

p_eval: "视角一：像素空间直接度量" {
  diff_p: "像素级欧氏距离: ||x_A - x_B||\n轮廓边缘位移、大面积明暗翻转\n→ 数值距离巨大，无法识别出微小语义变化" {
    style.stroke: "#dc2626"
    style.bold: true
  }
}

l_eval: "视角二：潜空间内部坐标度量" {
  enc_z: "推断编码隐状态: z_A = E(x_A), z_B = E(x_B)\n剥离底层高频噪声，锁定内在物理/语义因子\n→ 潜空间距离微小，仅姿态维度有微量位移" {
    style.stroke: "#16a34a"
    style.bold: true
  }
}

inputs.img_a -> p_eval.diff_p: "原始像素比较"
inputs.img_b -> p_eval.diff_p: "原始像素比较"
inputs.img_a -> l_eval.enc_z: "编码器推断"
inputs.img_b -> l_eval.enc_z: "编码器推断"
