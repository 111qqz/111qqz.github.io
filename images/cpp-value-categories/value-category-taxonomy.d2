direction: down

expr: "expression" {
  style.bold: true
}

glvalue: "glvalue（泛左值）\n求值确定对象或函数的身份"
rvalue: "rvalue（右值）\nprvalue 和 xvalue 的统称"

lvalue: "lvalue（左值）\n有名字、可取地址"
xvalue: "xvalue（将亡值）\n如 std::move(x) 的结果" {
  style.stroke: "#f59e0b"
  style.bold: true
}
prvalue: "prvalue（纯右值）\n字面量或临时值，如 3、foo()"

expr -> glvalue
expr -> rvalue
glvalue -> lvalue
glvalue -> xvalue
rvalue -> xvalue
rvalue -> prvalue
