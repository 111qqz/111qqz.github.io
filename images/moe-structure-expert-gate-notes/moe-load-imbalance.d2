direction: right

T: "Token 流"
G: "Gate\n赢家通吃" { style.stroke: red }

E1: "Expert 1\n过载" { style.stroke: red; style.bold: true }
E2: "Expert 2\n一般" { style.stroke: blue }
E3: "Expert 3\n饿死 → 梯度为 0 → 死掉" { style.stroke: orange }
E4: "Expert 4\n完全闲置" { style.stroke: orange }

T -> G
G -> E1: "80% token" { style.stroke-width: 3 }
G -> E2: "15% token"
G -> E3: "5% token" { style.stroke-dash: 4 }
G -> E4: "0% token" { style.stroke-dash: 4 }
