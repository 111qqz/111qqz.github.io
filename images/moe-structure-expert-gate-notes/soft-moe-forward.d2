direction: down

X: "输入 Token序列 X: [n_tok, dim]"
Phi: "Slot矩阵 Φ:\n可学习 [dim, m]"
W: "权重计算\nφ = softmax(X·Φ)\nshape: [n_tok, m]"
Xh: "混合 Token\nX̃ = φᵀ·X\nshape: [m, dim]"
E: "每个 Slot 过一个 Expert\nE₁(X̃₁), …, Eₘ(X̃ₘ)" { style.stroke: green }
y: "输出加权散布\ny = Σ φᵢ · Eᵢ(X̃ᵢ)" { style.bold: true }

X -> Phi
Phi -> W
W -> Xh
Xh -> E
E -> y
