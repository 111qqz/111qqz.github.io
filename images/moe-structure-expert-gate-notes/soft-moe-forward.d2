direction: right

X: "输入 Token 序列\nX: [n_tok, dim]"
Phi: "Slot 矩阵 Φ\n可学习 [dim, m]"
W: "权重计算\nφ = softmax(X·Φ)\n[n_tok, m]"
Xh: "混合 Token\nX̃ = φᵀ·X\n[m, dim]"
E: "每个 Slot 过 Expert\nE₁(X̃₁)…Eₘ(X̃ₘ)" { style.stroke: green }
y: "输出加权散布\ny = Σ φᵢ·Eᵢ(X̃ᵢ)" { style.bold: true }

X -> Phi -> W -> Xh -> E -> y
