direction: right

x: "输入 x\n[batch, dim]"

W: "Gate 网络\nlinear + softmax\n[batch, n_experts]" {
  style.stroke: blue
}

T: "Top-k\n选择 k=2"

E1: "Expert 1\nE₁(x)" { style.stroke: green }
E2: "Expert 2\nE₂(x)" { style.stroke: green }

P: "概率加权\np₁·E₁ + p₂·E₂"

y: "输出 y" { style.bold: true }

x -> W -> T
T -> E1
T -> E2
E1 -> P
E2 -> P
P -> y
