direction: down

x: "输入 x: [batch, dim]"

W: "Gate 网络\nlinear + softmax\nshape: [batch, n_experts]" {
  style.stroke: blue
}

S: "Softmax\nrow-wise"
T: "Top-k 选择\nk=2"

x -> W -> S -> T

E1: "Expert 1: E₁(x)" { style.stroke: green }
E2: "Expert 2: E₂(x)" { style.stroke: green }

T -> E1
T -> E2

P: "概率加权\np₁, p₂ = softmax 输出"

E1 -> P
E2 -> P

y: "输出 y = p₁·E₁(x) + p₂·E₂(x)" { style.bold: true }

P -> y
