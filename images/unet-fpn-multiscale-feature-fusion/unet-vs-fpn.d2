direction: down

unet_side: "U-Net: 编码器-解码器单尺度全分辨率重构" {
  grid-columns: 2

  enc: "Encoder" {
    ue1: "Encoder 1 (256×256)" {style.stroke: "#2563eb"}
    ue2: "Encoder 2 (128×128)" {style.stroke: "#2563eb"}
    ue3: "Encoder 3 (64×64)" {style.stroke: "#2563eb"}
    ubn: "Bottleneck (32×32)" {style.stroke: "#dc2626"; style.bold: true}
    ue1 -> ue2 -> ue3 -> ubn: "MaxPool"
  }

  dec: "Decoder" {
    ud3: "Decoder 3 (64×64)" {style.stroke: "#f59e0b"}
    ud2: "Decoder 2 (128×128)" {style.stroke: "#f59e0b"}
    ud1: "Decoder 1 (256×256)" {style.stroke: "#f59e0b"}
    uout: "最终输出 (256×256×C)" {style.stroke: "#16a34a"; style.bold: true}
    ud3 -> ud2 -> ud1 -> uout: "Upsample"
  }

  enc.ubn -> dec.ud3: "Upsample"
  enc.ue3 -> dec.ud3: "Skip" {style.stroke: "#16a34a"; style.stroke-dash: 4}
  enc.ue2 -> dec.ud2: "Skip" {style.stroke: "#16a34a"; style.stroke-dash: 4}
  enc.ue1 -> dec.ud1: "Skip" {style.stroke: "#16a34a"; style.stroke-dash: 4}
}

fpn_side: "FPN: 特征金字塔多尺度独立预测" {
  grid-columns: 2

  bb: "Backbone" {
    fc2: "C2 (256×256)" {style.stroke: "#2563eb"}
    fc3: "C3 (128×128)" {style.stroke: "#2563eb"}
    fc4: "C4 (64×64)" {style.stroke: "#2563eb"}
    fc5: "C5 (32×32)" {style.stroke: "#2563eb"; style.bold: true}
    fc2 -> fc3 -> fc4 -> fc5: "stride 2"
  }

  pyr: "Pyramid" {
    fp5: "P5 (预测超大目标)" {style.stroke: "#f59e0b"}
    fp4: "P4 (预测大目标)" {style.stroke: "#f59e0b"}
    fp3: "P3 (预测中目标)" {style.stroke: "#f59e0b"}
    fp2: "P2 (预测小目标)" {style.stroke: "#f59e0b"}
    fp5 -> fp4 -> fp3 -> fp2: "Upsample"
  }

  bb.fc5 -> pyr.fp5: "1×1 Conv"
  bb.fc4 -> pyr.fp4: "Lateral Add" {style.stroke: "#16a34a"; style.stroke-dash: 4}
  bb.fc3 -> pyr.fp3: "Lateral Add" {style.stroke: "#16a34a"; style.stroke-dash: 4}
  bb.fc2 -> pyr.fp2: "Lateral Add" {style.stroke: "#16a34a"; style.stroke-dash: 4}
}
