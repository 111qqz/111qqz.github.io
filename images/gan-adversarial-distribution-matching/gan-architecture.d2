direction: down

generation: "生成路径" {
  grid-columns: 3
  label: ""
  noise: "z ~ N(0, I)" {
    style.stroke: "#2563eb"
  }
  gen: "Generator G" {
    style.stroke: "#16a34a"
    style.bold: true
    style.stroke-width: 3
  }
  fake: "G(z)" {
    style.stroke: "#f59e0b"
    style.bold: true
  }
  noise -> gen -> fake
}

real_data: "真实样本 x_real" {
  style.stroke: "#2563eb"
  style.bold: true
}

disc: "Discriminator D" {
  style.stroke: "#dc2626"
  style.bold: true
  style.stroke-width: 3
}

out_val: "输出 D(x) ∈ (0, 1)" {
  style.stroke: "#dc2626"
}

generation.fake -> disc: "D(G(z))" {
  style.stroke: "#f59e0b"
  style.stroke-width: 3
  style.bold: true
}
real_data -> disc
disc -> out_val
