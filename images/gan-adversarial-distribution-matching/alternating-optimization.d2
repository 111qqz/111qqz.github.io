direction: down

current: "当前状态 (G_t, D_t)" {
  style.bold: true
  style.stroke: "#2563eb"
  style.stroke-width: 2
}

train_d: "第一步：固定 G，更新 D\n→ 状态变为 (G_t, D_t+1)" {
  style.stroke: "#dc2626"
  style.bold: true
}

train_g: "第二步：固定 D，更新 G\n→ 状态变为 (G_t+1, D_t+1)" {
  style.stroke: "#16a34a"
  style.bold: true
}

current -> train_d -> train_g
train_g -> current: "下一轮" {
  style.stroke-dash: 4
}
