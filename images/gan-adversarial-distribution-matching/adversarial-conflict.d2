grid-columns: 2

normal: "普通网络" {
  params_ab: "参数 A、B"
  loss_val: "Loss" {
    style.bold: true
    style.stroke: "#16a34a"
    style.stroke-width: 3
  }

  params_ab -> loss_val: "都希望 ↓（合作）" {
    style.stroke: "#16a34a"
  }
}

gan_case: "GAN" {
  theta_d: "θ_D" {
    style.stroke: "#dc2626"
    style.bold: true
  }
  theta_g: "θ_G" {
    style.stroke: "#16a34a"
    style.bold: true
  }
  dg_val: "D(G(z))" {
    style.bold: true
    style.stroke: "#f59e0b"
    style.stroke-width: 3
  }

  theta_d -> dg_val: "希望 → 0" {
    style.stroke: "#dc2626"
  }
  theta_g -> dg_val: "希望 → 1" {
    style.stroke: "#16a34a"
  }
}
