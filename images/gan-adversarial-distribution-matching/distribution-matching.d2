grid-columns: 2

early_stage: "训练早期：p_g ≠ p_data" {
  pd_early: "p_data" {
    style.stroke: "#2563eb"
    style.bold: true
  }
  pg_early: "p_g（差异明显）" {
    style.stroke: "#dc2626"
    style.bold: true
  }
  d_finds: "D 找到可区分的\n统计特征" {
    style.stroke: "#f59e0b"
    style.bold: true
  }
  g_adjusts: "G 根据梯度\n调整输出" {
    style.stroke: "#16a34a"
    style.bold: true
  }

  pd_early -> d_finds
  pg_early -> d_finds
  d_finds -> g_adjusts
}

converge: "收敛：p_g ≈ p_data" {
  pd_late: "p_data" {
    style.stroke: "#2563eb"
    style.bold: true
  }
  pg_late: "p_g ≈ p_data" {
    style.stroke: "#16a34a"
    style.bold: true
  }
  d_fails: "D 无法区分\nD*(x) = 0.5" {
    style.stroke: "#f59e0b"
    style.bold: true
  }

  pd_late -> d_fails
  pg_late -> d_fails
}
