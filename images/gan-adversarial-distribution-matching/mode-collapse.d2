direction: down

full_dist: "真实分布 p_data：4 个 mode" {
  grid-columns: 4
  mode_a: "猫" {
    style.stroke: "#2563eb"
    style.bold: true
  }
  mode_b: "狗" {
    style.stroke: "#2563eb"
    style.bold: true
  }
  mode_c: "鸟" {
    style.stroke: "#2563eb"
    style.bold: true
  }
  mode_d: "汽车" {
    style.stroke: "#2563eb"
    style.bold: true
  }
}

collapsed: "Generator 输出 p_g：Mode Collapse" {
  grid-columns: 4
  gen_a: "猫 ✓" {
    style.stroke: "#dc2626"
    style.bold: true
    style.stroke-width: 3
  }
  gen_b: "狗 ✗" {
    style.stroke-dash: 4
  }
  gen_c: "鸟 ✗" {
    style.stroke-dash: 4
  }
  gen_d: "汽车 ✗" {
    style.stroke-dash: 4
  }
}

full_dist -> collapsed: "只学到部分 mode" {
  style.stroke-dash: 4
}
