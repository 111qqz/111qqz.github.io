grid-columns: 2

sample_view: "一次采样" {
  style.stroke: "#2563eb"
  style.bold: true

  z_vec: "z = [0.3, -1.2, ...]" {
    style.stroke: "#2563eb"
    style.bold: true
  }
  g_s: "Generator Gθ" {
    style.stroke: "#16a34a"
    style.bold: true
    style.stroke-width: 3
  }
  x_s: "generated sample x" {
    style.stroke: "#f59e0b"
    style.bold: true
  }

  z_vec -> g_s
  g_s -> x_s
}

dist_view: "整个分布" {
  style.stroke: "#16a34a"
  style.bold: true

  pz_d: "p_z = N(0, I)" {
    style.stroke: "#2563eb"
  }
  g_d: "Generator Gθ" {
    style.stroke: "#16a34a"
    style.bold: true
    style.stroke-width: 3
  }
  pg_d: "generated p_g" {
    style.stroke: "#f59e0b"
    style.bold: true
  }
  pdata_d: "real p_data" {
    style.stroke: "#dc2626"
    style.bold: true
  }

  pz_d -> g_d
  g_d -> pg_d
  pg_d -> pdata_d: "adversarial\ntraining" {
    style.stroke: "#dc2626"
    style.stroke-dash: 4
  }
}
