grid-rows: 2
grid-columns: 3
style.stroke: transparent

init: "① Random Init\nvariance scaling\nbreak symmetry" {
  style.stroke: "#f59e0b"
  style.stroke-width: 2
  style.bold: true
}

forward: "② Conv Forward\napply filters\nproduce feature map" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
}

loss: "③ Compute Loss\ncompare prediction\nwith target" {
  style.stroke: "#dc2626"
  style.stroke-width: 2
  style.bold: true
}

backward: "④ Backprop\ncompute ∂L/∂W\nfor each filter" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
}

update: "⑤ Optimizer\nupdate W\nrepeat from ②" {
  style.stroke: "#16a34a"
  style.stroke-width: 2
  style.bold: true
}

note: "Not handcrafted\nNot fixed\nLearned end-to-end" {
  style.stroke-dash: 4
  style.stroke: "#f59e0b"
}

init -> forward -> loss -> backward -> update
update -> forward: "next iteration" {
  style.stroke: "#16a34a"
  style.stroke-dash: 4
}
