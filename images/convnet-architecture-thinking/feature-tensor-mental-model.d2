direction: down

tensor: "Feature Tensor\n56 × 56 × 256" {
  style.bold: true
  style.stroke: "#2563eb"
  style.stroke-width: 3

  direction: right
  spatial: "56 × 56\nspatial positions" {
    style.stroke: "#2563eb"
  }
  channels: "256\nchannels per position" {
    style.stroke: "#16a34a"
  }
}

location: "Single Location (i, j)" {
  style.stroke: "#f59e0b"
  style.stroke-width: 2
  style.bold: true
}

vector: "h(i,j) ∈ ℝ²⁵⁶\n[c₁, c₂, c₃, ... , c₂₅₆]\n= learned representation\nat this spatial position" {
  style.stroke: "#dc2626"
  style.stroke-width: 2
}

tensor -> location: "取出一个位置" {style.stroke: "#f59e0b"}
location -> vector: "该位置的\nfeature vector" {style.stroke: "#dc2626"}
