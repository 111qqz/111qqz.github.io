direction: down

sharing: "Weight Sharing" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
  style.bold: true

  direction: right
  kernel: "Kernel K\n(learnable)" {
    style.bold: true
    style.stroke: "#2563eb"
    style.stroke-width: 3
  }

  positions: "Spatial Plane" {
    style.stroke: "#16a34a"

    p1: "(0,0)"
    p2: "(0,1)"
    p3: "(1,0)"
    p4: "(1,1)"
  }

  kernel -> positions.p1: "K" {style.stroke: "#2563eb"}
  kernel -> positions.p2: "K" {style.stroke: "#2563eb"}
  kernel -> positions.p3: "K" {style.stroke: "#2563eb"}
  kernel -> positions.p4: "K" {style.stroke: "#2563eb"}
}

no-share: "Without Sharing" {
  style.stroke: "#dc2626"
  style.stroke-width: 2

  direction: right
  w1: "(0,0) uses W1"
  w2: "(0,1) uses W2"
  w3: "(1,0) uses W3"
  w4: "(1,1) uses W4"
}

sharing -> no-share: "vs: 每个位置独立参数" {style.stroke-dash: 5; style.stroke: "#dc2626"}
