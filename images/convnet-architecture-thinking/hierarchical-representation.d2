grid-rows: 2
grid-columns: 3
style.stroke: transparent

l0: "Pixels\nraw values\n(input image)" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
}

l1: "Local Primitives\nedges, corners\n(early layers)" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
}

l2: "Small Patterns\ntextures, parts\n(middle layers)" {
  style.stroke: "#16a34a"
  style.stroke-width: 2
}

l3: "Larger Structures\nobject parts\n(deeper layers)" {
  style.stroke: "#f59e0b"
  style.stroke-width: 2
}

l4: "High-level\nRepresentation\n(deepest)" {
  style.stroke: "#dc2626"
  style.stroke-width: 3
  style.bold: true
}

recap: "每层处理的是\n上一层 learned\nrepresentation\n而非 original pixels" {
  style.stroke-dash: 4
}

l0 -> l1: "Layer 1" {style.stroke: "#2563eb"}
l1 -> l2: "Layer 2+" {style.stroke: "#16a34a"}
l2 -> l3: "Deeper" {style.stroke: "#f59e0b"}
l3 -> l4: "Deepest" {style.stroke: "#dc2626"}
