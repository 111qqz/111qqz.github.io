grid-rows: 2
grid-columns: 2
style.stroke: transparent

layer1: "Layer 1\nReceptive Field: 3 × 3\n单个 output 只看\n3 × 3 区域" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
}

layer2: "Layer 2\nReceptive Field: 5 × 5\n3×3 的输入各自来自\nLayer 1 的 3×3" {
  style.stroke: "#16a34a"
  style.stroke-width: 2
}

layer3: "Layer 3\nReceptive Field: 7 × 7\n每叠一层 3×3 Conv\nreceptive field +2" {
  style.stroke: "#f59e0b"
  style.stroke-width: 2
}

layerN: "Layer N\nReceptive Field:\n(2N+1) × (2N+1)\nlocal computation\n→ large-scale context" {
  style.stroke: "#dc2626"
  style.stroke-width: 3
  style.bold: true
}

layer1 -> layer2 {style.stroke: "#16a34a"}
layer2 -> layer3 {style.stroke: "#f59e0b"}
layer3 -> layerN: "..." {style.stroke: "#dc2626"}
