grid-rows: 1
grid-columns: 2
style.stroke: transparent

before: "Original\n\nInput:\nobject on left ◀\n\n↓ Conv\n\nFeature Map:\nresponse on left ◀" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
  style.bold: true
}

after: "Shifted\n\nInput:\n▶ object on right\n\n↓ Conv\n\nFeature Map:\n▶ response on right" {
  style.stroke: "#f59e0b"
  style.stroke-width: 2
  style.bold: true
}

before -> after: "平移输入\n→ 平移输出\nConv(Tx) = T(Conv(x))" {
  style.stroke: "#dc2626"
  style.bold: true
}
