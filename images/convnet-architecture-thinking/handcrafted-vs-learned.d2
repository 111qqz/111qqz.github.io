grid-columns: 2

handcrafted: "传统手工设计算子 (Handcrafted Filters)" {
  style.stroke: "#f59e0b"
  style.stroke-width: 2
  direction: down

  filter1: "固定先验权重矩阵 (如 Sobel 垂直边缘)\n[-1  0  1]\n[-2  0  2]\n[-1  0  1]" {
    style.stroke: "#f59e0b"
    style.stroke-width: 2
  }

  trait1: "设计机制:\n• 人工由专家根据几何直觉手工设计\n• 权重完全冻结，不可训练\n• 仅能捕获固定的低级图像基元" {
    style.stroke: "#f59e0b"
  }

  filter1 -> trait1
}

learned: "深度学习可学习卷积核 (Data-Driven Learned Filters)" {
  style.stroke: "#16a34a"
  style.stroke-width: 3
  style.bold: true
  direction: down

  filter2: "动态更新参数矩阵 W\n随机初始化 → 前向推理 → 计算 Loss → 反向传播梯度" {
    style.stroke: "#16a34a"
    style.stroke-width: 2
    style.bold: true
  }

  trait2: "设计机制:\n• 梯度反向传播端到端优化 (W ← W - η ∇W)\n• 根据海量数据自适应调整各通道特征抽取方向\n• 逐层自发长出从边缘到复杂语义的层级表征" {
    style.stroke: "#16a34a"
    style.bold: true
  }

  filter2 -> trait2
}
