grid-rows: 2
grid-columns: 2
style.stroke: transparent

l1: "Stage 1\n224 × 224 × 64\nhigh resolution\nlow abstraction" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
}

l2: "Stage 2\n112 × 112 × 128\nspatial ↓  channels ↑" {
  style.stroke: "#16a34a"
  style.stroke-width: 2
}

l3: "Stage 3\n56 × 56 × 256\nspatial ↓  channels ↑" {
  style.stroke: "#f59e0b"
  style.stroke-width: 2
}

l4: "Stage 4\n28 × 28 × 512\nlow resolution\nhigh abstraction" {
  style.stroke: "#dc2626"
  style.stroke-width: 3
  style.bold: true
}

l1 -> l2 {style.stroke: "#16a34a"}
l2 -> l3 {style.stroke: "#f59e0b"}
l3 -> l4 {style.stroke: "#dc2626"}
