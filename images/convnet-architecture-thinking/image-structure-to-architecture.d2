direction: down

image-structure: "Image Structure" {
  style.bold: true
  style.stroke: "#2563eb"
  style.stroke-width: 3

  direction: right
  a: "Locality\n(nearby pixels\nmatter more)"
  b: "Repeated\nLocal Patterns"
  c: "Spatial\nTopology"
  d: "Hierarchical\nStructure"
}

arch-choices: "Architectural Choices" {
  style.bold: true
  style.stroke: "#16a34a"
  style.stroke-width: 3

  direction: right
  a: "Local\nConnectivity"
  b: "Weight\nSharing"
  c: "Learnable\nFilters"
  d: "Translation\nEquivariance"
  e: "Hierarchical\nComposition"
  f: "Receptive-field\nGrowth"
}

bias: "Inductive Bias\n把对数据结构的理解\n编码进 Architecture" {
  style.bold: true
  style.stroke: "#dc2626"
  style.stroke-width: 3
}

image-structure -> arch-choices: "假设 → 设计" {
  style.stroke: "#2563eb"
  style.bold: true
}
arch-choices -> bias: "ConvNet 是经典范例" {
  style.stroke: "#dc2626"
  style.bold: true
}
