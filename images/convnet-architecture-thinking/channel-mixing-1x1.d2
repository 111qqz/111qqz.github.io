direction: right

input: "Position (i,j)\nx ∈ ℝ²⁵⁶\n[c₁, c₂, ..., c₂₅₆]" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
  style.bold: true
}

transform: "1 × 1 Conv\nShared Linear\nTransform\nℝ²⁵⁶ → ℝ⁶⁴" {
  style.bold: true
  style.stroke: "#dc2626"
  style.stroke-width: 3
}

output: "Position (i,j)\nf ∈ ℝ⁶⁴\n[f₁, f₂, ..., f₆₄]" {
  style.stroke: "#16a34a"
  style.stroke-width: 2
  style.bold: true
}

input -> transform: "channel mixing\nonly" {style.stroke: "#dc2626"}
transform -> output {style.stroke: "#16a34a"}

note: "所有 spatial positions\n共享同一个 transform\n不看 neighbors" {
  style.stroke-dash: 4
  style.stroke: "#f59e0b"
}
