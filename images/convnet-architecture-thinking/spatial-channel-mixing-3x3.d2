grid-rows: 1
grid-columns: 3
style.stroke: transparent

neighborhood: "3 × 3 Neighborhood\n\n9 spatial positions\n(i-1,j-1) ... (i+1,j+1)\n\nEach position:\nall C_in channels\n[c₁, c₂, ..., c_C]" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
  style.bold: true
}

conv3x3: "3 × 3 Conv\n\n读取 local region\n+ all channels\n\n联合变换" {
  style.bold: true
  style.stroke: "#dc2626"
  style.stroke-width: 3
}

result: "Output\n\nspatial mixing\n+ channel mixing\n\n同时跨空间\n跨 channel 交换信息" {
  style.stroke: "#f59e0b"
  style.stroke-width: 2
  style.bold: true
}

neighborhood -> conv3x3 {style.stroke: "#2563eb"}
conv3x3 -> result {style.stroke: "#dc2626"}
