direction: down

video: Video {
  style.bold: true
  style.stroke: "#2563eb"
  style.stroke-width: 3
}

process: "抽帧 (每隔 N 帧) → 2D CNN (逐帧独立)" {
  style.stroke: "#16a34a"
  style.stroke-width: 2
}

agg: "Frame Scores → Aggregation (max / top-k / avg) → Video Prediction" {
  style.bold: true
  style.stroke: "#dc2626"
  style.stroke-width: 3
}

video -> process -> agg
