direction: right

level0: "输入视频序列\n[B, C, T=16, H, W]" {
  direction: right
  style.stroke: "#2563eb"
  style.stroke-width: 2
  f1: "Frame 1"
  f2: "Frame 2"
  f3: "Frame 3"
  f_rest: "...\n16" {style.stroke-dash: 4}
  f1 -> f2 -> f3 -> f_rest: {style.stroke: "#2563eb"; style.opacity: 0.3}
}

level1: "Layer 1 (Conv3D)\n[B, C₁, T=14, H₁, W₁]" {
  direction: right
  style.stroke: "#16a34a"
  style.stroke-width: 2
  m1: "时序特征 t₁'\n(感受野: 帧 1~3)\n微动作基元" {
    style.stroke: "#16a34a"
    style.bold: true
  }
  m2: "时序特征 t₂'\n(感受野: 帧 2~4)" {
    style.stroke: "#16a34a"
  }
  m_rest: "...\nt₁₄'" {style.stroke-dash: 4}
  m1 -> m2 -> m_rest: {style.stroke: "#16a34a"; style.opacity: 0.3}
}

level2: "Layer 2 (Conv3D)\n[B, C₂, T=12, H₂, W₂]" {
  direction: right
  style.stroke: "#f59e0b"
  style.stroke-width: 2
  a1: "复合动作 t₁''\n(时序感受野: 5 帧)\n如「手腕抬起」" {
    style.stroke: "#f59e0b"
    style.bold: true
  }
  a_rest: "...\nt₁₂''" {style.stroke-dash: 4}
  a1 -> a_rest: {style.stroke: "#f59e0b"; style.opacity: 0.3}
}

deep_event: "深层时序聚合\n[B, C_deep, T_out, H', W']\n完整事件识别 (如「挥手」)" {
  style.stroke: "#dc2626"
  style.stroke-width: 2
  style.bold: true
}

level0.f2 -> level1.m1: "时空滑窗 K_t=3" {style.stroke: "#16a34a"}
level1.m1 -> level2.a1: "时序累积" {style.stroke: "#f59e0b"}
level2.a1 -> deep_event: "全局视野" {style.stroke: "#dc2626"; style.bold: true}
