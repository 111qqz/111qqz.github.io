direction: right

appearance: "状态识别 (Appearance)" {
  style.stroke: "#2563eb"
  style.stroke-width: 2

  label1: "色情内容"
  label2: "logo / 二维码"
  label3: "人脸 / 场景"
  signal: "单帧已有\n足够信号" {
    style.bold: true
    style.stroke: "#2563eb"
  }

  label1 -> signal
  label2 -> signal
  label3 -> signal
}

action: "状态变化识别 (Action)" {
  style.stroke: "#dc2626"
  style.stroke-width: 2

  label1: "挥手 vs 手举着"
  label2: "坐下 vs 已经坐着"
  label3: "摔倒 vs 躺着"
  signal: "必须看到\nbefore → after" {
    style.bold: true
    style.stroke: "#dc2626"
  }

  label1 -> signal
  label2 -> signal
  label3 -> signal
}

appearance -> action: "需要 temporal\nmodeling?" {
  style.stroke: "#f59e0b"
  style.bold: true
}
