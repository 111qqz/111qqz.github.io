direction: down

app_path: "静态状态识别 (Appearance Recognition)" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
  direction: right

  in_single: "单帧静态画面\n输入: [C, H, W]" {
    style.stroke: "#2563eb"
  }

  model_2d: "2D CNN / ViT 空间特征提取\n空间纹理、物体边缘、语义构图" {
    style.stroke: "#2563eb"
    style.stroke-width: 2
    style.bold: true
  }

  out_static: "静态目标判定\n色情审核 / Logo / 人脸 / 场景\n单帧信息已完全自洽" {
    style.stroke: "#16a34a"
    style.stroke-width: 2
    style.bold: true
  }

  in_single -> model_2d: "单帧前向"
  model_2d -> out_static: "充分判别"
}

act_path: "状态变化与连续动作识别 (State Transition / Motion)" {
  style.stroke: "#dc2626"
  style.stroke-width: 2
  style.bold: true
  direction: right

  in_seq: "跨时帧连续序列\n(t_before → t_during → t_after)" {
    style.stroke: "#dc2626"
  }

  model_temporal: "时序建模 (Conv3D / 时序差分)\n捕获状态演变过程与速度矢量" {
    style.stroke: "#dc2626"
    style.stroke-width: 2
    style.bold: true
  }

  out_motion: "动作与事件判定\n摔倒(非躺着) / 坐下(非坐着)\n必须依赖时间轴演化" {
    style.stroke: "#dc2626"
    style.stroke-width: 2
    style.bold: true
  }

  in_seq -> model_temporal: "跨帧时序建模"
  model_temporal -> out_motion: "状态差分判别"
}
