direction: right

appearance: "第一类：状态与静态外观识别 (Appearance)" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
  style.bold: true

  cases: "典型任务:\n• 色情内容识别\n• Logo 与二维码检测\n• 人脸 / 静态场景分类"
  reason: "判别依据:\n单帧静态画面已包含充分判别信息\n不依赖帧与帧之间的时间变化"
}

action: "第二类：状态变化与连续动作识别 (Motion)" {
  style.stroke: "#dc2626"
  style.stroke-width: 2
  style.bold: true

  cases: "典型任务:\n• 挥手 vs 手一直举着\n• 坐下 vs 已经坐着\n• 摔倒 vs 原本就躺着"
  reason: "判别依据:\n必须观察 before → during → after 过渡\n标签语义本质就是状态在时序上的演变"
}
