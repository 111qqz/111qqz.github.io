direction: down

stack: "帧拼 Channel + Conv2D\n[B, 48, H, W] → Conv2D → [B, C_out, H', W']\n时间轴在第一层消失" {
  style.stroke: "#dc2626"
  style.stroke-width: 2
  style.bold: true
}

conv3d: "Conv3D\n[B, C, 16, H, W] → Conv3D → [B, C', T', H', W']\n时间轴逐层保留" {
  style.stroke: "#16a34a"
  style.stroke-width: 2
  style.bold: true
}

stack -> conv3d: "核心区别：T 维度是否存活" {
  style.stroke: "#f59e0b"
  style.bold: true
}
