direction: right

k2d: "Conv2D 卷积核\n空间局部感受野" {
  style.stroke: "#2563eb"
  style.stroke-width: 2
  style.bold: true

  spec: "核形状: K_h × K_w (如 3×3)\n输入维度: [B, C, H, W]\n滑窗轴: 仅在空间 (H, W) 两个维度滑动\n特征: 每个位置吃下所有通道，输出单点空间标量"
}

k3d: "Conv3D 卷积核\n时空三维小立方体" {
  style.stroke: "#16a34a"
  style.stroke-width: 2
  style.bold: true

  spec: "核形状: K_t × K_h × K_w (如 3×3×3)\n输入维度: [B, C, T, H, W]\n滑窗轴: 在时间与空间 (T, H, W) 三个维度同步滑动\n特征: 每个位置覆盖跨帧局部时空立体区域"
}
