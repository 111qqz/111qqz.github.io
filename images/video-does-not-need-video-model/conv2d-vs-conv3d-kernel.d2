direction: down

conv2d: "Conv2D — Input: [B, C, H, W] — Kernel: K_h × K_w — 在 H, W 上滑动" {
  style.bold: true
  style.stroke: "#2563eb"
  style.stroke-width: 3
}

conv3d: "Conv3D — Input: [B, C, T, H, W] — Kernel: K_t × K_h × K_w — 在 T, H, W 上滑动" {
  style.bold: true
  style.stroke: "#dc2626"
  style.stroke-width: 3
}

conv2d -> conv3d: "+1 维 (Time)" {
  style.stroke: "#f59e0b"
  style.bold: true
  style.stroke-width: 2
}
