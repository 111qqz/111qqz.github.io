grid-columns: 2

step1: "阶段一：ETF 二级市场吸收买盘" {
  style.stroke: "#2563eb"
  style.bold: true

  investor: "稳定资金入场\n规模化买入宽基 ETF 份额"
  etf_market: "ETF 二级市场价格推高\n二级市价高于基金净值（产生溢价）"

  investor -> etf_market: "注入资金流动性"
}

step2: "阶段二：套利机制向底层成份股渗透" {
  style.stroke: "#16a34a"
  style.bold: true

  arb: "授权做市商（AP）跨市套利\n二级市场卖出高估 ETF\n一级市场申购 ETF 份额"
  stocks: "现货市场一篮子买入\n按指数权重买入沪深300等成份股\n流动性分散注入实体权重企业"

  arb -> stocks: "现货对冲买单"
}

step1.etf_market -> step2.arb: "溢价驱动套利"
