direction: down

origin: "源头：股票二级市场流动性枯竭\n宽基指数异常跳水，买盘深度耗尽" {
  style.stroke: "#dc2626"
  style.bold: true
}

stage2_pledge: "传导一：大股东股权质押爆仓\n抵押市值击穿警戒线，面临强平处置" {
  style.stroke: "#f59e0b"
}
stage2_margin: "传导二：两融与资管产品破净\n保证金穿仓，触发被动市价抛售" {
  style.stroke: "#f59e0b"
}

stage3_banks: "扩散一：商业银行不良信贷暴露\n抵押物价值缩水，资本充足率承压" {
  style.stroke: "#7c3aed"
}
stage3_market: "扩散二：跨市场流动性踩踏\n资管抛售流动性资产，波及短融与信用债" {
  style.stroke: "#7c3aed"
}

systemic: "终局：系统性金融风险（Systemic Risk）\n金融中介功能受阻，实体信贷全面收紧" {
  style.stroke: "#991b1b"
  style.bold: true
}

origin -> stage2_pledge
origin -> stage2_margin

stage2_pledge -> stage3_banks: "质押品违约"
stage2_margin -> stage3_market: "赎回踩踏外溢"

stage3_banks -> systemic: "银行信贷收缩"
stage3_market -> systemic: "流动性挤兑共振"
