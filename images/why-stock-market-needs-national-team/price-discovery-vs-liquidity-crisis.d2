grid-columns: 2

normal_path: "场景 A：正常价格发现（基本面驱动）" {
  style.stroke: "#2563eb"
  style.bold: true

  n1: "企业经营预期下调\n盈利预测从 100 亿降至 50 亿"
  n2: "全市场投资者重估\n现金流折现与估值模型下移"
  n3: "不同风险偏好买家入场\n低估值吸引价值配置盘承接"
  n4: "盘口深度维持健康\n在 70 元附近形成平稳新均衡"

  n1 -> n2 -> n3 -> n4
}

crisis_path: "场景 B：流动性危机（机制与规则驱动）" {
  style.stroke: "#dc2626"
  style.bold: true

  c1: "外生流动性冲击\n部分重仓资金面临资金缺口"
  c2: "杠杆账户跌破维持担保线\n触发券商风控强平警报"
  c3: "算法市价单被动平仓\n不计成本砸向有限买盘深度"
  c4: "盘口买单瞬间被砸空\n出现无对手盘跌停与踩踏"

  c1 -> c2 -> c3 -> c4
}
