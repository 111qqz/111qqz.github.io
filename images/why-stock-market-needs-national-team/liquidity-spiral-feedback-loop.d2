direction: right

spiral: "流动性螺旋：非线性正反馈回路" {
  style.stroke: "#dc2626"
  style.bold: true

  p1: "股票资产价格下跌\n抵押品市值缩水"
  p2: "杠杆账户保证金不足\n触及维持担保比例下限"
  p3: "算法触发强制平仓\n不计成本市价单抛售"
  p4: "买盘盘口深度耗尽\n流动性枯竭与跌幅扩大"

  p1 -> p2: "引发追缴\nMargin Call"
  p2 -> p3: "无法及时补仓\n被迫卖出"
  p3 -> p4: "冲击有限买盘\n产生滑点"
  p4 -> p1: "正反馈强化\n自我催化" {
    style.stroke: "#dc2626"
    style.bold: true
  }
}

buffer: "外部稳定资金介入" {
  style.stroke: "#16a34a"
  style.bold: true

  team: "稳定资金下场\n承接无价格敏感度的卖单"
  liquidity: "注入逆周期流动性\n补齐买方盘口深度真空"
  cut: "阻断负向正反馈\n给市场预留理性自愈时间"

  team -> liquidity -> cut
}

cut -> spiral.p4: "吸收被动抛压\n切断恶性循环" {
  style.stroke: "#16a34a"
  style.stroke-dash: 3
  style.bold: true
}
